---
import type { ProductColorVariant } from "@/data/productVariants";
import type { SplitVariantGallery } from "@/utils/variantGallery";

interface Props {
  variants: ProductColorVariant[];
  galleriesByVariant: Record<string, SplitVariantGallery>;
  activeId: string;
  productName: string;
  selectorLabel?: string;
}

const { variants, galleriesByVariant, activeId, productName, selectorLabel = "Color" } =
  Astro.props;
const showSelector = variants.length > 1;
---

{
  showSelector && (
<div
  class="color-variants"
  data-color-variants
  data-product-name={productName}
  data-galleries={JSON.stringify(galleriesByVariant)}
>
  <p class="color-variants__label">{selectorLabel}</p>
  <div class="color-variants__list" role="listbox" aria-label="Color del producto">
    {
      variants.map((v) => (
        <button
          type="button"
          class:list={["color-variant", v.id === activeId && "color-variant--active"]}
          role="option"
          aria-selected={v.id === activeId ? "true" : "false"}
          data-variant-id={v.id}
          data-variant-label={v.colorLabel}
          data-variant-price={v.pricePerUnit ?? ""}
        >
          {v.label}
        </button>
      ))
    }
  </div>
</div>
  )
}

<script>
  interface GalleryImage {
    src: string;
    alt: string;
    label: string;
  }

  interface SplitVariantGallery {
    hero: GalleryImage[];
    inspiration: GalleryImage[];
  }

  function initColorVariants(root: HTMLElement) {
    const page = root.closest(".product-page");
    if (!page) return;

    const galleries = JSON.parse(root.dataset.galleries ?? "{}") as Record<
      string,
      SplitVariantGallery
    >;

    const metaColor = page.querySelector<HTMLElement>("[data-product-color]");
    const priceValueEl = page.querySelector<HTMLElement>("[data-product-price-value]");
    const galleryRoot = page.querySelector<HTMLElement>("[data-product-gallery]");
    const addBtn = page.querySelector<HTMLButtonElement>("[data-add-to-quote]");
    const defaultPrice = addBtn?.dataset.price ?? "";

    // Ficha técnica por dimensión: el link principal sigue la variante elegida.
    const fichaLink = page.querySelector<HTMLAnchorElement>("[data-ficha-link]");
    const fichaCurrent = page.querySelector<HTMLElement>("[data-ficha-current]");
    const fichaMap = fichaLink?.dataset.fichaMap
      ? (JSON.parse(fichaLink.dataset.fichaMap) as Record<string, { url: string; label: string }>)
      : null;

    const setHeroGallery = (split: SplitVariantGallery) => {
      if (split.hero.length) {
        galleryRoot?.dispatchEvent(
          new CustomEvent("gallery-set", { detail: { images: split.hero }, bubbles: true })
        );
      }
    };

    root.querySelectorAll<HTMLButtonElement>(".color-variant").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.variantId;
        const label = btn.dataset.variantLabel;
        const variantPrice = btn.dataset.variantPrice;
        if (!id) return;

        root.querySelectorAll(".color-variant").forEach((b) => {
          const active = b === btn;
          b.classList.toggle("color-variant--active", active);
          b.setAttribute("aria-selected", active ? "true" : "false");
        });

        if (label && metaColor) metaColor.textContent = label;

        if (addBtn && label) addBtn.dataset.color = label;
        if (addBtn) addBtn.dataset.variantId = id;

        const nextPrice = variantPrice || defaultPrice;
        if (addBtn && nextPrice) addBtn.dataset.price = nextPrice;
        if (priceValueEl && nextPrice) priceValueEl.textContent = nextPrice;

        const split = galleries[id];
        if (split) setHeroGallery(split);

        if (fichaLink && fichaMap && fichaMap[id]) {
          fichaLink.href = fichaMap[id].url;
          if (fichaCurrent) fichaCurrent.textContent = fichaMap[id].label;
        }
      });
    });

    // Pre-seleccionar variante si llega por URL: /productos/{slug}?color={id}
    const urlColor = new URLSearchParams(window.location.search).get("color");
    if (urlColor) {
      const target = root.querySelector<HTMLButtonElement>(
        `.color-variant[data-variant-id="${CSS.escape(urlColor)}"]`
      );
      target?.click();
    }
  }

  document.querySelectorAll<HTMLElement>("[data-color-variants]").forEach(initColorVariants);
</script>

<style>
  .color-variants {
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .color-variants__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.65rem;
  }

  .color-variants__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .color-variant {
    padding: 0.55rem 0.85rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    border: 1px solid rgba(71, 36, 16, 0.15);
    border-radius: var(--radius-md, 0.75rem);
    background: var(--color-bg);
    color: var(--color-chocolate);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .color-variant:hover {
    border-color: var(--color-terracota);
  }

  .color-variant--active {
    border-color: var(--color-terracota);
    background: var(--color-chocolate);
    color: var(--color-white);
  }
</style>
