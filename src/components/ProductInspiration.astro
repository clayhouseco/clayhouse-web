---
import type { InspirationCard } from "@/utils/variantGallery";

interface Props {
  cards: InspirationCard[];
}

const { cards } = Astro.props;

const INTRO =
  "Sus matices y variaciones naturales generan composiciones únicas que añaden personalidad y un acabado auténtico a fachadas e interiores.";
---

{
  cards.length > 0 && (
    <div class="product-inspiration" data-product-inspiration>
      <div class="product-inspiration__header container">
        <p class="product-inspiration__eyebrow">Proyectos</p>
        <h2 class="product-inspiration__title">Inspiración</h2>
        <p class="product-inspiration__intro">{INTRO}</p>
      </div>

      <div class="product-inspiration__carousel">
        <button
          type="button"
          class="product-inspiration__nav product-inspiration__nav--prev"
          aria-label="Proyecto anterior"
          data-inspiration-prev
          hidden
        >
          ←
        </button>

        <div class="product-inspiration__viewport" data-inspiration-viewport>
          <div class="product-inspiration__track" data-inspiration-track>
            {cards.map((card, i) => {
              const img = card.images[0];
              const split = i % 2 === 1;
              const multi = card.images.length > 1;
              return (
                <article
                  class:list={["inspiration-card", split && "inspiration-card--split"]}
                  data-inspiration-card
                >
                  {split && (
                    <div class="inspiration-card__text">
                      <p>{card.title}</p>
                    </div>
                  )}
                  <button
                    type="button"
                    class="inspiration-card__open"
                    data-inspiration-open={i}
                    aria-label={
                      multi
                        ? `Ver ${card.images.length} fotos de ${card.title}`
                        : `Ampliar ${card.title}`
                    }
                  >
                    <figure class="inspiration-card__media">
                      <img
                        src={img.src}
                        alt={img.alt}
                        loading={i < 2 ? "eager" : "lazy"}
                        decoding="async"
                      />
                      {!split && <figcaption>{card.title}</figcaption>}
                      {multi && (
                        <span class="inspiration-card__count">
                          +{card.images.length - 1} fotos
                        </span>
                      )}
                    </figure>
                  </button>
                </article>
              );
            })}
          </div>
        </div>

        <button
          type="button"
          class="product-inspiration__nav product-inspiration__nav--next"
          aria-label="Siguiente proyecto"
          data-inspiration-next
        >
          →
        </button>
      </div>

      <div
        class="inspiration-lightbox"
        data-inspiration-lightbox
        hidden
        role="dialog"
        aria-modal="true"
        aria-label="Galería del proyecto"
      >
        <button type="button" class="inspiration-lightbox__backdrop" data-lightbox-close aria-label="Cerrar" />
        <div class="inspiration-lightbox__panel">
          <button type="button" class="inspiration-lightbox__close" data-lightbox-close aria-label="Cerrar">
            ×
          </button>
          <p class="inspiration-lightbox__title" data-lightbox-title />
          <figure class="inspiration-lightbox__stage">
            <img src="" alt="" data-lightbox-img />
            <figcaption data-lightbox-caption />
          </figure>
          <div class="inspiration-lightbox__thumbs" data-lightbox-thumbs hidden />
          <div class="inspiration-lightbox__controls">
            <button type="button" data-lightbox-prev aria-label="Foto anterior">
              ←
            </button>
            <span data-lightbox-counter />
            <button type="button" data-lightbox-next aria-label="Foto siguiente">
              →
            </button>
          </div>
        </div>
      </div>

      <script type="application/json" data-inspiration-data set:html={JSON.stringify(cards)} />
    </div>
  )
}

<script>
  interface GalleryImage {
    src: string;
    alt: string;
    label: string;
  }

  interface InspirationCard {
    title: string;
    category: string;
    images: GalleryImage[];
  }

  function bindInspiration(root: HTMLElement) {
    const viewport = root.querySelector<HTMLElement>("[data-inspiration-viewport]");
    const track = root.querySelector<HTMLElement>("[data-inspiration-track]");
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-inspiration-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-inspiration-next]");

    if (!viewport || !track) return;

    const updateNav = () => {
      if (!prevBtn || !nextBtn) return;
      const maxScroll = track.scrollWidth - viewport.clientWidth;
      const sl = viewport.scrollLeft;
      prevBtn.hidden = sl <= 8;
      nextBtn.hidden = sl >= maxScroll - 8;
    };

    const scrollByCard = (direction: 1 | -1) => {
      const card = track.querySelector<HTMLElement>("[data-inspiration-card]");
      if (!card) return;
      const gap = parseFloat(getComputedStyle(track).gap) || 16;
      const step = card.offsetWidth + gap;
      viewport.scrollBy({ left: direction * step, behavior: "smooth" });
    };

    prevBtn?.addEventListener("click", () => scrollByCard(-1));
    nextBtn?.addEventListener("click", () => scrollByCard(1));
    viewport.addEventListener("scroll", updateNav, { passive: true });
    window.addEventListener("resize", updateNav);
    updateNav();

    const dataEl = root.querySelector<HTMLScriptElement>("[data-inspiration-data]");
    const cards: InspirationCard[] = dataEl ? JSON.parse(dataEl.textContent ?? "[]") : [];

    const lightbox = root.querySelector<HTMLElement>("[data-inspiration-lightbox]");
    const lbImg = root.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const lbTitle = root.querySelector<HTMLElement>("[data-lightbox-title]");
    const lbCaption = root.querySelector<HTMLElement>("[data-lightbox-caption]");
    const lbCounter = root.querySelector<HTMLElement>("[data-lightbox-counter]");
    const lbPrev = root.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
    const lbNext = root.querySelector<HTMLButtonElement>("[data-lightbox-next]");
    const lbThumbs = root.querySelector<HTMLElement>("[data-lightbox-thumbs]");

    let activeCard: InspirationCard | null = null;
    let activeIndex = 0;

    const syncLightbox = () => {
      if (!activeCard || !lbImg || !lbTitle || !lbCaption || !lbCounter) return;
      const img = activeCard.images[activeIndex];
      if (!img) return;

      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lbTitle.textContent = activeCard.title;
      lbCaption.textContent = img.label;
      lbCounter.textContent = `${activeIndex + 1} / ${activeCard.images.length}`;

      const multi = activeCard.images.length > 1;
      if (lbPrev) lbPrev.hidden = !multi;
      if (lbNext) lbNext.hidden = !multi;

      lbThumbs?.querySelectorAll<HTMLButtonElement>(".inspiration-lightbox__thumb").forEach((btn) => {
        const i = Number(btn.dataset.index);
        btn.classList.toggle("inspiration-lightbox__thumb--active", i === activeIndex);
      });
    };

    const buildThumbs = () => {
      if (!lbThumbs || !activeCard) return;
      lbThumbs.innerHTML = "";
      const multi = activeCard.images.length > 1;
      lbThumbs.hidden = !multi;
      if (!multi) return;

      activeCard.images.forEach((item, i) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "inspiration-lightbox__thumb";
        btn.dataset.index = String(i);
        btn.setAttribute("aria-label", `Foto ${i + 1} de ${activeCard!.title}`);

        const thumbImg = document.createElement("img");
        thumbImg.src = item.src;
        thumbImg.alt = "";
        thumbImg.loading = "lazy";
        btn.append(thumbImg);
        lbThumbs.append(btn);
      });
    };

    const openLightbox = (cardIndex: number, imageIndex = 0) => {
      if (!lightbox || !cards[cardIndex]) return;
      activeCard = cards[cardIndex];
      activeIndex = Math.min(imageIndex, activeCard.images.length - 1);
      buildThumbs();
      syncLightbox();
      lightbox.hidden = false;
      lightbox.classList.add("inspiration-lightbox--open");
      document.body.style.overflow = "hidden";
      lightbox.querySelector<HTMLButtonElement>(".inspiration-lightbox__close")?.focus();
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.hidden = true;
      lightbox.classList.remove("inspiration-lightbox--open");
      document.body.style.overflow = "";
      activeCard = null;
      activeIndex = 0;
      if (lbThumbs) {
        lbThumbs.innerHTML = "";
        lbThumbs.hidden = true;
      }
      if (lbImg) {
        lbImg.removeAttribute("src");
        lbImg.alt = "";
      }
    };

    lbThumbs?.addEventListener("click", (e) => {
      e.stopPropagation();
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".inspiration-lightbox__thumb");
      if (!btn?.dataset.index || !activeCard) return;
      activeIndex = Number(btn.dataset.index);
      syncLightbox();
    });

    root.querySelectorAll<HTMLButtonElement>("[data-inspiration-open]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const index = Number(btn.dataset.inspirationOpen);
        if (!Number.isNaN(index)) openLightbox(index);
      });
    });

    lbPrev?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (!activeCard) return;
      activeIndex = (activeIndex - 1 + activeCard.images.length) % activeCard.images.length;
      syncLightbox();
    });

    lbNext?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (!activeCard) return;
      activeIndex = (activeIndex + 1) % activeCard.images.length;
      syncLightbox();
    });

    root.querySelectorAll("[data-lightbox-close]").forEach((el) => {
      el.addEventListener("click", closeLightbox);
    });

    document.addEventListener("keydown", (e) => {
      if (!lightbox?.classList.contains("inspiration-lightbox--open")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") lbPrev?.click();
      if (e.key === "ArrowRight") lbNext?.click();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-product-inspiration]").forEach(bindInspiration);
</script>

<style is:global>
  .product-inspiration__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }

  .product-inspiration__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .product-inspiration__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-chocolate);
  }

  .product-inspiration__intro {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .product-inspiration__carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-inline: clamp(0.75rem, 3vw, 2rem);
  }

  .product-inspiration__viewport {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .product-inspiration__viewport::-webkit-scrollbar {
    display: none;
  }

  .product-inspiration__track {
    display: flex;
    gap: 1rem;
    padding-block: 0.5rem 1rem;
    padding-inline: max(0px, calc((100vw - 72rem) / 2));
  }

  .inspiration-card {
    flex: 0 0 min(88vw, 520px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    margin: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-white);
    box-shadow: 0 12px 40px rgba(71, 36, 16, 0.1);
  }

  .inspiration-card--split {
    flex: 0 0 min(92vw, 720px);
    flex-direction: row;
    min-height: 280px;
  }

  .inspiration-card__text {
    flex: 0 0 42%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.75rem;
    background: var(--color-terracota);
    color: var(--color-white);
  }

  .inspiration-card__text p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }

  .inspiration-card__open {
    flex: 1;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    text-align: inherit;
    font: inherit;
  }

  .inspiration-card__media {
    flex: 1;
    margin: 0;
    position: relative;
    min-height: 220px;
    min-width: 0;
  }

  .inspiration-card--split .inspiration-card__open {
    flex: 0 0 58%;
  }

  .inspiration-card__media img {
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
    display: block;
    transition: transform 0.35s var(--ease, ease);
  }

  .inspiration-card__open:hover .inspiration-card__media img {
    transform: scale(1.02);
  }

  .inspiration-card__media figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-white);
    background: linear-gradient(transparent, rgba(71, 36, 16, 0.75));
  }

  .inspiration-card__count {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-white);
    background: rgba(71, 36, 16, 0.65);
    border-radius: 0.35rem;
  }

  .product-inspiration__nav {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgba(71, 36, 16, 0.12);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-chocolate);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(71, 36, 16, 0.08);
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
    z-index: 2;
  }

  .product-inspiration__nav:hover:not(:hidden) {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-white);
    transform: scale(1.05);
  }

  .product-inspiration__nav[hidden] {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
  }

  .inspiration-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    place-items: center;
    padding: 1rem;
    pointer-events: none;
  }

  .inspiration-lightbox.inspiration-lightbox--open {
    display: grid;
    pointer-events: auto;
  }

  .inspiration-lightbox[hidden] {
    display: none !important;
    pointer-events: none;
  }

  .inspiration-lightbox__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(71, 36, 16, 0.82);
    cursor: pointer;
  }

  .inspiration-lightbox__panel {
    position: relative;
    z-index: 1;
    width: min(92vw, 960px);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--color-white);
    border-radius: 1rem;
    padding: 1rem 1rem 1.25rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
  }

  .inspiration-lightbox__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-chocolate);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
  }

  .inspiration-lightbox__title {
    margin: 0 2.5rem 0 0.25rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-chocolate);
  }

  .inspiration-lightbox__stage {
    margin: 0;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .inspiration-lightbox__stage img {
    width: 100%;
    max-height: min(70vh, 640px);
    object-fit: contain;
    background: var(--color-bg);
    border-radius: 0.5rem;
  }

  .inspiration-lightbox__stage figcaption {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .inspiration-lightbox__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .inspiration-lightbox__controls button {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(71, 36, 16, 0.12);
    border-radius: 50%;
    background: var(--color-bg);
    cursor: pointer;
  }

  .inspiration-lightbox__controls span {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    min-width: 4rem;
    text-align: center;
  }

  .inspiration-lightbox__thumbs {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.5rem;
    justify-content: flex-start;
    overflow-x: auto;
    padding: 0.35rem 0.15rem;
    position: relative;
    z-index: 2;
  }

  .inspiration-lightbox__thumb {
    flex: 0 0 4rem;
    width: 4rem;
    height: 4rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 0.35rem;
    overflow: hidden;
    cursor: pointer;
    background: var(--color-bg);
    pointer-events: auto;
  }

  .inspiration-lightbox__thumb--active {
    border-color: var(--color-terracota);
  }

  .inspiration-lightbox__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 900px) {
    .inspiration-card {
      flex: 0 0 min(42vw, 480px);
    }

    .inspiration-card--split {
      flex: 0 0 min(58vw, 680px);
    }
  }

  @media (max-width: 640px) {
    .inspiration-card--split {
      flex-direction: column;
      flex: 0 0 88vw;
    }

    .inspiration-card__text {
      flex: none;
      padding: 1.25rem 1rem;
    }

    .inspiration-card--split .inspiration-card__open {
      flex: 1;
    }

    .product-inspiration__nav {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1rem;
    }
  }
</style>
