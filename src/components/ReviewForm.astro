---
import { site } from "@/data/site";
import { getVisibleProducts } from "@/data/products";
import { catalogCategories } from "@/data/catalogCategories";

interface Props {
  id?: string;
}

const { id = "review-form" } = Astro.props;

/** Tipos de cliente / rol para la lista desplegable de reseñas */
const clientRoles = [
  "Arquitecto / Arquitecta",
  "Constructor / Constructora",
  "Ingeniero civil",
  "Contratista / Maestro de obra",
  "Diseñador / Interiorista",
  "Cliente final / Propietario",
  "Revendedor / Distribuidor",
  "Depósito / Ferretería",
  "Otro",
];

/** Productos del catálogo agrupados por categoría para el desplegable */
const reviewProducts = getVisibleProducts();
const productGroups = catalogCategories
  .map((cat) => ({
    title: cat.title,
    items: reviewProducts.filter((p) => p.category === cat.id),
  }))
  .filter((group) => group.items.length > 0);

/** Las reseñas se guardan en Google Sheets vía Apps Script (site.reviewsEndpoint).
 *  El moderador las aprueba marcando la casilla "Aprobada" en la hoja. */
const reviewsEndpoint = site.reviewsEndpoint;
/**
 * EL ENVÍO DE LA RESEÑA YA NO ES CIEGO.
 *
 * Se mandaba con `mode: "no-cors"`, que le impide al navegador leer la respuesta, y después
 * se iba a «gracias» pasara lo que pasara: con la hoja caída, con el guion borrado, con la
 * red cortada. Quien escribía una reseña veía la página de agradecimiento igual, y su texto
 * se perdía sin que nadie se enterara —ni él, ni nosotros—. Es el mismo fallo que tenía el
 * cotizador antes de la Fase 1.
 *
 * El `no-cors` no hacía falta: el guion de Apps Script responde con
 * `access-control-allow-origin: *`, así que el navegador SÍ puede leer el resultado. Era un
 * residuo de cuando las reseñas se leían con JSONP, que se quitó en la Fase 3; al cambiar la
 * lectura nadie volvió a mirar el envío.
 *
 * El cuerpo va como `URLSearchParams`, que el navegador manda con
 * `application/x-www-form-urlencoded`: eso lo hace una petición simple y evita el preflight,
 * que Apps Script no atiende bien.
 *
 * Lo comprueba `npm run probar:resenas` en los tres caminos, con `fetch` sustituido por un
 * doble para no escribir en la hoja.
 *
 * NOTA DE TAMAÑO: este comentario vive acá y no dentro del `<script>` porque los scripts con
 * `define:vars` van en línea y sin minificar — todo lo que se escriba ahí lo descarga cada
 * visitante. El frontmatter no se publica.
 */
const thankYouPath = "/resenas/gracias/";
---

<div class="review-form-wrap">
  <form class="review-form" id={id} data-reviews-form>
    {/* Campo trampa para robots: quien usa lector de pantalla tampoco debe encontrarlo,
        o se le pide llenar algo que no existe. */}
    <input
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="review-form__honeypot"
    />

    <label>
      Nombre completo *
      <input type="text" name="nombre" required autocomplete="name" />
    </label>

    <label>
      Tipo de cliente o rol (opcional)
      <select name="empresa_rol">
        <option value="">Seleccione…</option>
        {clientRoles.map((role) => <option value={role}>{role}</option>)}
      </select>
    </label>

    {/* QUÉ HACE VERIFICABLE A UNA RESEÑA.
        Un nombre y un rol no se pueden comprobar; la obra sí. Este campo es opcional —nadie
        tiene que decir en qué trabaja para dejar una reseña— pero cuando viene, la reseña
        deja de ser anónima y pasa a ser comprobable, que es lo que le importa a un
        arquitecto que la lee antes de especificar.

        OJO: el Apps Script de la hoja tiene que tener la columna `empresa`. Mientras no la
        tenga, el dato se escribe en el formulario y se pierde al llegar: la hoja guarda las
        columnas que conoce e ignora el resto. */}
    <label>
      Empresa, obra o proyecto (opcional)
      <input type="text" name="empresa" autocomplete="organization" maxlength="80" />
    </label>

    <label>
      Email *
      <input type="email" name="email" required autocomplete="email" />
    </label>

    <fieldset class="review-form__rating">
      <legend>¿Cómo califica su experiencia de compra? *</legend>
      <div class="review-form__stars">
        {
          [5, 4, 3, 2, 1].map((value) => (
            <label class="review-form__star-option">
              <input type="radio" name="calificacion" value={String(value)} required={value === 5} />
              <span>{value} ★</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <label>
      Producto (opcional)
      <select name="producto">
        <option value="">Seleccione…</option>
        {
          productGroups.map((group) => (
            <optgroup label={group.title}>
              {group.items.map((product) => (
                <option value={product.name}>{product.name}</option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </label>

    <label>
      Su reseña *
      <textarea
        name="resena"
        rows="5"
        required
        placeholder="Cuéntenos cómo fue el proceso: cotización, muestras, entrega, atención en obra…"
      ></textarea>
    </label>

    <label class="checkbox review-form__consent">
      <input type="checkbox" name="autorizacion" value="si" required />
      <span>
        Autorizo publicar mi reseña en el sitio web (puede editarse por claridad). Clay House puede
        contactarme para confirmar datos.
      </span>
    </label>

    <button type="submit" class="btn btn--primary review-form__submit">
      Enviar reseña
    </button>

    {/* Hasta ahora no había dónde decir que algo salió mal, porque la página nunca se
        enteraba. Vive fuera del botón para que un lector de pantalla lo anuncie al
        aparecer, sin que el foco salte. */}
    <p class="review-form__estado" data-reviews-estado role="status" aria-live="polite" hidden></p>
  </form>
</div>

<script
  define:vars={{
    endpoint: reviewsEndpoint,
    thankYouPath,
    formId: id,
  }}
>
  /* Por qué el envío dejó de ser ciego: ver el comentario del frontmatter. Acá no, que
     este script viaja tal cual al navegador. */
  const form = document.getElementById(formId);
  const estado = form && form.querySelector("[data-reviews-estado]");

  function avisar(texto) {
    if (!estado) return;
    estado.textContent = texto;
    estado.hidden = false;
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const textoBoton = btn ? btn.textContent : "";
      if (btn) {
        btn.disabled = true;
        btn.textContent = "Enviando…";
      }
      if (estado) estado.hidden = true;

      try {
        const res = await fetch(endpoint, {
          method: "POST",
          body: new URLSearchParams(new FormData(form)),
        });
        /* Apps Script puede responder 200 con un error dentro. Se mira el cuerpo cuando
           se deja leer; si no es JSON, basta con que la petición haya ido bien. */
        let ok = res.ok;
        if (ok) {
          try {
            const cuerpo = await res.clone().json();
            if (cuerpo && (cuerpo.ok === false || cuerpo.error)) ok = false;
          } catch {
            /* no era JSON: nos quedamos con el código de respuesta */
          }
        }
        if (ok) {
          window.location.href = thankYouPath;
          return;
        }
        avisar(
          "No pudimos guardar tu reseña (error " +
            res.status +
            "). Tu texto sigue acá: vuelve a intentarlo en un momento."
        );
      } catch {
        avisar(
          "No pudimos guardar tu reseña: revisa tu conexión. Tu texto sigue acá, no se perdió."
        );
      }

      /* Se vuelve a dejar el botón como estaba: el texto escrito no se toca, para que
         reintentar sea pulsar otra vez y no volver a escribirlo todo. */
      if (btn) {
        btn.disabled = false;
        btn.textContent = textoBoton;
      }
    });
  }
</script>

<style>
  .review-form__estado {
    margin: 0.75rem 0 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid rgba(166, 58, 44, 0.3);
    border-radius: var(--radius-md);
    background: rgba(166, 58, 44, 0.06);
    color: var(--color-chocolate);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .review-form-wrap {
    background: var(--color-white);
    border: 1px solid rgba(71, 36, 16, 0.08);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
    box-shadow: 0 2px 12px rgba(71, 36, 16, 0.05);
  }

  .review-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .review-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-chocolate);
  }

  .review-form input[type="text"],
  .review-form input[type="email"],
  .review-form select,
  .review-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 300;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(71, 36, 16, 0.15);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }

  .review-form select {
    cursor: pointer;
    /* altura consistente con los inputs pese al control nativo */
    min-height: 2.75rem;
  }

  .review-form textarea {
    resize: vertical;
    min-height: 7rem;
  }

  .review-form__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
    pointer-events: none;
  }

  .review-form__rating {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .review-form__rating legend {
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
    color: var(--color-chocolate);
  }

  .review-form__stars {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .review-form__star-option {
    cursor: pointer;
  }

  .review-form__star-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .review-form__star-option span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.25rem;
    padding: 0.45rem 0.65rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border: 1px solid rgba(71, 36, 16, 0.12);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-chocolate);
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .review-form__star-option input:checked + span,
  .review-form__star-option:hover span {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-bg);
  }

  .review-form__consent {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.65rem;
    font-weight: 400;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .review-form__consent input {
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .review-form__submit {
    align-self: flex-start;
    margin-top: 0.25rem;
  }
</style>
