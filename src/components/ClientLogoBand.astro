---
import fs from "node:fs";
import path from "node:path";
import { brandClients } from "@/data/clients";
import type { BrandEntry } from "@/data/clients";

/** Resuelve un logo en /public/images/clientes/{id}.{svg|png|jpg|webp} si existe.
 *  Si no, devuelve undefined (la franja muestra el nombre como wordmark). */
const LOGOS_DIR = path.resolve("public/images/clientes");
const EXTS = ["svg", "png", "jpg", "webp"] as const;

function resolveLogo(entry: BrandEntry): string | undefined {
  if (entry.logo) return entry.logo;
  for (const ext of EXTS) {
    const file = path.join(LOGOS_DIR, `${entry.id}.${ext}`);
    if (fs.existsSync(file)) return `/images/clientes/${entry.id}.${ext}`;
  }
  return undefined;
}

const items = brandClients.map((c) => ({ ...c, logo: resolveLogo(c) }));
const trackItems = [...items, ...items];
---

<section class="client-band" aria-labelledby="client-band-heading">
  <div class="container client-band__intro">
    <h2 id="client-band-heading" class="section-title-solo">clientes</h2>
  </div>

  <div
    class="client-band__zone"
    data-client-band
    data-direction="normal"
    data-rest="0.3"
    aria-labelledby="client-band-heading"
  >
    <div class="client-band__fade client-band__fade--left" aria-hidden="true" />
    <div class="client-band__fade client-band__fade--right" aria-hidden="true" />

    <div class="client-band__viewport" data-client-viewport>
      <div class="client-band__track" data-client-track>
        {trackItems.map((entry, index) => {
          const eager = index < 3;
          return (
            <div class="client-band__item">
              {entry.logo ? (
                <img
                  src={entry.logo}
                  alt={entry.name}
                  class="client-band__img"
                  width="200"
                  height="80"
                  loading={eager ? "eager" : "lazy"}
                  decoding="async"
                />
              ) : (
                <span class="client-band__wordmark">{entry.name}</span>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  function bindClientBand(zone: HTMLElement) {
    const viewport = zone.querySelector<HTMLElement>("[data-client-viewport]");
    const track = zone.querySelector<HTMLElement>("[data-client-track]");
    if (!viewport || !track) return;

    const reverse = zone.dataset.direction === "reverse";
    const restRatio = Number(zone.dataset.rest) || 0.35;

    let targetOffset = 0;
    let currentOffset = 0;
    let raf = 0;

    const getMaxOffset = () => Math.max(0, track.scrollWidth - viewport.clientWidth);

    const tick = () => {
      const diff = targetOffset - currentOffset;
      if (Math.abs(diff) > 0.5) {
        currentOffset += diff * 0.12;
        track.style.transform = `translate3d(${-currentOffset}px, 0, 0)`;
        raf = requestAnimationFrame(tick);
      } else {
        currentOffset = targetOffset;
        track.style.transform = `translate3d(${-currentOffset}px, 0, 0)`;
        raf = 0;
      }
    };

    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    const updateFromPointer = (clientX: number) => {
      const rect = zone.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      const scrollRatio = reverse ? 1 - ratio : ratio;
      targetOffset = scrollRatio * getMaxOffset();
      schedule();
    };

    zone.addEventListener("mousemove", (e) => updateFromPointer(e.clientX));

    zone.addEventListener("mouseleave", () => {
      targetOffset = getMaxOffset() * restRatio;
      schedule();
    });

    const onResize = () => {
      targetOffset = Math.min(targetOffset, getMaxOffset());
      schedule();
    };

    window.addEventListener("resize", onResize);

    targetOffset = getMaxOffset() * restRatio;
    schedule();
  }

  document.querySelectorAll<HTMLElement>("[data-client-band]").forEach(bindClientBand);
</script>

<style>
  .client-band {
    padding: clamp(2.5rem, 6vw, 3.5rem) 0 clamp(2rem, 5vw, 2.75rem);
    background: var(--color-white);
    border-block: 1px solid rgba(71, 36, 16, 0.08);
  }

  .client-band__intro {
    text-align: center;
    margin-bottom: clamp(1.5rem, 4vw, 2rem);
  }

  @media (pointer: coarse) {
    .client-band__zone {
      cursor: default;
    }
  }

  .client-band__zone {
    position: relative;
    cursor: ew-resize;
    padding-block: 0.5rem;
  }

  .client-band__viewport {
    overflow: hidden;
    width: 100%;
  }

  .client-band__track {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    width: max-content;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    will-change: transform;
  }

  .client-band__item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: clamp(9rem, 14vw, 12rem);
    height: clamp(4.5rem, 10vw, 5.5rem);
    padding: 0.75rem 1.25rem;
    background: var(--color-white);
    border: 1px solid rgba(71, 36, 16, 0.08);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 10px rgba(71, 36, 16, 0.04);
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .client-band__zone:hover .client-band__item {
    border-color: rgba(124, 72, 44, 0.12);
  }

  .client-band__item:hover {
    transform: translateY(-3px);
    border-color: rgba(124, 72, 44, 0.22);
    box-shadow: 0 10px 24px rgba(71, 36, 16, 0.08);
  }

  .client-band__img {
    max-width: 100%;
    max-height: 3.25rem;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(0.15) contrast(1.05);
  }

  .client-band__wordmark {
    font-family: var(--font-heading);
    font-size: clamp(0.8125rem, 1.8vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: center;
    line-height: 1.25;
    color: var(--color-terracota);
    text-wrap: balance;
  }

  .client-band__fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(2rem, 8vw, 5rem);
    pointer-events: none;
    z-index: 2;
  }

  .client-band__fade--left {
    left: 0;
    background: linear-gradient(90deg, var(--color-white), transparent);
  }

  .client-band__fade--right {
    right: 0;
    background: linear-gradient(270deg, var(--color-white), transparent);
  }

  @media (max-width: 720px) {
    .client-band__item {
      min-width: 8rem;
      height: 4rem;
      padding: 0.6rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-band__track {
      transform: none !important;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }

    .client-band__viewport {
      overflow: visible;
    }

    .client-band__zone {
      cursor: default;
    }

    .client-band__item:hover {
      transform: none;
    }
  }
</style>
