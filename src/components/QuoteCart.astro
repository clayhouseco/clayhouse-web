---
/**
 * AGREGAR A COTIZACIÓN. Nada más.
 *
 * Esto era un cajón lateral de 880 líneas —lista de productos, cantidades, borrar, vaciar,
 * tres pasos dibujados, su propio foco atrapado— que duplicaba exactamente lo que hace
 * `/cotizacion`. Y casi nunca se veía: desde que agregar un producto lleva directo al
 * cotizador, el cajón solo aparecía si alguien volvía a una ficha con cosas ya guardadas.
 * Dos interfaces para lo mismo, una de ellas escondida, y la escondida se llevaba diecisiete
 * de los cincuenta y cuatro errores de tipos del proyecto.
 *
 * Queda lo único que hacía falta: oír el botón «Agregar a cotización», guardar la línea y
 * llevar al cotizador. La cotización se arma, se revisa y se envía en un solo lugar.
 *
 * El estado vive en `@/utils/quoteCart` (localStorage) y no cambió.
 */
---

<script>
  import {
    QUOTE_CART_EVENT,
    addToQuoteCart,
    getQuoteCart,
    getQuoteCartCount,
  } from "@/utils/quoteCart";
  import { quoteProductCatalog } from "@/data/quoteCatalog";

  /** El contador que llevan el encabezado y la ficha de producto. */
  function refrescarContadores() {
    const total = getQuoteCartCount();
    document.querySelectorAll<HTMLElement>("[data-quote-header-count]").forEach((el) => {
      el.textContent = String(total);
    });
    /* El enlace «Ver cotización (N)» de la ficha solo tiene sentido con algo adentro. */
    document.querySelectorAll<HTMLElement>("[data-quote-cart-open]").forEach((el) => {
      el.hidden = total === 0;
    });
  }

  document.addEventListener("click", (e) => {
    const destino = e.target instanceof Element ? e.target : null;
    const btn = destino?.closest<HTMLButtonElement>("[data-add-to-quote]");
    if (!btn) return;
    e.preventDefault();

    const ficha = btn.closest(".product-page");
    const pedido = btn.closest("[data-product-order]");
    const cantidadEl = pedido?.querySelector<HTMLInputElement>("[data-qty-input]");
    const colorEl = ficha?.querySelector("[data-product-color]");
    const fotoEl = ficha?.querySelector<HTMLImageElement>(
      ".product-gallery img, [data-product-gallery] img"
    );

    const cantidad = Math.max(1, Number.parseInt(cantidadEl?.value || "1", 10) || 1);
    const color = btn.dataset.color || colorEl?.textContent?.trim() || undefined;

    /* Si ese producto, en ese color y esa calidad, ya está en la cotización, no se duplica:
       se va al cotizador a cambiar la cantidad allá. */
    const llave = `${btn.dataset.slug}::${color ?? ""}::${btn.dataset.calidad ?? ""}`;
    const repetido = getQuoteCart().some(
      (i) => `${i.slug}::${i.color ?? ""}::${i.calidad ?? ""}` === llave
    );
    if (!repetido) {
      addToQuoteCart(
        {
          slug: btn.dataset.slug ?? "",
          name: btn.dataset.name ?? "",
          category: btn.dataset.category,
          color,
          quantity: cantidad,
          unitLabel: btn.dataset.unit || "unidad",
          image: fotoEl?.getAttribute("src") || btn.dataset.image || "",
          pricePerUnit: btn.dataset.price || "Consultar",
          texture: btn.dataset.texture || undefined,
          productUrl: btn.dataset.url || `/productos/${btn.dataset.slug}`,
          variantId: btn.dataset.variantId || undefined,
          calidad: btn.dataset.calidad || undefined,
        },
        quoteProductCatalog
      );
    }

    window.location.href = "/cotizacion";
  });

  /* El botón de agregar se queda con el color y la foto de la variante que se esté viendo:
     quien elige «Matizado oscuro» y agrega, agrega ese. */
  document.querySelectorAll("[data-color-variants]").forEach((selector) => {
    const ficha = selector.closest(".product-page");
    const btn = ficha?.querySelector<HTMLElement>("[data-add-to-quote]");
    if (!btn) return;
    selector.querySelectorAll<HTMLElement>(".color-variant").forEach((opcion) => {
      opcion.addEventListener("click", () => {
        if (opcion.dataset.variantLabel) btn.dataset.color = opcion.dataset.variantLabel;
      });
    });
  });

  document.querySelectorAll(".product-page [data-product-gallery]").forEach((galeria) => {
    galeria.addEventListener("gallery-set", () => {
      const ficha = galeria.closest(".product-page");
      const btn = ficha?.querySelector<HTMLElement>("[data-add-to-quote]");
      const img = ficha?.querySelector<HTMLImageElement>(".product-gallery img");
      if (btn && img?.src) btn.dataset.image = img.src;
    });
  });

  document.addEventListener(QUOTE_CART_EVENT, refrescarContadores);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", refrescarContadores);
  } else {
    refrescarContadores();
  }
</script>
