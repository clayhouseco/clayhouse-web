---
export interface FeaturedProjectSlide {
  src: string;
  alt: string;
  label: string;
}

interface Props {
  slides: FeaturedProjectSlide[];
}

const { slides } = Astro.props;
const total = slides.length;
---

{
  total > 0 && (
    <div class="featured-projects" data-featured-projects>
      <div class="featured-projects__stage">
        <button
          type="button"
          class="featured-projects__nav featured-projects__nav--prev"
          aria-label="Proyecto anterior"
          data-featured-prev
        >
          <span aria-hidden="true">←</span>
        </button>

        <div class="featured-projects__viewport">
          {
            slides.map((slide, index) => (
              <figure
                class:list={[
                  "featured-projects__slide",
                  index === 0 && "featured-projects__slide--active",
                ]}
                data-featured-slide
              >
                <img
                  src={slide.src}
                  alt={slide.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <figcaption>{slide.label}</figcaption>
              </figure>
            ))
          }
        </div>

        <button
          type="button"
          class="featured-projects__nav featured-projects__nav--next"
          aria-label="Siguiente proyecto"
          data-featured-next
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>

      {
        total > 1 && (
          <p class="featured-projects__counter" aria-live="polite" data-featured-counter>
            1 / {total}
          </p>
        )
      }
    </div>
  )
}

<script>
  function bindFeaturedProjects(root: HTMLElement) {
    const slideEls = [...root.querySelectorAll<HTMLElement>("[data-featured-slide]")];
    const counter = root.querySelector<HTMLElement>("[data-featured-counter]");
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-featured-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-featured-next]");

    if (slideEls.length <= 1) {
      prevBtn?.setAttribute("hidden", "");
      nextBtn?.setAttribute("hidden", "");
      return;
    }

    let index = 0;

    const render = () => {
      slideEls.forEach((slide, i) => {
        slide.classList.toggle("featured-projects__slide--active", i === index);
      });
      if (counter) counter.textContent = `${index + 1} / ${slideEls.length}`;
    };

    const go = (direction: 1 | -1) => {
      index = (index + direction + slideEls.length) % slideEls.length;
      render();
    };

    prevBtn?.addEventListener("click", () => go(-1));
    nextBtn?.addEventListener("click", () => go(1));

    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") go(-1);
      if (e.key === "ArrowRight") go(1);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-featured-projects]").forEach(bindFeaturedProjects);
</script>

<style>
  .featured-projects {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
    display: flex;
    flex-direction: column;
  }

  .featured-projects__stage {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: inherit;
    padding: 1rem;
  }

  .featured-projects__viewport {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 100%;
    min-height: 24rem;
    border-radius: 0;
    overflow: hidden;
  }

  .featured-projects__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease),
      visibility 0.45s var(--ease);
  }

  .featured-projects__slide--active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .featured-projects__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-projects__slide figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    margin: 0;
    padding: 0.4rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-chocolate);
    background: rgba(255, 251, 249, 0.92);
    border-radius: var(--radius-sm);
    z-index: 2;
  }

  .featured-projects__nav {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid rgba(71, 36, 16, 0.12);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-chocolate);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(71, 36, 16, 0.1);
    transition:
      background 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease),
      transform 0.25s var(--ease);
    z-index: 3;
  }

  .featured-projects__nav:hover {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-white);
    transform: scale(1.05);
  }

  .featured-projects__nav:focus-visible {
    outline: 2px solid var(--color-coral);
    outline-offset: 3px;
  }

  .featured-projects__nav[hidden] {
    display: none;
  }

  .featured-projects__counter {
    position: absolute;
    top: 1rem;
    right: 1rem;
    margin: 0;
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-chocolate);
    background: rgba(255, 251, 249, 0.92);
    border-radius: var(--radius-sm);
    z-index: 4;
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .featured-projects__stage {
      padding: 0.75rem;
      gap: 0.5rem;
    }

    .featured-projects__nav {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1rem;
    }

    .featured-projects__viewport {
      min-height: 18rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-projects__slide {
      transition: none;
    }

    .featured-projects__nav:hover {
      transform: none;
    }
  }
</style>
