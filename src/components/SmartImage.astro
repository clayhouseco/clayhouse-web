---
import { assetUrl } from "@/utils/paths";

interface Props {
  src?: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  /** Texto corto en placeholder si la imagen no existe aún */
  placeholderLabel?: string;
}

const { src, alt, class: className, loading = "lazy", placeholderLabel } = Astro.props;

const rawSrc = typeof src === "string" ? src.trim() : "";
const hasSrc = rawSrc.length > 0;

/** Evita doble encode si la ruta ya viene codificada desde datos legacy */
function resolveUrl(path: string): string {
  if (path.startsWith("http://") || path.startsWith("https://")) return path;
  if (/%[0-9A-Fa-f]{2}/.test(path)) return path;
  return assetUrl(path);
}

const url = hasSrc ? resolveUrl(rawSrc) : "";
const showPlaceholderOnly = !hasSrc;
const id = `img-${Math.random().toString(36).slice(2, 9)}`;
const label = placeholderLabel ?? alt;
---

<div
  class:list={["smart-image", className, showPlaceholderOnly && "smart-image--placeholder"]}
  data-smart-image={id}
>
  {
    hasSrc && (
      <img
        src={url}
        alt={alt}
        loading={loading}
        class="smart-image__img"
        data-placeholder={label}
        onerror="this.classList.add('smart-image__img--hidden');this.parentElement.classList.add('smart-image--placeholder')"
      />
    )
  }
  {
    label && (
      <div class="smart-image__ph" aria-hidden={hasSrc ? "true" : "false"}>
        <span>{label}</span>
      </div>
    )
  }
</div>

<style>
  .smart-image {
    position: relative;
    background: var(--color-white);
    overflow: hidden;
  }

  .smart-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .smart-image__img--hidden {
    display: none;
  }

  .smart-image__ph {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
    background: linear-gradient(
      145deg,
      rgba(242, 232, 221, 0.9),
      rgba(249, 154, 145, 0.25)
    );
    border: 1px dashed rgba(124, 72, 44, 0.35);
  }

  .smart-image__ph span {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-terracota);
    max-width: 14rem;
    line-height: 1.4;
  }

  .smart-image--placeholder .smart-image__ph {
    display: flex;
  }
</style>
