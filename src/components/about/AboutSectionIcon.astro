---
import type { AboutIconId } from "@/data/nosotros";

interface Props {
  icon: AboutIconId;
}

const { icon } = Astro.props;
---

<span class="about-card__icon" aria-hidden="true">
  {
    icon === "history" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 8v4l3 2" />
        <circle cx="12" cy="12" r="9" />
      </svg>
    )
  }
  {
    icon === "manifesto" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M6 4h9l3 3v13H6V4z" />
        <path d="M15 4v4h4M8 12h8M8 16h6" />
      </svg>
    )
  }
  {
    icon === "mission" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 20h16L12 6 4 20z" stroke-linejoin="round" />
        <path d="M12 6v3M12 4.5l1.2 1.2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M11 9h2v2h-2z" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    icon === "vision" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 10c1.5-2.5 4-4 9-4s7.5 1.5 9 4c-1.5 2.5-4 4-9 4s-7.5-1.5-9-4z" />
        <circle cx="12" cy="10" r="2.5" />
        <path d="M2 14h4v3H2zM18 14h4v3h-4z" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    icon === "territory" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 21s-7-4.5-7-11a7 7 0 1114 0c0 6.5-7 11-7 11z" />
        <circle cx="12" cy="10" r="2" />
      </svg>
    )
  }
  {
    icon === "catalog" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="4" y="4" width="7" height="7" rx="0.5" />
        <rect x="13" y="4" width="7" height="7" rx="0.5" />
        <rect x="4" y="13" width="7" height="7" rx="0.5" />
        <rect x="13" y="13" width="7" height="7" rx="0.5" />
      </svg>
    )
  }
</span>
