---
import type { AboutIconId } from "@/data/nosotros";

interface Props {
  icon: AboutIconId;
}

const { icon } = Astro.props;
---

<span class="about-card__icon" aria-hidden="true">
  {
    icon === "team" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 10.5L12 4l9 6.5V20a1 1 0 01-1 1h-5v-7H9v7H4a1 1 0 01-1-1v-9.5z" />
      </svg>
    )
  }
  {
    icon === "history" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 8v4l3 2" />
        <circle cx="12" cy="12" r="9" />
        <path d="M12 3v2M12 19v2M3 12h2M19 12h2" stroke-width="1.25" />
      </svg>
    )
  }
  {
    icon === "mission" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="5" />
        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    icon === "vision" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" />
        <circle cx="12" cy="12" r="2.5" />
      </svg>
    )
  }
  {
    icon === "territory" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 21s-7-4.5-7-11a7 7 0 1114 0c0 6.5-7 11-7 11z" />
        <circle cx="12" cy="10" r="2" />
      </svg>
    )
  }
  {
    icon === "catalog" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="4" y="4" width="7" height="7" rx="0.5" />
        <rect x="13" y="4" width="7" height="7" rx="0.5" />
        <rect x="4" y="13" width="7" height="7" rx="0.5" />
        <rect x="13" y="13" width="7" height="7" rx="0.5" />
      </svg>
    )
  }
</span>
