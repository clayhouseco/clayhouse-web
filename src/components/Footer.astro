---
import { site, nav, socialLinks } from "@/data/site";
import { catalogCategories, getCatalogCategoryHref } from "@/data/catalogCategories";
import { logos } from "@/utils/media";
import FooterSocialIcon from "@/components/FooterSocialIcon.astro";
import { Image } from "astro:assets";
import footerBg from "@/assets/images/footer/footer-pisos.jpg";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__bg" aria-hidden="true">
    <Image
      src={footerBg}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      formats={["avif", "webp"]}
      loading="lazy"
      width={1920}
      height={1280}
    />
    <div class="footer__overlay"></div>
  </div>
  <div class="container footer__inner">
    <div class="footer__grid">
      <article class="footer__card footer__card--brand">
        <a href="/" class="footer__logo-link">
          <img
            src={logos.footerMark}
            alt={site.name}
            class="footer__logo-img"
            width="120"
            height="120"
            loading="lazy"
          />
        </a>
        <p class="footer__tagline">{site.tagline}</p>
      </article>

      <article class="footer__card footer__card--menu">
        <p class="footer__heading">Navegación</p>
        <ul class="footer__links">
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </article>

      <article class="footer__card footer__card--menu">
        <p class="footer__heading">Contacto</p>
        <ul class="footer__links">
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <a href={site.phoneHref}>{site.phone}</a>
          </li>
          <li>{site.address}</li>
          <li class="footer__hours">{site.hours}</li>
        </ul>
      </article>

      <article class="footer__card footer__card--menu">
        <p class="footer__heading">Catálogo</p>
        <ul class="footer__links">
          {
            catalogCategories.map((cat) => (
              <li>
                <a href={getCatalogCategoryHref(cat.id)}>{cat.label}</a>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="footer__card footer__card--menu footer__card--social">
        <p class="footer__heading">Redes sociales</p>
        <nav class="footer__social" aria-label="Redes sociales">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="footer__social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
              >
                <FooterSocialIcon id={social.id} />
              </a>
            ))
          }
        </nav>
      </article>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>
      © {year} {site.name}. Todos los derechos reservados. ·{" "}
      <a href="/privacidad" class="footer__legal">Privacidad</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    background: var(--color-chocolate);
    color: var(--color-chocolate);
    padding-block: clamp(3rem, 8vw, 4.5rem) 0;
    overflow: hidden;
  }

  .footer__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .footer__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .footer__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(35, 18, 8, 0.78) 0%,
      rgba(35, 18, 8, 0.92) 100%
    );
  }

  .footer__inner {
    position: relative;
    display: block;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.1fr repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .footer__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: clamp(1.15rem, 2.5vw, 1.5rem);
    background: var(--color-bg);
    border: 1px solid rgba(71, 36, 16, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .footer__card:hover {
    transform: translateY(-6px);
    border-color: rgba(124, 72, 44, 0.18);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
  }

  .footer__card--brand {
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--color-chocolate);
    border-color: rgba(255, 251, 249, 0.1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .footer__card--brand:hover {
    border-color: rgba(249, 154, 145, 0.35);
    box-shadow: 0 20px 52px rgba(0, 0, 0, 0.28);
  }

  .footer__logo-link {
    display: inline-block;
    margin: 0 auto 1rem;
    transition: transform 0.35s var(--ease);
  }

  .footer__logo-link:hover {
    transform: translateY(-4px);
  }

  .footer__logo-img {
    width: 6.75rem;
    height: auto;
    display: block;
    mix-blend-mode: screen;
  }

  .footer__tagline {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    font-style: italic;
    color: var(--color-bg);
    margin: 0 auto;
    line-height: 1.35;
    max-width: 18ch;
    text-align: center;
  }

  .footer__card--menu {
    align-items: center;
    text-align: center;
  }

  .footer__heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-terracota);
    margin: 0 0 0.65rem;
    width: 100%;
    text-align: center;
  }

  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-chocolate);
    width: 100%;
  }

  .footer__links li {
    font-weight: 500;
  }

  .footer__links a {
    color: inherit;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .footer__links a:hover {
    color: var(--color-coral);
  }

  .footer__hours {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    margin-top: 0.35rem;
  }

  .footer__card--social .footer__social {
    flex: 1;
    align-content: center;
  }

  .footer__social {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    width: 100%;
    justify-items: center;
  }

  .footer__social-link {
    --social-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--social-size);
    height: var(--social-size);
    border-radius: 50%;
    color: var(--color-terracota);
    background: var(--color-white);
    border: 1px solid rgba(71, 36, 16, 0.1);
    box-shadow: 0 2px 8px rgba(71, 36, 16, 0.06);
    transition:
      transform 0.35s var(--ease),
      color 0.25s var(--ease),
      background 0.25s var(--ease),
      border-color 0.25s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .footer__social-link:hover {
    transform: translateY(-5px);
    color: var(--color-bg);
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    box-shadow: 0 12px 28px rgba(71, 36, 16, 0.18);
  }

  .footer__social-link:focus-visible {
    outline: 2px solid var(--color-coral);
    outline-offset: 3px;
  }

  .footer__card--social .footer__social-link :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    display: block;
  }

  .footer__bottom {
    position: relative;
    padding: 1.75rem 0 2rem;
    font-size: 0.8125rem;
    color: rgba(255, 251, 249, 0.55);
    text-align: center;
  }

  .footer__legal {
    color: rgba(255, 251, 249, 0.75);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer__legal:hover {
    color: var(--color-ambar);
  }

  @media (max-width: 1100px) {
    .footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer__card--brand {
      grid-column: 1 / -1;
    }

  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__card--brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__logo-img {
      width: 6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__card:hover,
    .footer__logo-link:hover,
    .footer__social-link:hover {
      transform: none;
    }
  }
</style>
