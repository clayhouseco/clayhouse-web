---
import { primaryNav, site } from "@/data/site";
import { logos } from "@/utils/media";

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner container">
    <a href="/" class="header__logo">
      <img
        src={logos.header}
        alt={site.name}
        class="header__logo-img"
        width="360"
        height="70"
        onerror={`this.onerror=null;this.src='${logos.headerAlt}'`}
      />
      <span class="header__logo-text" hidden>{site.name}</span>
    </a>
    <nav class="header__nav" aria-label="Principal" id="header-nav">
      <ul>
        {
          primaryNav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "header__link",
                  {
                    "header__link--active":
                      item.href === "/"
                        ? currentPath === "/"
                        : currentPath.startsWith(item.href),
                  },
                ]}
                data-nav-link
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="header__nav-extras">
        <button
          type="button"
          class="header__cart-btn"
          data-quote-cart-open
          data-quote-header-cart
          hidden
          aria-label="Ver cotización"
        >
          cotización
          <span class="header__cart-count" data-quote-header-count hidden>0</span>
        </button>
        <a href="/contacto" class="header__cta btn btn--primary" data-track="cotizar_click" data-track-location="header">Cotizar</a>
      </div>
    </nav>
    <div class="header__actions">
      <button
        type="button"
        class="header__cart-btn"
        data-quote-cart-open
        data-quote-header-cart
        hidden
        aria-label="Ver cotización"
      >
        cotización
        <span class="header__cart-count" data-quote-header-count hidden>0</span>
      </button>
      <a href="/contacto" class="header__cta btn btn--primary" data-track="cotizar_click" data-track-location="header">Cotizar</a>
    </div>
    <button class="header__toggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector(".header__toggle");
  const nav = document.querySelector(".header__nav");

  const header = document.querySelector(".header");

  function setNavOpen(open: boolean) {
    nav?.classList.toggle("header__nav--open", open);
    header?.classList.toggle("header--nav-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.body.classList.toggle("nav-open", open);
  }

  toggle?.addEventListener("click", () => {
    setNavOpen(!nav?.classList.contains("header__nav--open"));
  });

  nav?.querySelectorAll("[data-nav-link]").forEach((link) => {
    link.addEventListener("click", () => setNavOpen(false));
  });

  document.querySelectorAll("[data-quote-cart-open]").forEach((btn) => {
    btn.addEventListener("click", () => setNavOpen(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setNavOpen(false);
  });
</script>

<script>
  import { QUOTE_CART_EVENT, getQuoteCartCount } from "@/utils/quoteCart";

  function updateHeaderCart() {
    const count = getQuoteCartCount();
    document.querySelectorAll<HTMLElement>("[data-quote-header-count]").forEach((el) => {
      el.textContent = String(count);
      el.hidden = count === 0;
    });
    document.querySelectorAll<HTMLElement>("[data-quote-header-cart]").forEach((btn) => {
      btn.hidden = count === 0;
    });
  }

  document.addEventListener(QUOTE_CART_EVENT, updateHeaderCart);
  updateHeaderCart();
</script>

<script>
  const header = document.querySelector<HTMLElement>(".header");
  const hero = document.querySelector<HTMLElement>(".hero, .page-hero--image");

  if (header && hero) {
    header.classList.add("header--transparent");

    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle("header--transparent", entry.isIntersecting);
      },
      { threshold: 0, rootMargin: "-80px 0px 0px 0px" }
    );
    observer.observe(hero);
  }
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(255, 251, 249, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(71, 36, 16, 0.06);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .header--transparent {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .header--transparent .header__link {
    color: #ffffff;
    opacity: 0.85;
  }

  .header--transparent .header__link:hover,
  .header--transparent .header__link--active {
    color: #ffffff;
    opacity: 1;
  }

  .header--transparent .header__toggle span {
    background: #ffffff;
  }

  .header--transparent .header__cta {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.5);
    color: #ffffff;
  }

  .header--transparent .header__cart-btn {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .header--transparent .header__logo-img {
    filter: brightness(0) invert(1);
  }

  @media (max-width: 768px) {
    .header--transparent.header--nav-open {
      background: var(--color-bg);
      backdrop-filter: blur(12px);
    }

    .header--transparent.header--nav-open .header__link {
      color: var(--color-chocolate);
      opacity: 0.7;
    }

    .header--transparent.header--nav-open .header__link:hover,
    .header--transparent.header--nav-open .header__link--active {
      color: var(--color-terracota);
      opacity: 1;
    }

    .header--transparent.header--nav-open .header__toggle span {
      background: var(--color-chocolate);
    }

    .header--transparent.header--nav-open .header__logo-img {
      filter: none;
    }

    .header--transparent.header--nav-open .header__cta {
      background: var(--color-terracota);
      border-color: var(--color-terracota);
      color: var(--color-white);
    }

    .header--transparent.header--nav-open .header__cart-btn {
      border-color: rgba(71, 36, 16, 0.2);
      background: var(--color-white);
      color: var(--color-chocolate);
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5.25rem;
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-chocolate);
  }

  .header__logo-img {
    height: 2.75rem;
    width: auto;
    max-width: min(320px, 52vw);
    object-fit: contain;
    object-position: left center;
  }

  @media (min-width: 768px) {
    .header__logo-img {
      height: 3.5rem;
      max-width: 360px;
    }
  }

  .header__logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
  }

  .header__nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-chocolate);
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .header__link:hover,
  .header__link--active {
    opacity: 1;
    color: var(--color-terracota);
  }

  .header__actions {
    display: none;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .header__cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.625rem 0.9rem;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid rgba(71, 36, 16, 0.2);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: var(--color-chocolate);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .header__cart-btn:hover {
    border-color: var(--color-terracota);
    color: var(--color-terracota);
  }

  .header__cart-btn:not([hidden]) {
    border-color: var(--color-terracota);
    background: rgba(124, 72, 44, 0.06);
  }

  .header__nav-extras {
    display: none;
  }

  .header__cart-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding: 0 0.3rem;
    font-size: 0.625rem;
    font-weight: 700;
    background: var(--color-terracota);
    color: var(--color-white);
    border-radius: 999px;
  }

  .header__cta {
    padding: 0.625rem 1.25rem;
    font-size: 0.6875rem;
    flex-shrink: 0;
  }

  @media (min-width: 769px) {
    .header__actions {
      display: flex;
    }
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }

  .header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-chocolate);
  }

  :global(body.nav-open) {
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .header__inner {
      height: 4.5rem;
    }

    .header__logo-img {
      height: 2.35rem;
    }

    .header__toggle {
      display: flex;
    }

    .header__actions {
      display: none;
    }

    .header__nav {
      position: fixed;
      inset: 4.5rem 0 auto 0;
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
      background: var(--color-bg);
      padding: 2rem;
      border-bottom: 1px solid rgba(71, 36, 16, 0.08);
      transform: translateY(-120%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.3s var(--ease), opacity 0.3s;
    }

    .header__nav--open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .header__nav ul {
      flex-direction: column;
      gap: 1.25rem;
    }

    .header__nav-extras {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(71, 36, 16, 0.08);
    }

    .header__nav-extras .header__cart-btn,
    .header__nav-extras .header__cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
