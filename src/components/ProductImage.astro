---
import { productImage } from "@/utils/media";

interface Props {
  slug: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
}

const { slug, alt, class: className, loading = "lazy" } = Astro.props;
const src = productImage(slug);
const fallback =
  "https://images.unsplash.com/photo-1600585154526-990dced4db0d?w=1200&q=80";
---

<img
  src={src}
  alt={alt}
  class={className}
  loading={loading}
  onerror={`this.onerror=null;this.src='${fallback}'`}
/>
