---
import {
  catalogCategories,
  getCatalogCategoryHref,
  type ProductCategory,
} from "@/data/catalogCategories";
import { getCatalogCoverImage } from "@/utils/catalog";

interface Props {
  activeCategory?: ProductCategory | null;
}

const { activeCategory = null } = Astro.props;
---

<nav class="cat-filters" aria-label="Categorías de productos">
  <a href="/productos" class:list={["cat-filter", !activeCategory && "cat-filter--active"]}>
    <span class="cat-filter__thumb cat-filter__thumb--grid" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="7" height="7" rx="1" />
        <rect x="14" y="3" width="7" height="7" rx="1" />
        <rect x="3" y="14" width="7" height="7" rx="1" />
        <rect x="14" y="14" width="7" height="7" rx="1" />
      </svg>
    </span>
    <span class="cat-filter__label">Todos</span>
  </a>
  {
    catalogCategories.map((cat) => (
      <a
        href={getCatalogCategoryHref(cat.id)}
        class:list={["cat-filter", activeCategory === cat.id && "cat-filter--active"]}
      >
        <span class="cat-filter__thumb" aria-hidden="true">
          <img
            src={getCatalogCoverImage(cat)}
            alt=""
            width="120"
            height="120"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="cat-filter__label">{cat.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .cat-filters {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .cat-filter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 0.5rem 0.85rem;
    background: var(--color-white);
    border: 1px solid rgba(71, 36, 16, 0.1);
    border-radius: var(--radius-md);
    color: var(--color-chocolate);
    text-decoration: none;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease), background 0.2s, color 0.2s;
  }

  .cat-filter:hover {
    transform: translateY(-3px);
    border-color: var(--color-terracota);
    box-shadow: 0 10px 24px rgba(71, 36, 16, 0.1);
  }

  .cat-filter--active {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-bg);
  }

  .cat-filter__thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid rgba(71, 36, 16, 0.06);
  }

  .cat-filter__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cat-filter__thumb--grid {
    color: var(--color-terracota);
    background: var(--color-bg);
  }

  .cat-filter__thumb--grid svg {
    width: 1.85rem;
    height: 1.85rem;
  }

  .cat-filter--active .cat-filter__thumb {
    border-color: rgba(255, 251, 249, 0.25);
  }

  .cat-filter--active .cat-filter__thumb--grid {
    background: rgba(255, 251, 249, 0.15);
    color: var(--color-bg);
  }

  .cat-filter__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.2;
  }

  @media (max-width: 720px) {
    .cat-filters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .cat-filter {
      padding: 0.7rem 0.4rem;
      gap: 0.5rem;
    }

    .cat-filter__thumb {
      width: 3rem;
      height: 3rem;
    }

    .cat-filter__thumb--grid svg {
      width: 1.6rem;
      height: 1.6rem;
    }

    .cat-filter__label {
      font-size: 0.6875rem;
    }
  }

  @media (max-width: 400px) {
    .cat-filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
