---
import { products } from "@/data/products";
import { sortProductsByPriority } from "@/data/products";

/** Solo productos con rendimiento numérico Y precio publicado. */
function parseRendimiento(value?: string): number | null {
  if (!value) return null;
  const m = value.match(/(\d+)\s*und/i);
  return m ? parseInt(m[1], 10) : null;
}

function parsePriceCOP(price?: string): number | null {
  if (!price) return null;
  const digits = price.replace(/[^\d]/g, "");
  return digits ? parseInt(digits, 10) : null;
}

/** Productos calculables:
 *   - Modo "unidad": precio por unidad + rendimiento numérico (Romano, Toscano, etc.)
 *   - Modo "m2": precio por m² (enchapes, pisos, teja plana) — no requiere rendimiento
 */
const calculableProducts = sortProductsByPriority(products)
  .map((p) => {
    const price = parsePriceCOP(p.pricePerUnit);
    const unitsPerSqm = parseRendimiento(p.dimensions?.rendimiento);
    const isPerSqm = (p.priceUnitLabel ?? "").toLowerCase().includes("m²");
    if (!price) return null;
    if (!isPerSqm && unitsPerSqm === null) return null;
    return {
      slug: p.slug,
      name: p.name,
      mode: isPerSqm ? ("m2" as const) : ("unidad" as const),
      unitsPerSqm,
      pricePerUnit: price,
      priceLabel: p.pricePerUnit ?? "",
    };
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);

const calculatorPayload = calculableProducts.map((p) => ({
  slug: p.slug,
  name: p.name,
  mode: p.mode,
  unitsPerSqm: p.unitsPerSqm,
  pricePerUnit: p.pricePerUnit,
}));
---

<section class="brick-calc" aria-labelledby="brick-calc-title">
  <div class="brick-calc__intro">
    <p class="eyebrow">Herramienta</p>
    <h2 id="brick-calc-title">¿Cuántas piezas necesita?</h2>
    <p class="brick-calc__lead">
      Estimación rápida por m². Incluye 5% de desperdicio recomendado en obra. La cotización
      final depende de volumen, destino y disponibilidad.
    </p>
  </div>

  <form class="brick-calc__form" data-brick-calc novalidate>
    <label class="brick-calc__field">
      <span class="brick-calc__label">Producto</span>
      <select name="product" data-calc-product required>
        <option value="">Seleccione…</option>
        {
          calculableProducts.map((p) => (
            <option value={p.slug}>
              {p.name} · {p.priceLabel} / {p.mode === "m2" ? "m²" : "unidad"}
            </option>
          ))
        }
      </select>
    </label>

    <label class="brick-calc__field">
      <span class="brick-calc__label">Área a cubrir (m²)</span>
      <input
        type="number"
        name="area"
        data-calc-area
        min="1"
        step="1"
        inputmode="numeric"
        placeholder="Ej. 120"
        required
      />
    </label>

    <div class="brick-calc__results" data-calc-results aria-live="polite">
      <div class="brick-calc__result">
        <span class="brick-calc__result-label">Piezas estimadas</span>
        <strong class="brick-calc__result-value" data-calc-units>—</strong>
        <span class="brick-calc__result-note" data-calc-units-note></span>
      </div>
      <div class="brick-calc__result brick-calc__result--total">
        <span class="brick-calc__result-label">Costo orientativo</span>
        <strong class="brick-calc__result-value" data-calc-total>—</strong>
        <span class="brick-calc__result-note">Sin IVA · sin flete</span>
      </div>
    </div>

    <a href="/contacto" class="btn btn--primary brick-calc__cta" data-calc-cta>
      Cotizar con estos datos →
    </a>
  </form>
</section>

<script type="application/json" id="brick-calc-data" set:html={JSON.stringify(calculatorPayload)}></script>

<script>
  interface CalcProduct {
    slug: string;
    name: string;
    mode: "unidad" | "m2";
    unitsPerSqm: number | null;
    pricePerUnit: number;
  }

  const dataEl = document.getElementById("brick-calc-data");
  const products: CalcProduct[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];

  const form = document.querySelector<HTMLFormElement>("[data-brick-calc]");
  const productSel = form?.querySelector<HTMLSelectElement>("[data-calc-product]");
  const areaInput = form?.querySelector<HTMLInputElement>("[data-calc-area]");
  const unitsOut = form?.querySelector<HTMLElement>("[data-calc-units]");
  const unitsNote = form?.querySelector<HTMLElement>("[data-calc-units-note]");
  const totalOut = form?.querySelector<HTMLElement>("[data-calc-total]");
  const cta = form?.querySelector<HTMLAnchorElement>("[data-calc-cta]");

  function format(n: number): string {
    return new Intl.NumberFormat("es-CO", { maximumFractionDigits: 0 }).format(n);
  }

  function formatCOP(n: number): string {
    return new Intl.NumberFormat("es-CO", {
      style: "currency",
      currency: "COP",
      maximumFractionDigits: 0,
    }).format(n);
  }

  function recompute() {
    if (!productSel || !areaInput || !unitsOut || !unitsNote || !totalOut || !cta) return;
    const product = products.find((p) => p.slug === productSel.value);
    const area = parseFloat(areaInput.value);
    const unitsRow = unitsOut.closest(".brick-calc__result") as HTMLElement | null;

    if (!product || !area || area <= 0) {
      unitsOut.textContent = "—";
      unitsNote.textContent = "";
      totalOut.textContent = "—";
      if (unitsRow) unitsRow.hidden = false;
      cta.href = "/contacto";
      cta.setAttribute("aria-disabled", "true");
      cta.classList.add("brick-calc__cta--disabled");
      return;
    }

    const params = new URLSearchParams({ producto: product.slug, area: String(area) });

    if (product.mode === "m2") {
      // Modo precio por m²: directo, sin estimar piezas
      const totalCop = product.pricePerUnit * area * 1.05;
      if (unitsRow) unitsRow.hidden = true;
      totalOut.textContent = formatCOP(totalCop);
    } else if (product.unitsPerSqm) {
      // Modo precio por unidad: estima piezas + 5% desperdicio
      const baseUnits = product.unitsPerSqm * area;
      const unitsWithBuffer = Math.ceil(baseUnits * 1.05);
      const totalCop = unitsWithBuffer * product.pricePerUnit;
      if (unitsRow) unitsRow.hidden = false;
      unitsOut.textContent = format(unitsWithBuffer);
      unitsNote.textContent = `${product.unitsPerSqm} und/m² × ${area} m² + 5% desperdicio`;
      totalOut.textContent = formatCOP(totalCop);
      params.set("unidades", String(unitsWithBuffer));
    }

    cta.href = `/contacto?${params.toString()}`;
    cta.setAttribute("aria-disabled", "false");
    cta.classList.remove("brick-calc__cta--disabled");
  }

  productSel?.addEventListener("change", recompute);
  areaInput?.addEventListener("input", recompute);
  // Estado inicial: deshabilita el CTA
  recompute();
</script>

<style>
  .brick-calc {
    background: var(--color-white);
    border: 1px solid rgba(71, 36, 16, 0.1);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: 0 4px 24px rgba(71, 36, 16, 0.06);
    margin-bottom: 2.5rem;
  }

  .brick-calc__intro {
    margin-bottom: 1.5rem;
  }

  .brick-calc__intro .eyebrow {
    margin-bottom: 0.4rem;
  }

  .brick-calc__intro h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
  }

  .brick-calc__lead {
    margin: 0;
    max-width: 42rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .brick-calc__form {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1rem 1.25rem;
    align-items: end;
  }

  .brick-calc__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .brick-calc__label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-chocolate);
  }

  .brick-calc__form select,
  .brick-calc__form input {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem 0.95rem;
    border: 1px solid rgba(71, 36, 16, 0.18);
    background: var(--color-bg);
    color: var(--color-chocolate);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .brick-calc__form select:focus,
  .brick-calc__form input:focus {
    outline: none;
    border-color: var(--color-terracota);
    box-shadow: 0 0 0 3px rgba(124, 72, 44, 0.12);
  }

  .brick-calc__results {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-bg);
    border-radius: var(--radius-md);
    border: 1px solid rgba(71, 36, 16, 0.06);
  }

  .brick-calc__result {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* hidden attribute pierde contra display:flex sin esta regla */
  .brick-calc__result[hidden] {
    display: none;
  }

  /* Cuando solo se muestra la columna de costo (modo m²), céntrala */
  .brick-calc__results:has(.brick-calc__result[hidden]) {
    grid-template-columns: 1fr;
  }

  .brick-calc__result-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .brick-calc__result-value {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-chocolate);
    line-height: 1.1;
  }

  .brick-calc__result--total .brick-calc__result-value {
    font-size: 1.75rem;
  }

  .brick-calc__result-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .brick-calc__cta {
    grid-column: 1 / -1;
    justify-self: stretch;
    margin-top: 0.25rem;
  }

  .brick-calc__cta--disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .brick-calc__form {
      grid-template-columns: 1fr;
    }

    .brick-calc__results {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
