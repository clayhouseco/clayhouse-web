---
import type { Product } from "@/data/products";
import CatalogProductCard from "@/components/catalog/CatalogProductCard.astro";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="product-grid">
  {products.map((p) => <CatalogProductCard product={p} />)}
</div>
