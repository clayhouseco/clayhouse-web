---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import QuoteCart from "@/components/QuoteCart.astro";
import Analytics from "@/components/Analytics.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import { site } from "@/data/site";
import { localBusinessJsonLd } from "@/data/schema";
import { logos } from "@/utils/media";
import "@/styles/fonts.css";
import "@/styles/global.css";
import "@/styles/responsive.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Tipo Open Graph: "website" (default) o "article" para posts del blog */
  ogType?: string;
  /** En /contacto no se muestra el panel lateral de cotización (evita duplicar el flujo) */
  hideQuoteCart?: boolean;
  /** Imagen LCP de la página (se hace preload con fetchpriority=high) */
  preloadImage?: string;
  /** Tipo MIME del preload image, p.ej. "image/jpeg" o "image/webp" */
  preloadImageType?: string;
}

const {
  title,
  description = site.description,
  ogImage,
  ogType = "website",
  hideQuoteCart = false,
  preloadImage,
  preloadImageType,
} = Astro.props;
const fullTitle =
  title === site.name
    ? `${site.name} | ${site.tagline}`
    : title.includes(site.name)
      ? title
      : `${title} | ${site.name}`;

const canonicalPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = new URL(canonicalPath, site.url).href;
const ogImagePath = ogImage ?? site.defaultOgImage;
const ogImageUrl = ogImagePath.startsWith("http")
  ? ogImagePath
  : new URL(ogImagePath, site.url).href;

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>
    <link rel="icon" href="/icons/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icons/favicon-16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="dns-prefetch" href="https://wa.me" />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        type={preloadImageType}
        fetchpriority="high"
      />
    )}
    <meta name="theme-color" content="#472410" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${site.name} — ladrillo y teja de arcilla para fachadas, pisos y cubiertas`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido-principal">
      <slot />
    </main>
    <Footer />
    {!hideQuoteCart && <QuoteCart />}
    <Analytics />
    <CookieConsent />
    <a
      href={site.whatsapp}
      class="whatsapp-fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
      data-track="whatsapp_click"
      data-track-location="fab"
    >
      <span class="whatsapp-fab__pulse" aria-hidden="true"></span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
        ></path>
      </svg>
      <span class="whatsapp-fab__label">Escríbenos</span>
    </a>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
    padding: 0.75rem 1rem;
    background: var(--color-chocolate);
    color: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }

  main {
    min-height: 60vh;
  }

  .whatsapp-fab {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 100;
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 0;
    background: #25d366;
    color: white;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.35), 0 4px 12px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.25s var(--ease),
      padding 0.25s var(--ease),
      width 0.25s var(--ease);
    overflow: hidden;
  }

  .whatsapp-fab svg {
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .whatsapp-fab__label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition:
      max-width 0.25s var(--ease),
      opacity 0.2s var(--ease),
      margin-left 0.25s var(--ease);
  }

  .whatsapp-fab:hover,
  .whatsapp-fab:focus-visible {
    width: auto;
    padding: 0 1.15rem 0 0.85rem;
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(37, 211, 102, 0.45), 0 6px 18px rgba(0, 0, 0, 0.22);
  }

  .whatsapp-fab:hover .whatsapp-fab__label,
  .whatsapp-fab:focus-visible .whatsapp-fab__label {
    max-width: 10rem;
    opacity: 1;
    margin-left: 0.5rem;
  }

  .whatsapp-fab__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    opacity: 0.45;
    animation: whatsapp-pulse 2.2s var(--ease) infinite;
    pointer-events: none;
  }

  @keyframes whatsapp-pulse {
    0% {
      transform: scale(1);
      opacity: 0.45;
    }
    70% {
      transform: scale(1.6);
      opacity: 0;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab__pulse {
      animation: none;
    }
  }
</style>
