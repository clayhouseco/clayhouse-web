---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { site } from "@/data/site";
import { products } from "@/data/products";
import { catalogCategories, parseCategoryParam } from "@/data/catalogCategories";
import { colors } from "@/data/colors";

const referencia = Astro.url.searchParams.get("referencia");
const productoQuery = Astro.url.searchParams.get("producto");
const categoriaQuery = Astro.url.searchParams.get("categoria");

const fromProduct = referencia
  ? products.find((p) => p.slug === referencia)
  : productoQuery
    ? products.find((p) => p.name === productoQuery || p.slug === productoQuery)
    : undefined;

const preselectedCategory = parseCategoryParam(categoriaQuery);

const defaultMessage = fromProduct ? `Me interesa cotizar ${fromProduct.name}.` : "";

const productsByCategory = catalogCategories.map((cat) => ({
  label: cat.label,
  products: products.filter((p) => p.category === cat.id),
}));

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const formspreeReady =
  Boolean(formspreeId) && formspreeId !== "your_form_id" && !formspreeId.startsWith("your_");
const formAction = formspreeReady ? `https://formspree.io/f/${formspreeId}` : undefined;

const thankYouUrl = new URL("/contacto/gracias/", site.url).href;
const thankYouPath = "/contacto/gracias/";
---

<BaseLayout
  title="Contacto y cotización"
  description="Solicite cotización, muestras físicas o asesoría técnica. Taller en Amagá, Antioquia."
  hideQuoteCart
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contacto comercial</p>
      <h1>Hablemos de su proyecto</h1>
      <p class="text-muted page-hero__lead">
        Cuéntenos qué necesita. Respondemos con cotización, fichas técnicas o una caja de muestras en su
        estudio.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Datos de contacto</h2>
        <ul class="contact-list">
          <li>
            <strong>Dirección</strong><br />{site.address}
          </li>
          <li>
            <strong>Teléfono</strong><br />
            <a href={site.phoneHref}>{site.phone}</a>
          </li>
          <li>
            <strong>Email</strong><br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <strong>Horario</strong><br />{site.hours}
          </li>
        </ul>
        <a
          href={site.whatsapp}
          class="btn btn--primary"
          target="_blank"
          rel="noopener"
          data-track="whatsapp_click"
          data-track-location="contacto"
        >
          WhatsApp
        </a>

        <div class="samples-picker" data-samples-picker>
          <div class="samples-picker__header">
            <h3>Caja de muestras gratis</h3>
            <p>
              Elija hasta <strong>5 tonalidades</strong>. Las marcadas se añaden a su mensaje al
              enviar el formulario.
            </p>
          </div>
          <ul class="samples-grid" role="list">
            {
              colors.map((color) => (
                <li>
                  <label class="sample-swatch" data-sample-label>
                    <input
                      type="checkbox"
                      name="muestras_colores"
                      value={color.name}
                      data-sample-checkbox
                    />
                    <span class="sample-swatch__chip" style={`background:${color.hex};`} aria-hidden="true" />
                    <span class="sample-swatch__info">
                      <span class="sample-swatch__name">{color.name}</span>
                      <span class="sample-swatch__desc">{color.description}</span>
                    </span>
                    <span class="sample-swatch__check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <path d="M5 12l4 4L19 6" />
                      </svg>
                    </span>
                  </label>
                </li>
              ))
            }
          </ul>
          <p class="samples-picker__counter">
            <span data-sample-counter>0</span> de 5 colores seleccionados
          </p>
        </div>

        <div class="contact-map">
          <h3>Visítenos en Amagá</h3>
          <div class="contact-map__frame">
            <iframe
              src={site.mapsEmbedUrl}
              title="Ubicación Clay House en Amagá, Antioquia"
              width="100%"
              height="400"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
          <a
            href={site.mapsDirectionsUrl}
            class="contact-map__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            cómo llegar en Google Maps →
          </a>
        </div>
      </div>

      <ContactForm
        formAction={formAction}
        thankYouUrl={thankYouUrl}
        referencia={referencia}
        fromProduct={fromProduct}
        preselectedCategory={preselectedCategory}
        productsByCategory={productsByCategory}
        defaultMessage={defaultMessage}
      />
    </div>
  </section>
</BaseLayout>

<script
  define:vars={{
    whatsappUrl: site.whatsapp,
    thankYouPath,
    useFormspree: Boolean(formAction),
  }}
>
  const form = document.getElementById("contact-form");
  if (!form || useFormspree) return;

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const lines = [
      "Hola Clay House, solicito información:",
      "",
      `Nombre: ${fd.get("nombre")}`,
      fd.get("empresa") ? `Empresa: ${fd.get("empresa")}` : "",
      `Rol: ${fd.get("rol")}`,
      `Email: ${fd.get("email")}`,
      `Teléfono: ${fd.get("telefono")}`,
      `Ciudad: ${fd.get("ciudad")}`,
      fd.get("tipo_proyecto") ? `Proyecto: ${fd.get("tipo_proyecto")}` : "",
      (() => {
        const picked = fd.getAll("productos_interes");
        if (picked.length) return `Productos: ${picked.join(", ")}`;
        return "";
      })(),
      fd.get("muestras") ? `Muestras físicas: ${fd.get("muestras")}` : "",
      fd.get("referencia") ? `Referencia web: ${fd.get("referencia")}` : "",
      "",
      String(fd.get("mensaje") || ""),
    ].filter(Boolean);

    window.open(`${whatsappUrl}?text=${encodeURIComponent(lines.join("\n"))}`, "_blank");
    window.location.href = thankYouPath;
  });
</script>

<script>
  const MAX_SAMPLES = 5;
  const picker = document.querySelector<HTMLElement>("[data-samples-picker]");
  const checkboxes = picker?.querySelectorAll<HTMLInputElement>("[data-sample-checkbox]");
  const counter = picker?.querySelector<HTMLElement>("[data-sample-counter]");
  const messageField = document.querySelector<HTMLTextAreaElement>(
    '#contact-form textarea[name="mensaje"]'
  );
  const muestrasRadioSi = document.querySelector<HTMLInputElement>(
    '#contact-form input[name="muestras"][value="si"]'
  );

  if (picker && checkboxes && counter) {
    const COLOR_LINE_PREFIX = "Colores solicitados:";

    function getSelectedColors(): string[] {
      return Array.from(checkboxes!)
        .filter((cb) => cb.checked)
        .map((cb) => cb.value);
    }

    function updateMessageTextarea() {
      if (!messageField) return;
      const selected = getSelectedColors();
      const current = messageField.value;
      const cleaned = current
        .split("\n")
        .filter((line) => !line.startsWith(COLOR_LINE_PREFIX))
        .join("\n")
        .trim();

      if (selected.length === 0) {
        messageField.value = cleaned;
        return;
      }

      const colorLine = `${COLOR_LINE_PREFIX} ${selected.join(", ")}`;
      messageField.value = cleaned ? `${cleaned}\n\n${colorLine}` : colorLine;
    }

    function syncMuestrasRadio() {
      if (!muestrasRadioSi) return;
      if (getSelectedColors().length > 0 && !muestrasRadioSi.checked) {
        muestrasRadioSi.checked = true;
      }
    }

    function update() {
      const selected = getSelectedColors();
      counter!.textContent = String(selected.length);
      counter!.parentElement?.classList.toggle(
        "samples-picker__counter--full",
        selected.length >= MAX_SAMPLES
      );
      checkboxes!.forEach((cb) => {
        const isOver = !cb.checked && selected.length >= MAX_SAMPLES;
        cb.disabled = isOver;
        cb.closest("[data-sample-label]")?.classList.toggle("sample-swatch--disabled", isOver);
        cb.closest("[data-sample-label]")?.classList.toggle("sample-swatch--checked", cb.checked);
      });
      updateMessageTextarea();
      syncMuestrasRadio();
    }

    checkboxes.forEach((cb) => cb.addEventListener("change", update));
    update();
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    line-height: 1.8;
  }

  .contact-list li {
    margin-bottom: 1.25rem;
  }

  .contact-list a {
    color: var(--color-terracota);
  }

  .samples-picker {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-white);
    border-left: 3px solid var(--color-terracota);
    border-radius: var(--radius-md);
  }

  .samples-picker__header h3 {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .samples-picker__header p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
    line-height: 1.5;
  }

  .samples-grid {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.6rem;
  }

  .sample-swatch {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid rgba(71, 36, 16, 0.12);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      background 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .sample-swatch:hover {
    border-color: rgba(124, 72, 44, 0.4);
    background: var(--color-white);
  }

  .sample-swatch input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .sample-swatch__chip {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1px rgba(71, 36, 16, 0.18);
  }

  .sample-swatch__info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .sample-swatch__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-chocolate);
    line-height: 1.2;
  }

  .sample-swatch__desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sample-swatch__check {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-terracota);
    color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .sample-swatch__check svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .sample-swatch--checked {
    border-color: var(--color-terracota);
    background: rgba(124, 72, 44, 0.06);
  }

  .sample-swatch--checked .sample-swatch__check {
    opacity: 1;
    transform: scale(1);
  }

  .sample-swatch--disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .samples-picker__counter {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .samples-picker__counter--full {
    color: var(--color-terracota);
  }

  .samples-picker__counter span {
    font-weight: 700;
    color: var(--color-chocolate);
  }

  .contact-map {
    margin-top: 2.5rem;
  }

  .contact-map h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .contact-map__frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(71, 36, 16, 0.1);
    background: var(--color-white);
  }

  .contact-map__frame iframe {
    display: block;
    width: 100%;
    min-height: 400px;
    height: 400px;
    border: 0;
  }

  .contact-map__link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .contact-map__link:hover {
    color: var(--color-coral);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .contact-map__frame iframe {
      min-height: 280px;
      height: 280px;
    }
  }
</style>
