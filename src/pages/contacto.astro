---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { site } from "@/data/site";
import { products } from "@/data/products";
import { catalogCategories, parseCategoryParam } from "@/data/catalogCategories";

const referencia = Astro.url.searchParams.get("referencia");
const productoQuery = Astro.url.searchParams.get("producto");
const categoriaQuery = Astro.url.searchParams.get("categoria");

const fromProduct = referencia
  ? products.find((p) => p.slug === referencia)
  : productoQuery
    ? products.find((p) => p.name === productoQuery || p.slug === productoQuery)
    : undefined;

const preselectedCategory = parseCategoryParam(categoriaQuery);

const defaultMessage = fromProduct ? `Me interesa cotizar ${fromProduct.name}.` : "";

const productsByCategory = catalogCategories.map((cat) => ({
  label: cat.label,
  products: products.filter((p) => p.category === cat.id),
}));

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const formspreeReady =
  Boolean(formspreeId) && formspreeId !== "your_form_id" && !formspreeId.startsWith("your_");
const formAction = formspreeReady ? `https://formspree.io/f/${formspreeId}` : undefined;

const thankYouUrl = new URL("/contacto/gracias/", site.url).href;
const thankYouPath = "/contacto/gracias/";
---

<BaseLayout
  title="Contacto y cotización"
  description="Solicite cotización, muestras físicas o asesoría técnica. Taller en Amagá, Antioquia."
  hideQuoteCart
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contacto comercial</p>
      <h1>Hablemos de su proyecto</h1>
      <p class="text-muted page-hero__lead">
        Cuéntenos qué necesita. Respondemos con cotización, fichas técnicas o una caja de muestras en su
        estudio.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Datos de contacto</h2>
        <ul class="contact-list">
          <li>
            <strong>Dirección</strong><br />{site.address}
          </li>
          <li>
            <strong>Teléfono</strong><br />
            <a href={site.phoneHref}>{site.phone}</a>
          </li>
          <li>
            <strong>Email</strong><br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <strong>Horario</strong><br />{site.hours}
          </li>
        </ul>
        <a
          href={site.whatsapp}
          class="btn btn--primary"
          target="_blank"
          rel="noopener"
          data-track="whatsapp_click"
          data-track-location="contacto"
        >
          WhatsApp
        </a>

        <div class="samples-box">
          <h3>Muestras físicas</h3>
          <p>Seleccione hasta 5 tonalidades en el mensaje y las enviamos a su oficina.</p>
        </div>

        <div class="contact-map">
          <h3>Visítenos en Amagá</h3>
          <div class="contact-map__frame">
            <iframe
              src={site.mapsEmbedUrl}
              title="Ubicación Clay House en Amagá, Antioquia"
              width="100%"
              height="400"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
          <a
            href={site.mapsDirectionsUrl}
            class="contact-map__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            cómo llegar en Google Maps →
          </a>
        </div>
      </div>

      <ContactForm
        formAction={formAction}
        thankYouUrl={thankYouUrl}
        referencia={referencia}
        fromProduct={fromProduct}
        preselectedCategory={preselectedCategory}
        productsByCategory={productsByCategory}
        defaultMessage={defaultMessage}
      />
    </div>
  </section>
</BaseLayout>

<script
  define:vars={{
    whatsappUrl: site.whatsapp,
    thankYouPath,
    useFormspree: Boolean(formAction),
  }}
>
  const form = document.getElementById("contact-form");
  if (!form || useFormspree) return;

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const lines = [
      "Hola Clay House, solicito información:",
      "",
      `Nombre: ${fd.get("nombre")}`,
      fd.get("empresa") ? `Empresa: ${fd.get("empresa")}` : "",
      `Rol: ${fd.get("rol")}`,
      `Email: ${fd.get("email")}`,
      `Teléfono: ${fd.get("telefono")}`,
      `Ciudad: ${fd.get("ciudad")}`,
      fd.get("tipo_proyecto") ? `Proyecto: ${fd.get("tipo_proyecto")}` : "",
      (() => {
        const picked = fd.getAll("productos_interes");
        if (picked.length) return `Productos: ${picked.join(", ")}`;
        return "";
      })(),
      fd.get("muestras") ? `Muestras físicas: ${fd.get("muestras")}` : "",
      fd.get("referencia") ? `Referencia web: ${fd.get("referencia")}` : "",
      "",
      String(fd.get("mensaje") || ""),
    ].filter(Boolean);

    window.open(`${whatsappUrl}?text=${encodeURIComponent(lines.join("\n"))}`, "_blank");
    window.location.href = thankYouPath;
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    line-height: 1.8;
  }

  .contact-list li {
    margin-bottom: 1.25rem;
  }

  .contact-list a {
    color: var(--color-terracota);
  }

  .samples-box {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-white);
    border-left: 3px solid var(--color-terracota);
  }

  .samples-box h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .samples-box p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .contact-map {
    margin-top: 2.5rem;
  }

  .contact-map h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .contact-map__frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(71, 36, 16, 0.1);
    background: var(--color-white);
  }

  .contact-map__frame iframe {
    display: block;
    width: 100%;
    min-height: 400px;
    height: 400px;
    border: 0;
  }

  .contact-map__link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .contact-map__link:hover {
    color: var(--color-coral);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .contact-map__frame iframe {
      min-height: 280px;
      height: 280px;
    }
  }
</style>
