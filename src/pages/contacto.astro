---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { products } from "@/data/products";
import { catalogCategories, parseCategoryParam } from "@/data/catalogCategories";

const referencia = Astro.url.searchParams.get("referencia");
const productoQuery = Astro.url.searchParams.get("producto");
const categoriaQuery = Astro.url.searchParams.get("categoria");

const fromProduct = referencia
  ? products.find((p) => p.slug === referencia)
  : productoQuery
    ? products.find((p) => p.name === productoQuery || p.slug === productoQuery)
    : undefined;

const preselectedCategory = parseCategoryParam(categoriaQuery);

const defaultMessage = fromProduct ? `Me interesa cotizar ${fromProduct.name}.` : "";

const productsByCategory = catalogCategories.map((cat) => ({
  label: cat.label,
  products: products.filter((p) => p.category === cat.id),
}));

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const formspreeReady =
  Boolean(formspreeId) && formspreeId !== "your_form_id" && !formspreeId.startsWith("your_");
const formAction = formspreeReady ? `https://formspree.io/f/${formspreeId}` : undefined;

const thankYouUrl = new URL("/contacto/gracias/", site.url).href;
const thankYouPath = "/contacto/gracias/";
---

<BaseLayout
  title="Contacto"
  description="Solicite cotización, muestras físicas o asesoría técnica. Taller en Amagá, Antioquia."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contacto comercial</p>
      <h1>Hablemos de su proyecto</h1>
      <p class="text-muted page-hero__lead">
        Cuéntenos qué necesita. Respondemos con cotización, fichas técnicas o una
        caja de muestras en su estudio.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Datos de contacto</h2>
        <ul class="contact-list">
          <li>
            <strong>Dirección</strong><br />{site.address}
          </li>
          <li>
            <strong>Teléfono</strong><br />
            <a href={site.phoneHref}>{site.phone}</a>
          </li>
          <li>
            <strong>Email</strong><br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <strong>Horario</strong><br />{site.hours}
          </li>
        </ul>
        <a href={site.whatsapp} class="btn btn--primary" target="_blank" rel="noopener">
          WhatsApp
        </a>

        <div class="samples-box">
          <h3>Muestras físicas</h3>
          <p>
            Seleccione hasta 5 tonalidades en el mensaje y las enviamos a su
            oficina.
          </p>
        </div>

        <div class="contact-map">
          <h3>Visítenos en Amagá</h3>
          <div class="contact-map__frame">
            <iframe
              src={site.mapsEmbedUrl}
              title="Ubicación Clay House en Amagá, Antioquia"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen></iframe>
          </div>
          <a
            href={site.mapsDirectionsUrl}
            class="contact-map__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            cómo llegar en Google Maps →
          </a>
        </div>
      </div>

      <div class="contact-form-wrap">
        {!formAction && (
          <p class="form-hint">El envío abrirá WhatsApp con su mensaje listo para enviar.</p>
        )}
        <div class="cart-summary" id="quote-cart-summary" hidden>
          <p class="cart-summary__title">Su cotización incluye:</p>
          <ul class="cart-summary__list" data-cart-summary-list></ul>
          <button type="button" class="cart-summary__edit" data-quote-cart-open>
            editar productos
          </button>
        </div>
        <form
          class="contact-form"
          id="contact-form"
          method={formAction ? "POST" : "get"}
          action={formAction}
        >
          {formAction && (
            <>
              <input type="hidden" name="_subject" value="Nueva solicitud — Clay House" />
              <input type="hidden" name="_next" value={thankYouUrl} />
            </>
          )}
          {referencia && <input type="hidden" name="referencia" value={referencia} />}
              {fromProduct && (
                <p class="form-prefill" role="status">
                  Solicitud para <strong>{fromProduct.name}</strong>. Puede ajustar el mensaje antes de
                  enviar.
                </p>
              )}
              <label>
                Nombre completo *
                <input type="text" name="nombre" required />
              </label>
              <label>
                Empresa / Estudio
                <input type="text" name="empresa" />
              </label>
              <label>
                Rol *
                <select name="rol" required>
                  <option value="">Seleccione…</option>
                  <option>Arquitecto</option>
                  <option>Constructor</option>
                  <option>Diseñador de interiores</option>
                  <option>Desarrollador</option>
                  <option>Otro</option>
                </select>
              </label>
              <label>
                Email *
                <input type="email" name="email" required />
              </label>
              <label>
                Teléfono *
                <input type="tel" name="telefono" required />
              </label>
              <label>
                Ciudad / País *
                <input type="text" name="ciudad" required />
              </label>
              <label>
                Tipo de proyecto
                <select name="tipo_proyecto">
                  <option value="">Seleccione…</option>
                  <option>Residencial</option>
                  <option>Comercial</option>
                  <option>Restauración patrimonial</option>
                  <option>Multifamiliar</option>
                  <option>Otro</option>
                </select>
              </label>
              <fieldset class="product-picker">
                <legend>Productos de interés</legend>
                <p class="product-picker__hint">Seleccione uno o varios. La cantidad la indica en cada ficha de producto.</p>
                {
                  productsByCategory.map((group) => (
                    <div class="product-picker__group">
                      <p class="product-picker__cat">{group.label}</p>
                      <div class="product-picker__options">
                        {
                          group.products.map((p) => (
                            <label class="checkbox">
                              <input
                                type="checkbox"
                                name="productos_interes"
                                value={p.name}
                                data-slug={p.slug}
                                checked={
                                  fromProduct?.slug === p.slug ||
                                  preselectedCategory === p.category ||
                                  undefined
                                }
                              />
                              <span>{p.name}</span>
                            </label>
                          ))
                        }
                      </div>
                    </div>
                  ))
                }
              </fieldset>
              <fieldset class="radio-group">
                <legend>¿Necesita muestras físicas?</legend>
                <div class="radio-group__options">
                  <label class="radio">
                    <input type="radio" name="muestras" value="si" />
                    <span>Sí</span>
                  </label>
                  <label class="radio">
                    <input type="radio" name="muestras" value="no" />
                    <span>No</span>
                  </label>
                </div>
              </fieldset>
              <label>
                Mensaje *
                <textarea name="mensaje" rows="5" required>
                  {defaultMessage}
                </textarea>
              </label>
          <button type="submit" class="btn btn--primary">
            {formAction ? "enviar solicitud" : "enviar por WhatsApp"}
          </button>
          <p class="form-legal">
            Al enviar acepta el tratamiento de sus datos para fines comerciales.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    QUOTE_CART_EVENT,
    buildQuoteMessage,
    formatCartLine,
    getQuoteCart,
  } from "@/utils/quoteCart";

  function applyCartToContactForm() {
    const items = getQuoteCart();
    const form = document.getElementById("contact-form");
    const summary = document.getElementById("quote-cart-summary");
    const list = document.querySelector("[data-cart-summary-list]");
    const textarea = form?.querySelector<HTMLTextAreaElement>('[name="mensaje"]');

    if (!form) return;

    if (summary && list) {
      if (items.length) {
        summary.hidden = false;
        list.replaceChildren(
          ...items.map((item) => {
            const li = document.createElement("li");
            li.textContent = formatCartLine(item).replace(/^•\s*/, "");
            return li;
          })
        );
      } else {
        summary.hidden = true;
        list.replaceChildren();
      }
    }

    const slugsInCart = new Set(items.map((i) => i.slug));
    form.querySelectorAll<HTMLInputElement>('input[name="productos_interes"]').forEach((cb) => {
      if (cb.dataset.slug && slugsInCart.has(cb.dataset.slug)) cb.checked = true;
    });

    if (items.length && textarea) {
      const cartMsg = buildQuoteMessage(items);
      const current = textarea.value.trim();
      if (!current || current.startsWith("Solicito cotización de:")) {
        textarea.value = cartMsg;
      } else if (!current.includes(cartMsg.split("\n")[0])) {
        textarea.value = `${cartMsg}\n\n${current}`;
      }
    }
  }

  applyCartToContactForm();
  document.addEventListener(QUOTE_CART_EVENT, applyCartToContactForm);
</script>

<script
  define:vars={{
    whatsappUrl: site.whatsapp,
    thankYouPath,
    useFormspree: Boolean(formAction),
  }}
>
  const form = document.getElementById("contact-form");
  if (!form || useFormspree) return;

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const lines = [
      "Hola Clay House, solicito información:",
      "",
      `Nombre: ${fd.get("nombre")}`,
      fd.get("empresa") ? `Empresa: ${fd.get("empresa")}` : "",
      `Rol: ${fd.get("rol")}`,
      `Email: ${fd.get("email")}`,
      `Teléfono: ${fd.get("telefono")}`,
      `Ciudad: ${fd.get("ciudad")}`,
      fd.get("tipo_proyecto") ? `Proyecto: ${fd.get("tipo_proyecto")}` : "",
      (() => {
        const picked = fd.getAll("productos_interes");
        if (picked.length) return `Productos: ${picked.join(", ")}`;
        return "";
      })(),
      fd.get("muestras") ? `Muestras físicas: ${fd.get("muestras")}` : "",
      fd.get("referencia") ? `Referencia web: ${fd.get("referencia")}` : "",
      "",
      String(fd.get("mensaje") || ""),
    ].filter(Boolean);

    window.open(`${whatsappUrl}?text=${encodeURIComponent(lines.join("\n"))}`, "_blank");
    window.location.href = thankYouPath;
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    line-height: 1.8;
  }

  .contact-list li {
    margin-bottom: 1.25rem;
  }

  .contact-list a {
    color: var(--color-terracota);
  }

  .samples-box {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-white);
    border-left: 3px solid var(--color-terracota);
  }

  .samples-box h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .samples-box p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .contact-map {
    margin-top: 2.5rem;
  }

  .contact-map h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .contact-map__frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(71, 36, 16, 0.1);
    background: var(--color-white);
  }

  .contact-map__frame iframe {
    display: block;
    width: 100%;
    height: 260px;
    border: 0;
  }

  .contact-map__link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .contact-map__link:hover {
    color: var(--color-coral);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--color-white);
    padding: 2rem;
  }

  .contact-form > label {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 300;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(71, 36, 16, 0.15);
    background: var(--color-bg);
    color: var(--color-chocolate);
  }

  .product-picker,
  .radio-group {
    border: none;
    margin: 0;
    padding: 0;
  }

  .product-picker legend,
  .radio-group legend {
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
    padding: 0;
  }

  .product-picker__hint {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    font-weight: 300;
    color: var(--color-text-muted);
  }

  .product-picker__group {
    margin-bottom: 1.25rem;
  }

  .product-picker__group:last-child {
    margin-bottom: 0;
  }

  .product-picker__cat {
    margin: 0 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .product-picker__options {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.5rem 1rem;
  }

  .checkbox {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 300;
    cursor: pointer;
  }

  .checkbox input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    flex-shrink: 0;
    accent-color: var(--color-terracota);
  }

  .radio-group__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .radio {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 300;
    cursor: pointer;
  }

  .radio input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    flex-shrink: 0;
    accent-color: var(--color-terracota);
  }

  .form-legal {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .form-prefill {
    margin: 0;
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    background: rgba(124, 72, 44, 0.08);
    border-left: 3px solid var(--color-terracota);
    color: var(--color-chocolate);
  }

  .form-hint {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: rgba(124, 72, 44, 0.06);
    border-radius: var(--radius-sm);
  }

  .cart-summary {
    margin-bottom: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-white);
    border-left: 3px solid var(--color-terracota);
  }

  .cart-summary__title {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .cart-summary__list {
    margin: 0 0 1rem;
    padding: 0 0 0 1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-chocolate);
  }

  .cart-summary__edit {
    padding: 0;
    border: none;
    background: none;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-terracota);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .contact-form {
      padding: 1.25rem;
    }

    .product-picker__options {
      grid-template-columns: 1fr;
    }

    .contact-map__frame iframe {
      height: 220px;
    }
  }
</style>
