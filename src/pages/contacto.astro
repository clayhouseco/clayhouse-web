---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const formAction = formspreeId
  ? `https://formspree.io/f/${formspreeId}`
  : undefined;
---

<BaseLayout
  title="Contacto"
  description="Solicite cotización, muestras físicas o asesoría técnica. Taller en Amagá, Antioquia."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contacto comercial</p>
      <h1>Hablemos de su proyecto</h1>
      <p class="text-muted page-hero__lead">
        Cuéntenos qué necesita. Respondemos con cotización, fichas técnicas o una
        caja de muestras en su estudio.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Datos de contacto</h2>
        <ul class="contact-list">
          <li>
            <strong>Dirección</strong><br />{site.address}
          </li>
          <li>
            <strong>Teléfono</strong><br />
            <a href={site.phoneHref}>{site.phone}</a>
          </li>
          <li>
            <strong>Email</strong><br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <strong>Horario</strong><br />{site.hours}
          </li>
        </ul>
        <a href={site.whatsapp} class="btn btn--primary" target="_blank" rel="noopener"
          >WhatsApp</a
        >

        <div class="samples-box">
          <h3>Muestras físicas</h3>
          <p>
            Seleccione hasta 5 tonalidades en el mensaje y las enviamos a su
            oficina.
          </p>
        </div>
      </div>

      <div class="contact-form-wrap">
        {
          formAction ? (
            <form class="contact-form" method="POST" action={formAction}>
              <input type="hidden" name="_subject" value="Nueva solicitud — Clay House" />
              <label>
                Nombre completo *
                <input type="text" name="nombre" required />
              </label>
              <label>
                Empresa / Estudio
                <input type="text" name="empresa" />
              </label>
              <label>
                Rol *
                <select name="rol" required>
                  <option value="">Seleccione…</option>
                  <option>Arquitecto</option>
                  <option>Constructor</option>
                  <option>Diseñador de interiores</option>
                  <option>Desarrollador</option>
                  <option>Otro</option>
                </select>
              </label>
              <label>
                Email *
                <input type="email" name="email" required />
              </label>
              <label>
                Teléfono *
                <input type="tel" name="telefono" required />
              </label>
              <label>
                Ciudad / País *
                <input type="text" name="ciudad" required />
              </label>
              <label>
                Tipo de proyecto
                <select name="tipo_proyecto">
                  <option value="">Seleccione…</option>
                  <option>Residencial</option>
                  <option>Comercial</option>
                  <option>Restauración patrimonial</option>
                  <option>Multifamiliar</option>
                  <option>Otro</option>
                </select>
              </label>
              <label>
                Producto de interés
                <select name="producto">
                  <option value="">Seleccione…</option>
                  <option>F-PV</option>
                  <option>Macizo</option>
                  <option>Especiales</option>
                  <option>Pisos</option>
                  <option>No sé aún</option>
                </select>
              </label>
              <fieldset class="radio-group">
                <legend>¿Necesita muestras físicas?</legend>
                <label class="radio">
                  <input type="radio" name="muestras" value="si" /> Sí
                </label>
                <label class="radio">
                  <input type="radio" name="muestras" value="no" /> No
                </label>
              </fieldset>
              <label>
                Metros cuadrados o cantidad estimada
                <input type="text" name="cantidad" />
              </label>
              <label>
                Mensaje *
                <textarea name="mensaje" rows="5" required />
              </label>
              <button type="submit" class="btn btn--primary">enviar solicitud</button>
              <p class="form-legal">
                Al enviar acepta el tratamiento de sus datos para fines comerciales.
              </p>
            </form>
          ) : (
            <div class="form-fallback">
              <p>
                Configure <code>PUBLIC_FORMSPREE_ID</code> en un archivo
                <code>.env</code> (ver <code>.env.example</code>) para activar el
                formulario.
              </p>
              <p>
                Mientras tanto, escríbanos a{" "}
                <a href={`mailto:${site.email}`}>{site.email}</a> o por{" "}
                <a href={site.whatsapp}>WhatsApp</a>.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 8rem 0 3rem;
    background: var(--color-white);
  }

  .page-hero__lead {
    max-width: 36rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    line-height: 1.8;
  }

  .contact-list li {
    margin-bottom: 1.25rem;
  }

  .contact-list a {
    color: var(--color-terracota);
  }

  .samples-box {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-white);
    border-left: 3px solid var(--color-terracota);
  }

  .samples-box h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .samples-box p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--color-white);
    padding: 2rem;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 300;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(71, 36, 16, 0.15);
    background: var(--color-bg);
    color: var(--color-chocolate);
  }

  .radio-group {
    border: none;
    margin: 0;
    padding: 0;
  }

  .radio-group legend {
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .radio {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: 1rem;
    font-weight: 300;
  }

  .form-legal {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .form-fallback {
    padding: 2rem;
    background: var(--color-white);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
