---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import { site } from "@/data/site";
import { products, sortProductsByPriority } from "@/data/products";
import { catalogCategories, parseCategoryParam } from "@/data/catalogCategories";
import { Image } from "astro:assets";
import heroImg from "@/assets/images/hero/Plaza de Envigado.jpg";

const referencia = Astro.url.searchParams.get("referencia");
const productoQuery = Astro.url.searchParams.get("producto");
const categoriaQuery = Astro.url.searchParams.get("categoria");
const areaQuery = Astro.url.searchParams.get("area");
const unidadesQuery = Astro.url.searchParams.get("unidades");

const fromProduct = referencia
  ? products.find((p) => p.slug === referencia)
  : productoQuery
    ? products.find((p) => p.name === productoQuery || p.slug === productoQuery)
    : undefined;

const preselectedCategory = parseCategoryParam(categoriaQuery);

function buildDefaultMessage() {
  if (!fromProduct) return "";
  const area = areaQuery ? parseFloat(areaQuery) : null;
  const unidades = unidadesQuery ? parseInt(unidadesQuery, 10) : null;
  if (area && unidades && area > 0 && unidades > 0) {
    return `Me interesa cotizar ${fromProduct.name}. Estimación de la calculadora: ${area} m² (~${unidades.toLocaleString("es-CO")} unidades, incluye 5% de desperdicio). Confírmenme disponibilidad y precio por volumen.`;
  }
  if (area && area > 0) {
    return `Me interesa cotizar ${fromProduct.name}. Necesito cubrir ${area} m² aproximadamente. Confírmenme disponibilidad y precio por volumen.`;
  }
  return `Me interesa cotizar ${fromProduct.name}.`;
}

const defaultMessage = buildDefaultMessage();

const productsByCategory = catalogCategories.map((cat) => ({
  label: cat.label,
  products: sortProductsByPriority(products.filter((p) => p.category === cat.id && !p.hidden)),
}));

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const formspreeReady =
  Boolean(formspreeId) && formspreeId !== "your_form_id" && !formspreeId.startsWith("your_");
const formAction = formspreeReady ? `https://formspree.io/f/${formspreeId}` : undefined;

const thankYouUrl = new URL("/contacto/gracias/", site.url).href;
const thankYouPath = "/contacto/gracias/";
---

<BaseLayout
  title="Contacto y cotización"
  description="Cotización y asesoría técnica para arquitectos y constructores. Taller de ladrillo en Amagá, Antioquia. Respuesta en menos de 24 horas."
  hideQuoteCart
>
  <section class="page-hero page-hero--image">
    <div class="page-hero__media">
      <Image
        src={heroImg}
        alt="Plaza de Mercado de Envigado en ladrillo Romano — Clay House"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        width={1920}
        height={1280}
      />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content">
      <h1>contacto</h1>
      <p class="page-hero__lead">
        Aquí estamos para responder tus dudas.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Datos de contacto</h2>
        <ul class="contact-cards" role="list">
          <li class="contact-card contact-card--full">
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 22s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            </span>
            <div>
              <p class="contact-card__label">Dirección</p>
              <p class="contact-card__value">{site.address}</p>
              <div class="contact-card__actions">
                <a
                  href={site.mapsDirectionsUrl}
                  target="_blank"
                  rel="noopener"
                  class="contact-card__action"
                >
                  Google Maps
                </a>
                <a
                  href={site.wazeUrl}
                  target="_blank"
                  rel="noopener"
                  class="contact-card__action"
                >
                  Waze
                </a>
                <button
                  type="button"
                  class="contact-card__action contact-card__action--copy"
                  data-copy-address
                  data-address={site.address}
                  aria-label="Copiar dirección"
                >
                  Copiar
                </button>
              </div>
            </div>
          </li>
          <li class="contact-card">
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.86 19.86 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.86 19.86 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 16.92z" />
              </svg>
            </span>
            <div>
              <p class="contact-card__label">Teléfono</p>
              <p class="contact-card__value">
                <a href={site.phoneHref}>{site.phone}</a>
              </p>
            </div>
          </li>
          <li class="contact-card">
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z" />
                <path d="M2 7l10 6 10-6" />
              </svg>
            </span>
            <div>
              <p class="contact-card__label">Email</p>
              <p class="contact-card__value">
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </p>
            </div>
          </li>
          <li class="contact-card">
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
              </svg>
            </span>
            <div>
              <p class="contact-card__label">Horario</p>
              <p class="contact-card__value contact-card__value--small">{site.hours}</p>
            </div>
          </li>
        </ul>
        <a
          href={site.whatsapp}
          class="btn btn--primary contact-info__whatsapp"
          target="_blank"
          rel="noopener"
          data-track="whatsapp_click"
          data-track-location="contacto"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
          </svg>
          Escribir por WhatsApp
        </a>

        <div class="contact-map">
          <h3>Visítenos en Amagá</h3>
          <div class="contact-map__frame">
            <iframe
              src={site.mapsEmbedUrl}
              title="Ubicación Clay House en Amagá, Antioquia"
              width="100%"
              height="400"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
          <a
            href={site.mapsDirectionsUrl}
            class="contact-map__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            cómo llegar en Google Maps →
          </a>
        </div>
      </div>

      <ContactForm
        formAction={formAction}
        thankYouUrl={thankYouUrl}
        referencia={referencia}
        fromProduct={fromProduct}
        preselectedCategory={preselectedCategory}
        productsByCategory={productsByCategory}
        defaultMessage={defaultMessage}
      />
    </div>
  </section>
</BaseLayout>

<script
  define:vars={{
    whatsappUrl: site.whatsapp,
    thankYouPath,
    useFormspree: Boolean(formAction),
  }}
>
  const form = document.getElementById("contact-form");
  if (!form || useFormspree) return;

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const lines = [
      "Hola Clay House, solicito información:",
      "",
      `Nombre: ${fd.get("nombre")}`,
      fd.get("empresa") ? `Empresa: ${fd.get("empresa")}` : "",
      `Rol: ${fd.get("rol")}`,
      `Email: ${fd.get("email")}`,
      `Teléfono: ${fd.get("telefono")}`,
      `Ciudad: ${fd.get("ciudad")}`,
      fd.get("tipo_proyecto") ? `Proyecto: ${fd.get("tipo_proyecto")}` : "",
      (() => {
        const picked = fd.getAll("productos_interes");
        if (picked.length) return `Productos: ${picked.join(", ")}`;
        return "";
      })(),
      fd.get("muestras") ? `Muestras físicas: ${fd.get("muestras")}` : "",
      fd.get("referencia") ? `Referencia web: ${fd.get("referencia")}` : "",
      "",
      String(fd.get("mensaje") || ""),
    ].filter(Boolean);

    window.open(`${whatsappUrl}?text=${encodeURIComponent(lines.join("\n"))}`, "_blank");
    window.location.href = thankYouPath;
  });
</script>

<script>
  // Copiar dirección al portapapeles con feedback visual
  document.querySelectorAll<HTMLButtonElement>("[data-copy-address]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const address = btn.dataset.address ?? "";
      if (!address) return;
      try {
        await navigator.clipboard.writeText(address);
        const original = btn.textContent;
        btn.textContent = "¡Copiado!";
        btn.classList.add("contact-card__action--copied");
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove("contact-card__action--copied");
        }, 1600);
      } catch {
        btn.textContent = "Error";
        setTimeout(() => {
          btn.textContent = "Copiar";
        }, 1600);
      }
    });
  });
</script>

<style>
  .page-hero--image {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-top: -5.25rem;
    padding-top: 5.25rem;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.4) 70%),
      linear-gradient(to top, var(--color-bg) 0%, transparent 18%);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 6rem;
  }

  .page-hero--image h1 {
    color: #ffffff;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
    margin: 0;
  }

  .page-hero--image .page-hero__lead {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .page-hero--image {
      min-height: 60vh;
    }

    .page-hero--image h1 {
      font-size: clamp(2.25rem, 9vw, 3.5rem);
    }
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-cards {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .contact-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    background: var(--color-white);
    border: 1px solid rgba(71, 36, 16, 0.08);
    border-radius: var(--radius-md);
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .contact-card > div {
    min-width: 0;
    flex: 1;
  }

  .contact-card:hover {
    border-color: rgba(124, 72, 44, 0.25);
    transform: translateY(-2px);
  }

  .contact-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgba(181, 106, 74, 0.12);
    color: var(--color-terracota);
  }

  .contact-card__icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .contact-card__label {
    margin: 0 0 0.15rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .contact-card__value {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-chocolate);
    overflow-wrap: anywhere;
  }

  .contact-card__value--small {
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .contact-card a {
    color: var(--color-terracota);
  }

  .contact-card a:hover {
    color: var(--color-coral);
  }

  /* La tarjeta de dirección ocupa las 2 columnas y aloja los botones */
  .contact-card--full {
    grid-column: 1 / -1;
  }

  .contact-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.65rem;
  }

  .contact-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-terracota);
    background: var(--color-bg);
    border: 1px solid rgba(124, 72, 44, 0.25);
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .contact-card__action:hover {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-bg);
  }

  .contact-card__action--copied {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-bg);
  }

  .contact-info__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 560px) {
    .contact-cards {
      grid-template-columns: 1fr;
    }
  }

  .contact-map {
    margin-top: 2.5rem;
  }

  .contact-map h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .contact-map__frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(71, 36, 16, 0.1);
    background: var(--color-white);
  }

  .contact-map__frame iframe {
    display: block;
    width: 100%;
    min-height: 400px;
    height: 400px;
    border: 0;
  }

  .contact-map__link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .contact-map__link:hover {
    color: var(--color-coral);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .contact-map__frame iframe {
      min-height: 280px;
      height: 280px;
    }
  }
</style>
