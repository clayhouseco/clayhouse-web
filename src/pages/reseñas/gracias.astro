---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Gracias por su reseña"
  description="Hemos recibido su reseña. Clay House la revisará antes de publicarla."
>
  <section class="page-hero page-hero--center">
    <div class="container">
      <p class="eyebrow">Reseñas</p>
      <h1>Gracias por compartir</h1>
      <p class="text-muted page-hero__lead">
        Recibimos su reseña. La revisaremos y, si todo está en orden, la publicaremos en unos días.
      </p>
      <p style="margin-top: 2rem">
        <a href="/reseñas/" class="btn btn--primary">Volver a reseñas</a>
        <a href="/" class="btn btn--ghost" style="margin-left: 0.75rem">Inicio</a>
      </p>
    </div>
  </section>
</BaseLayout>
