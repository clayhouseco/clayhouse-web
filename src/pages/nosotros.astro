---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutSectionIcon from "@/components/about/AboutSectionIcon.astro";
import {
  aboutHero,
  aboutHeroImage,
  aboutStory,
  aboutManifesto,
  aboutMission,
  aboutVision,
  aboutExtras,
} from "@/data/nosotros";
import { Image } from "astro:assets";
import heroImg from "@/assets/images/hero/dos-santos.jpg";
import "@/styles/nosotros-page.css";
---

<BaseLayout
  title="Nosotros"
  description="Desde 1965 fabricando ladrillo en Amagá. De Ladrillera San Fernando a Clay House: tradición alfarera con innovación y cumplimiento NTC 4205."
>
  <div class="nosotros-page">
    <section class="page-hero page-hero--image">
      <div class="page-hero__media">
        <Image
          src={heroImg}
          alt="Dos Santos Cantina con enchape Clay House"
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          formats={["avif", "webp"]}
          loading="eager"
          fetchpriority="high"
          width={1920}
          height={1280}
        />
        <div class="page-hero__overlay"></div>
      </div>
      <div class="container page-hero__content">
        <h1>nosotros</h1>
        <p class="page-hero__lead">
          Más de cinco décadas transformando arcilla. Conócenos
        </p>
      </div>
    </section>

    <section class="section section--cards" id="historia">
      <div class="container">
        <article class="about-card about-card--wide">
          <p class="about-card__eyebrow">{aboutStory.eyebrow}</p>
          <div class="about-card__head">
            <AboutSectionIcon icon="history" />
            <h2 class="about-card__title">{aboutStory.title}</h2>
          </div>
          <ol class="about-timeline">
            {
              aboutStory.milestones.map((item) => (
                <li class="about-timeline__item">
                  <span class="about-timeline__year">{item.year}</span>
                  <p>{item.text}</p>
                </li>
              ))
            }
          </ol>
          <p class="about-story__closing">{aboutStory.closing}</p>
        </article>

        <article class="about-card about-card--wide about-card--manifesto" id="manifiesto">
          <p class="about-card__eyebrow">{aboutManifesto.eyebrow}</p>
          <div class="about-card__head">
            <AboutSectionIcon icon="manifesto" />
            <h2 class="about-card__title">{aboutManifesto.title}</h2>
          </div>
          <div class="about-card__body">
            {aboutManifesto.paragraphs.map((text) => <p>{text}</p>)}
          </div>
          <div class="about-manifesto__pillars">
            <p class="about-manifesto__intro">Este es nuestro manifiesto:</p>
            <ul>
              {aboutManifesto.pillars.map((line) => <li>{line}</li>)}
            </ul>
          </div>
        </article>

        <div class="about-grid about-grid--mv">
          <article class="about-card about-card--mv" id="mision">
            <p class="about-card__eyebrow">{aboutMission.eyebrow}</p>
            <div class="about-card__head">
              <AboutSectionIcon icon="mission" />
              <h2 class="about-card__title">{aboutMission.title}</h2>
            </div>
            <p class="about-card__single">{aboutMission.text}</p>
          </article>
          <article class="about-card about-card--mv" id="vision">
            <p class="about-card__eyebrow">{aboutVision.eyebrow}</p>
            <div class="about-card__head">
              <AboutSectionIcon icon="vision" />
              <h2 class="about-card__title">{aboutVision.title}</h2>
            </div>
            <p class="about-card__single">{aboutVision.text}</p>
          </article>
        </div>

        <div class="about-grid about-grid--extras">
          {
            aboutExtras.map((section) => (
              <article class="about-card" id={section.id}>
                <p class="about-card__eyebrow">{section.eyebrow}</p>
                <div class="about-card__head">
                  <AboutSectionIcon icon={section.icon} />
                  <h2 class="about-card__title">{section.title}</h2>
                </div>
                <div class="about-card__body">
                  {section.paragraphs.map((text) => (
                    <p>{text}</p>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section--dark" id="aplicaciones">
      <div class="container narrow">
        <p class="eyebrow eyebrow--light">Especificación</p>
        <h2>Dónde usar nuestros productos</h2>
        <ul class="feature-list">
          <li>Fachadas residenciales y comerciales a la vista</li>
          <li>Muros estructurales y divisorios</li>
          <li>Interiores con enchape y pisos de ladrillo</li>
          <li>Cubiertas y pérgolas con teja plana</li>
          <li>Piezas a medida según plano de arquitecto</li>
        </ul>
        <p>
          <a href="/productos" class="link-arrow link-arrow--light"
            >Ver catálogo completo →</a
          >
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container quote-block">
        <blockquote>{aboutManifesto.pillars[0]}</blockquote>
        <p>{aboutManifesto.pillars[2]}</p>
        <a href="/contacto" class="btn btn--primary">Trabajemos juntos</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .narrow {
    max-width: 42rem;
  }
</style>
