---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import { getCollection } from "astro:content";
import { blogFilters } from "@/data/blog";
import "@/styles/blog-page.css";

const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = allPosts[0] ?? null;
const restPosts = allPosts.slice(1);

const postCountByType = allPosts.reduce(
  (acc, post) => {
    acc[post.data.type] = (acc[post.data.type] ?? 0) + 1;
    return acc;
  },
  {} as Record<string, number>
);

const visibleBlogFilters = blogFilters.filter(
  (f) => f.id === "all" || (postCountByType[f.id] ?? 0) > 0
);
---

<BaseLayout
  title="Blog"
  description="Proyectos de obra, artículos técnicos y videos sobre barro cocido. Aprenda sobre fachadas, ladrillo artesanal y especificación con Clay House."
>
  <section class="page-hero blog-hero">
    <div class="container">
      <p class="eyebrow">Historias</p>
      <h1>El oficio del barro,<br />en contexto</h1>
      <p class="text-muted page-hero__lead">
        Obras, materiales, técnica y reflexiones sobre el barro cocido. Lo que no cabe en una
        ficha de producto vive aquí.
      </p>
    </div>
  </section>

  <section class="section blog-section">
    <div class="container">
      <div class="blog-filters" role="tablist" aria-label="Filtrar publicaciones">
        {
          visibleBlogFilters.map((f, i) => (
            <button
              type="button"
              class:list={["blog-filter", i === 0 && "is-active"]}
              data-filter={f.id}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
            >
              {f.label}
            </button>
          ))
        }
      </div>

      {
        featuredPost && (
          <div class="blog-featured-wrap" data-featured-wrap>
            <p class="blog-section__eyebrow">Última publicación</p>
            <BlogCard post={featuredPost} variant="featured" />
          </div>
        )
      }

      {
        restPosts.length > 0 && (
          <div class="blog-rest-wrap">
            <p class="blog-section__eyebrow">Más historias</p>
            <div class="blog-grid" id="blog-grid">
              {restPosts.map((post) => <BlogCard post={post} />)}
            </div>
          </div>
        )
      }

      {
        allPosts.length === 0 && (
          <p class="blog-empty">
            Próximamente publicaremos proyectos y contenido aquí. Mientras tanto, explore el{" "}
            <a href="/productos">catálogo</a>.
          </p>
        )
      }

      <p class="blog-empty blog-empty--filtered" hidden id="blog-empty-filter">
        No hay publicaciones de este tipo todavía.
      </p>
    </div>
  </section>

  <section class="section section--alt blog-cta-section">
    <div class="container blog-cta">
      <p class="eyebrow">Conversemos</p>
      <h2>¿Está especificando barro cocido en obra?</h2>
      <p class="text-muted">
        Cotización, fichas técnicas y asesoría para arquitectos y constructores. Respondemos en
        menos de 24 horas.
      </p>
      <p class="blog-cta__actions">
        <a href="/contacto" class="btn btn--primary">Cotizar mi proyecto</a>
        <a href="/proyectos" class="btn btn--ghost">Ver obras reales</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const featuredWrap = document.querySelector<HTMLElement>("[data-featured-wrap]");
  const grid = document.getElementById("blog-grid");
  const emptyFilter = document.getElementById("blog-empty-filter");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".blog-filter");
  const allCards = [
    ...(featuredWrap?.querySelectorAll<HTMLElement>(".blog-card") ?? []),
    ...(grid?.querySelectorAll<HTMLElement>(".blog-card") ?? []),
  ];

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "all";

      buttons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-selected", active ? "true" : "false");
      });

      let visible = 0;
      allCards.forEach((card) => {
        const show = filter === "all" || card.dataset.type === filter;
        card.hidden = !show;
        if (show) visible += 1;
      });

      // Si el destacado quedó oculto, esconder también su eyebrow
      const featuredVisible = featuredWrap?.querySelector<HTMLElement>(".blog-card:not([hidden])");
      if (featuredWrap) featuredWrap.hidden = !featuredVisible;

      if (emptyFilter) {
        emptyFilter.hidden = visible > 0 || filter === "all";
      }
    });
  });
</script>
