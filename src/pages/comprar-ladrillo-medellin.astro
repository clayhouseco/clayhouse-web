---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCatalogCategoryHref } from "@/data/catalogCategories";
import { buildBreadcrumbJsonLd } from "@/utils/breadcrumbSchema";

const lineas = [
  {
    titulo: "Ladrillo de fachada",
    texto: "Romano, Toscano, Cartagena y macizos para fachadas a la vista con carácter.",
    href: getCatalogCategoryHref("Fachadas"),
  },
  {
    titulo: "Divisorios y rayados",
    texto: "Rayados y bloquelón para muros divisorios y cerramientos con textura.",
    href: getCatalogCategoryHref("Divisorios"),
  },
  {
    titulo: "Enchapes de ladrillo",
    texto: "Revestimientos delgados para vestir muros interiores y fachadas.",
    href: getCatalogCategoryHref("Enchapes"),
  },
  {
    titulo: "Teja de arcilla",
    texto: "Teja plana y colonial para cubiertas visibles en barro cocido.",
    href: getCatalogCategoryHref("Techos"),
  },
];

const cobertura = [
  "Medellín",
  "Envigado",
  "Sabaneta",
  "Itagüí",
  "Bello",
  "La Estrella",
  "Caldas",
  "Rionegro y el Oriente",
  "Suroeste antioqueño",
  "Resto de Antioquia",
];

const pasos = [
  {
    n: "1",
    titulo: "Elige tus productos",
    texto: "Explora el catálogo y arma tu lista con color y cantidad.",
  },
  {
    n: "2",
    titulo: "Cotiza en 24 horas hábiles",
    texto: "Envíanos tu solicitud y te confirmamos precio, flete y condiciones.",
  },
  {
    n: "3",
    titulo: "Recibe en tu obra",
    texto: "Coordinamos la entrega a Medellín, el Valle de Aburrá y toda Antioquia.",
  },
];

const referencias = [
  {
    nombre: "Ladrillo Romano",
    texto: "Formato clásico para fachadas a la vista, vivienda y proyectos institucionales.",
    href: "/productos/romano",
  },
  {
    nombre: "Ladrillo Toscano",
    texto: "Tonos tierra claros y textura artesanal para fachadas contemporáneas.",
    href: "/productos/toscano",
  },
  {
    nombre: "Ladrillo Cartagena",
    texto: "Formato colonial para fachadas con lenguaje patrimonial y matizado natural.",
    href: "/productos/cartagena",
  },
  {
    nombre: "Macizo Campesino",
    texto: "Pieza maciza de cara rústica para muros estructurales y fachadas.",
    href: "/productos/macizo-campesino",
  },
];

const preguntas = [
  {
    pregunta: "¿Clay House entrega ladrillos en Medellín?",
    respuesta:
      "Sí. Despachamos desde Amagá a Medellín, el Valle de Aburrá y otros municipios de Antioquia. El flete se calcula según el volumen, el tipo de vehículo y la ubicación exacta de la obra.",
  },
  {
    pregunta: "¿Cómo se calcula el precio del pedido?",
    respuesta:
      "La cotización separa el material y el flete. El valor depende de la referencia, el acabado, la cantidad y el destino; por eso se confirma con los datos reales del proyecto y no con una tarifa genérica.",
  },
  {
    pregunta: "¿Puedo comparar medidas y rendimiento antes de cotizar?",
    respuesta:
      "Sí. Cada ficha de producto publica dimensiones, rendimiento por metro cuadrado, peso, norma y precio de referencia cuando el dato está disponible.",
  },
  {
    pregunta: "¿Atienden arquitectos y constructoras?",
    respuesta:
      "Sí. Entregamos fichas técnicas y apoyamos la selección de referencia, acabado y cantidad para proyectos residenciales, comerciales e institucionales.",
  },
];

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Inicio", href: "/" },
  { name: "Ladrillos en Medellín y Antioquia" },
]);
---

<BaseLayout
  title="Ladrillos en Medellín y Antioquia"
  description="Compra ladrillos para fachada, divisorios, enchapes y tejas de barro con despacho a Medellín y Antioquia. Compara referencias y solicita cotización a Clay House."
  ogImage="/images/og/pagina-productos.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <section class="cl-hero">
    <div class="container">
      <p class="eyebrow">Fábrica propia en Amagá, Antioquia</p>
      <h1>Ladrillos en Medellín y Antioquia, directo de fábrica</h1>
      <p class="cl-hero__lead">
        Clay House es una <strong>ladrillera neoartesanal en Amagá</strong> que fabrica y
        comercializa <strong>ladrillo, enchapes y teja de arcilla</strong>, con entrega a Medellín,
        el Valle de Aburrá y todo Antioquia. Cumplimiento
        <strong>NTC 4205</strong> y asesoría para arquitectos y constructores.
      </p>
      <div class="cl-hero__cta">
        <a href="/cotizacion" class="btn btn--primary">
          Cotizar mi pedido
        </a>
        <a href="/productos" class="btn btn--outline">
          Ver catálogo
        </a>
      </div>
    </div>
  </section>

  <section class="section cl-referencias">
    <div class="container">
      <p class="eyebrow">Ladrillo para fachada en Medellín</p>
      <h2 class="cl-h2">Referencias para comparar antes de cotizar</h2>
      <p class="cl-section-lead">
        El formato, el acabado y las piezas por metro cuadrado cambian el resultado y el costo de la
        obra. Estas son cuatro referencias para empezar la selección.
      </p>
      <div class="cl-grid">
        {referencias.map((referencia) => (
          <a href={referencia.href} class="cl-card">
            <h3>{referencia.nombre}</h3>
            <p>{referencia.texto}</p>
            <span class="cl-card__link">Ver medidas, acabados y precio →</span>
          </a>
        ))}
      </div>
      <p class="cl-inline-link">
        ¿Ya conoce el área del muro? Consulte la guía de{" "}
        <a href="/blog/cuantos-ladrillos-por-m2">cuántos ladrillos se necesitan por m²</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="cl-h2">Qué puedes comprar</h2>
      <div class="cl-grid">
        {lineas.map((l) => (
          <a href={l.href} class="cl-card">
            <h3>{l.titulo}</h3>
            <p>{l.texto}</p>
            <span class="cl-card__link">Ver productos →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section cl-precio">
    <div class="container cl-precio__grid">
      <div>
        <p class="eyebrow">Precio y transporte</p>
        <h2 class="cl-h2">Una cotización basada en su obra</h2>
        <p>
          El precio final combina la referencia, el acabado, la cantidad y el despacho desde Amagá.
          En la solicitud puede indicar los metros cuadrados o unidades y marcar la ubicación de la
          obra; con esos datos confirmamos material, disponibilidad y flete.
        </p>
      </div>
      <div class="cl-precio__action">
        <a href="/cotizacion" class="btn btn--primary">
          Calcular y solicitar cotización
        </a>
        <a href="/descargas" class="btn btn--outline">
          Ver fichas técnicas
        </a>
      </div>
    </div>
  </section>

  <section class="section cl-faq">
    <div class="container">
      <h2 class="cl-h2">Preguntas sobre compra y entrega en Medellín</h2>
      <dl class="cl-faq__list">
        {preguntas.map((item) => (
          <div class="cl-faq__item">
            <dt>{item.pregunta}</dt>
            <dd>{item.respuesta}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section cl-cobertura">
    <div class="container">
      <h2 class="cl-h2">Entregamos en Medellín y toda Antioquia</h2>
      <p class="cl-cobertura__lead">
        Despachamos desde nuestra planta en Amagá a obras en el Valle de Aburrá y el resto del
        departamento. Confirmamos el flete según volumen y destino al cotizar.
      </p>
      <ul class="cl-chips">
        {cobertura.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="cl-h2">Cómo comprar</h2>
      <div class="cl-pasos">
        {pasos.map((p) => (
          <div class="cl-paso">
            <span class="cl-paso__n">{p.n}</span>
            <div>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section cl-cierre">
    <div class="container">
      <h2 class="cl-h2">¿Por qué comprarle a Clay House?</h2>
      <ul class="cl-razones">
        <li>
          <strong>Fábrica propia en Amagá</strong> — compras directo, sin intermediarios.
        </li>
        <li>
          <strong>Tradición desde 1965</strong> con procesos neoartesanales.
        </li>
        <li>
          <strong>Cumplimiento NTC 4205</strong> y fichas técnicas por producto.
        </li>
        <li>
          <strong>Cotización en 24 horas hábiles</strong> y entrega en todo Antioquia.
        </li>
      </ul>
      <div class="cl-hero__cta">
        <a href="/cotizacion" class="btn btn--primary">
          Solicitar cotización
        </a>
        <a href="/productos" class="btn btn--outline">
          Comparar todo el catálogo
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cl-hero {
    padding: 3.5rem 0 2.5rem;
    background: var(--color-bg);
  }
  .cl-hero h1 {
    margin: 0.5rem 0 1rem;
    max-width: 18ch;
  }
  .cl-hero__lead {
    max-width: 60ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .cl-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .cl-h2 {
    margin-bottom: 1.5rem;
  }
  .cl-section-lead {
    max-width: 62ch;
    margin: -0.75rem 0 1.5rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }
  .cl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .cl-card {
    display: block;
    padding: 1.5rem;
    background: var(--color-white);
    border: 1px solid rgba(71, 36, 16, 0.12);
    border-radius: 1rem;
    color: var(--color-chocolate);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .cl-card:hover {
    border-color: var(--color-terracota);
    transform: translateY(-2px);
  }
  .cl-card h3 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
  }
  .cl-card p {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .cl-card__link {
    font-weight: 600;
    color: var(--color-terracota);
  }
  .cl-referencias {
    background: var(--color-white);
  }
  .cl-inline-link {
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
  }
  .cl-inline-link a {
    color: var(--color-terracota);
    font-weight: 600;
  }
  .cl-cobertura {
    background: var(--color-white);
  }
  .cl-cobertura__lead {
    max-width: 60ch;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }
  .cl-chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cl-chips li {
    padding: 0.4rem 0.9rem;
    background: var(--color-bg);
    border: 1px solid rgba(71, 36, 16, 0.15);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .cl-pasos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.25rem;
  }
  .cl-paso {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .cl-paso__n {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-terracota);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-weight: 700;
  }
  .cl-paso h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }
  .cl-paso p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .cl-cierre {
    background: var(--color-white);
  }
  .cl-precio {
    background: var(--color-chocolate);
    color: var(--color-white);
  }
  .cl-precio .eyebrow,
  .cl-precio p {
    color: rgba(255, 255, 255, 0.82);
  }
  .cl-precio__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 0.75fr);
    gap: 2rem;
    align-items: center;
  }
  .cl-precio__grid p {
    max-width: 62ch;
    line-height: 1.65;
  }
  .cl-precio__action {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }
  .cl-precio .btn--outline {
    border-color: rgba(255, 255, 255, 0.62);
    color: var(--color-white);
  }
  .cl-faq__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
    margin: 0;
  }
  .cl-faq__item {
    padding-block: 1rem;
    border-top: 1px solid rgba(71, 36, 16, 0.16);
  }
  .cl-faq__item dt {
    font-weight: 700;
    line-height: 1.4;
  }
  .cl-faq__item dd {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .cl-razones {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.65rem;
    max-width: 60ch;
  }
  .cl-razones li {
    padding-left: 1.5rem;
    position: relative;
    line-height: 1.5;
  }
  .cl-razones li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-terracota);
    font-weight: 700;
  }
  @media (max-width: 700px) {
    .cl-precio__grid,
    .cl-faq__list {
      grid-template-columns: 1fr;
    }
  }
</style>
