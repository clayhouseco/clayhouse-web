---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { products, sortProductsByPriority } from "@/data/products";
import { getProductAssets, getProductInspiration } from "@/data/productVariants";
import { catalogCategories, type ProductCategory } from "@/data/catalogCategories";
import { Image } from "astro:assets";
import { srcSetFor, SIZES } from "@/utils/responsive";
import heroImg from "@/assets/images/hero/Edificio 8k.jpg";
import "@/styles/page-hero.css";

interface ProjectImage {
  src: string;
  alt: string;
}

interface ProjectEntry {
  id: string;
  title: string;
  productSlug: string;
  productName: string;
  productCategory: ProductCategory;
  thumbnail: string;
  alt: string;
  imageCount: number;
  images: ProjectImage[];
}

const allProjects: ProjectEntry[] = [];
const productsWithProjects = new Set<string>();

for (const product of sortProductsByPriority(products.filter((p) => !p.hidden))) {
  const manifest = getProductAssets(product.slug);
  if (!manifest) continue;
  const cards = getProductInspiration(manifest).filter(
    (c) => c.category === "Proyecto" && c.images.length > 0
  );
  for (const card of cards) {
    const first = card.images[0];
    if (!first) continue;
    allProjects.push({
      id: `${product.slug}__${card.title}`.replace(/\s+/g, "-").toLowerCase(),
      title: card.title,
      productSlug: product.slug,
      productName: product.name,
      productCategory: product.category,
      thumbnail: first.src,
      alt: first.alt || card.title,
      imageCount: card.images.length,
      images: card.images.map((img) => ({ src: img.src, alt: img.alt || card.title })),
    });
    productsWithProjects.add(product.slug);
  }
}

/** Mapa id → datos del proyecto para alimentar el visor (lightbox) desde JS. */
const projectsData = Object.fromEntries(
  allProjects.map((p) => [
    p.id,
    { title: p.title, productName: p.productName, productSlug: p.productSlug, images: p.images },
  ])
);

const categoriesWithProjects = catalogCategories.filter((cat) =>
  allProjects.some((p) => p.productCategory === cat.id)
);

const productsForFilter = sortProductsByPriority(
  products.filter((p) => productsWithProjects.has(p.slug) && !p.hidden)
).map((p) => ({ slug: p.slug, name: p.name, category: p.category }));

const totalProjects = allProjects.length;
---

<BaseLayout
  title="Proyectos"
  description="Obras construidas con materiales Clay House: fachadas, enchapes, pisos y tejas en ladrillo. Casos reales de arquitectos y constructores en Colombia."
>
  <section class="page-hero page-hero--image">
    <div class="page-hero__media">
      <Image
        src={heroImg}
        alt="Edificio en ladrillo — Clay House"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        width={1920}
        height={1280}
      />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content">
      <h1>proyectos</h1>
      <p class="page-hero__lead">
        Conoce algunos de los proyectos en los que hemos participado con materiales atemporales
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="projects-filters" data-projects-filters>
        <div class="projects-filters__group">
          <span class="projects-filters__label">Categoría:</span>
          <div class="projects-filters__pills">
            <button type="button" class="filter-pill filter-pill--active" data-filter-category="all">
              Todas
            </button>
            {
              categoriesWithProjects.map((cat) => (
                <button
                  type="button"
                  class="filter-pill"
                  data-filter-category={cat.id}
                >
                  {cat.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="projects-filters__group">
          <label class="projects-filters__label" for="filter-product">Producto:</label>
          <select id="filter-product" class="projects-filters__select" data-filter-product>
            <option value="all">Todos los productos</option>
            {
              productsForFilter.map((p) => (
                <option value={p.slug} data-product-category={p.category}>
                  {p.name}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <p class="projects-count" data-projects-count>
        Mostrando <strong>{totalProjects}</strong> de {totalProjects} proyectos
      </p>

      <div class="projects-grid" data-projects-grid>
        {
          allProjects.map((project) => (
            <button
              type="button"
              class="project-card"
              data-project
              data-project-id={project.id}
              data-category={project.productCategory}
              data-product={project.productSlug}
              aria-label={`Ver fotos de ${project.title}`}
            >
              <div class="project-card__media">
                <img
                  src={project.thumbnail}
                  srcset={srcSetFor(project.thumbnail)}
                  sizes={SIZES.card}
                  alt={project.alt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
                {project.imageCount > 1 && (
                  <span class="project-card__count" aria-hidden="true">
                    +{project.imageCount - 1} fotos
                  </span>
                )}
                <span class="project-card__overlay" aria-hidden="true">
                  <span class="project-card__cta">Ver proyecto →</span>
                </span>
              </div>
              <div class="project-card__body">
                <p class="project-card__category">{project.productCategory}</p>
                <h3 class="project-card__title">{project.title}</h3>
                <p class="project-card__product">{project.productName}</p>
              </div>
            </button>
          ))
        }
      </div>

      <p class="projects-empty" data-projects-empty hidden>
        No hay proyectos que coincidan con su selección. Intente otra combinación.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container projects-cta">
      <h2>¿Tiene un proyecto en mente?</h2>
      <p class="text-muted">
        Conversemos sobre la especificación, los acabados y los tiempos de entrega.
      </p>
      <p class="projects-cta__actions">
        <a href="/contacto" class="btn btn--primary">Cotizar mi proyecto</a>
        <a href="/productos" class="btn btn--ghost">Ver catálogo</a>
      </p>
    </div>
  </section>

  <script type="application/json" id="projects-data" set:html={JSON.stringify(projectsData)} />

  <div class="project-viewer" data-viewer hidden aria-hidden="true">
    <div class="project-viewer__backdrop" data-viewer-close></div>
    <div class="project-viewer__dialog" role="dialog" aria-modal="true" aria-labelledby="viewer-title">
      <button type="button" class="project-viewer__close" data-viewer-close aria-label="Cerrar">
        ×
      </button>
      <div class="project-viewer__stage">
        <button type="button" class="project-viewer__nav project-viewer__nav--prev" data-viewer-prev aria-label="Anterior">
          ‹
        </button>
        <figure class="project-viewer__figure">
          <img data-viewer-img src="" alt="" />
        </figure>
        <button type="button" class="project-viewer__nav project-viewer__nav--next" data-viewer-next aria-label="Siguiente">
          ›
        </button>
      </div>
      <div class="project-viewer__bar">
        <div class="project-viewer__meta">
          <h2 class="project-viewer__title" id="viewer-title" data-viewer-title></h2>
          <p class="project-viewer__product" data-viewer-product></p>
        </div>
        <div class="project-viewer__bar-right">
          <span class="project-viewer__counter" data-viewer-counter></span>
          <a class="project-viewer__link" data-viewer-link href="#">Ver producto →</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const filters = document.querySelector<HTMLElement>("[data-projects-filters]");
  const grid = document.querySelector<HTMLElement>("[data-projects-grid]");
  const empty = document.querySelector<HTMLElement>("[data-projects-empty]");
  const counter = document.querySelector<HTMLElement>("[data-projects-count]");
  const productSelect = filters?.querySelector<HTMLSelectElement>("[data-filter-product]");
  const cards = grid?.querySelectorAll<HTMLElement>("[data-project]");
  const categoryButtons = filters?.querySelectorAll<HTMLButtonElement>("[data-filter-category]");

  let activeCategory = "all";
  let activeProduct = "all";
  const totalCards = cards?.length ?? 0;

  function applyFilters() {
    if (!cards) return;
    let visible = 0;
    cards.forEach((card) => {
      const matchesCategory =
        activeCategory === "all" || card.dataset.category === activeCategory;
      const matchesProduct =
        activeProduct === "all" || card.dataset.product === activeProduct;
      const isVisible = matchesCategory && matchesProduct;
      card.hidden = !isVisible;
      if (isVisible) visible += 1;
    });

    if (empty) empty.hidden = visible > 0;
    if (counter) {
      counter.innerHTML = `Mostrando <strong>${visible}</strong> de ${totalCards} proyectos`;
    }
  }

  // Cachea las opciones originales del select de productos. Los browsers
  // ignoran <option hidden>, así que para filtrar de verdad hay que
  // quitarlas del DOM y reinsertarlas cuando cambia la categoría.
  const productOptionsMaster = productSelect
    ? Array.from(productSelect.options)
        .filter((opt) => opt.value !== "all")
        .map((opt) => ({
          value: opt.value,
          label: opt.textContent ?? opt.value,
          category: opt.dataset.productCategory ?? "",
        }))
    : [];

  function syncProductOptions() {
    if (!productSelect) return;
    // Conserva la opción "Todos los productos" y reconstruye el resto.
    const allOpt = Array.from(productSelect.options).find((o) => o.value === "all");
    productSelect.innerHTML = "";
    if (allOpt) productSelect.appendChild(allOpt);
    for (const item of productOptionsMaster) {
      if (activeCategory !== "all" && item.category !== activeCategory) continue;
      const opt = document.createElement("option");
      opt.value = item.value;
      opt.textContent = item.label;
      opt.dataset.productCategory = item.category;
      productSelect.appendChild(opt);
    }
    // Si la categoría dejó fuera al producto activo, vuelve a "Todos".
    if (
      activeProduct !== "all" &&
      !Array.from(productSelect.options).some((o) => o.value === activeProduct)
    ) {
      activeProduct = "all";
    }
    productSelect.value = activeProduct;
  }

  categoryButtons?.forEach((btn) => {
    btn.addEventListener("click", () => {
      categoryButtons.forEach((b) => b.classList.remove("filter-pill--active"));
      btn.classList.add("filter-pill--active");
      activeCategory = btn.dataset.filterCategory ?? "all";
      syncProductOptions();
      applyFilters();
    });
  });

  productSelect?.addEventListener("change", () => {
    activeProduct = productSelect.value;
    applyFilters();
  });

  const params = new URLSearchParams(window.location.search);
  const initialCategory = params.get("categoria");
  const initialProduct = params.get("producto");
  if (initialCategory) {
    const btn = filters?.querySelector<HTMLButtonElement>(
      `[data-filter-category="${initialCategory}"]`
    );
    btn?.click();
  }
  if (initialProduct && productSelect) {
    productSelect.value = initialProduct;
    productSelect.dispatchEvent(new Event("change"));
  }

  // ---- Visor de proyectos (lightbox dentro de /proyectos) ----
  interface ViewerImage { src: string; alt: string }
  interface ViewerProject {
    title: string;
    productName: string;
    productSlug: string;
    images: ViewerImage[];
  }

  const dataEl = document.getElementById("projects-data");
  const projectsData: Record<string, ViewerProject> = dataEl
    ? JSON.parse(dataEl.textContent || "{}")
    : {};

  const viewer = document.querySelector<HTMLElement>("[data-viewer]");
  const viewerImg = viewer?.querySelector<HTMLImageElement>("[data-viewer-img]");
  const viewerTitle = viewer?.querySelector<HTMLElement>("[data-viewer-title]");
  const viewerProduct = viewer?.querySelector<HTMLElement>("[data-viewer-product]");
  const viewerCounter = viewer?.querySelector<HTMLElement>("[data-viewer-counter]");
  const viewerLink = viewer?.querySelector<HTMLAnchorElement>("[data-viewer-link]");
  const prevBtn = viewer?.querySelector<HTMLButtonElement>("[data-viewer-prev]");
  const nextBtn = viewer?.querySelector<HTMLButtonElement>("[data-viewer-next]");

  let current: ViewerProject | null = null;
  let index = 0;
  let lastFocused: HTMLElement | null = null;

  function renderImage() {
    if (!current || !viewerImg) return;
    const img = current.images[index];
    if (!img) return;
    viewerImg.src = img.src;
    viewerImg.alt = img.alt;
    if (viewerCounter) {
      viewerCounter.textContent = `${index + 1} / ${current.images.length}`;
    }
    const multi = current.images.length > 1;
    if (prevBtn) prevBtn.hidden = !multi;
    if (nextBtn) nextBtn.hidden = !multi;
  }

  function openViewer(id: string, trigger: HTMLElement) {
    const project = projectsData[id];
    if (!project || !viewer) return;
    current = project;
    index = 0;
    lastFocused = trigger;
    if (viewerTitle) viewerTitle.textContent = project.title;
    if (viewerProduct) viewerProduct.textContent = project.productName;
    if (viewerLink) viewerLink.href = `/productos/${project.productSlug}/`;
    renderImage();
    viewer.hidden = false;
    viewer.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    viewer.querySelector<HTMLButtonElement>("[data-viewer-close]")?.focus();
  }

  function closeViewer() {
    if (!viewer) return;
    viewer.hidden = true;
    viewer.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    current = null;
    lastFocused?.focus();
  }

  function step(delta: number) {
    if (!current) return;
    const n = current.images.length;
    index = (index + delta + n) % n;
    renderImage();
  }

  cards?.forEach((card) => {
    card.addEventListener("click", () => {
      const id = card.dataset.projectId;
      if (id) openViewer(id, card);
    });
  });

  viewer?.querySelectorAll<HTMLElement>("[data-viewer-close]").forEach((el) => {
    el.addEventListener("click", closeViewer);
  });
  prevBtn?.addEventListener("click", () => step(-1));
  nextBtn?.addEventListener("click", () => step(1));

  document.addEventListener("keydown", (e) => {
    if (viewer?.hidden) return;
    if (e.key === "Escape") closeViewer();
    if (e.key === "ArrowLeft") step(-1);
    if (e.key === "ArrowRight") step(1);
  });
</script>

<style>

  .projects-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    margin-bottom: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-white);
    border: 1px solid rgba(71, 36, 16, 0.08);
    border-radius: var(--radius-lg);
  }

  .projects-filters__group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .projects-filters__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .projects-filters__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-pill {
    padding: 0.5rem 0.95rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-chocolate);
    background: var(--color-bg);
    border: 1px solid rgba(71, 36, 16, 0.15);
    border-radius: 999px;
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .filter-pill:hover {
    border-color: var(--color-terracota);
    color: var(--color-terracota);
  }

  .filter-pill--active,
  .filter-pill--active:hover {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-bg);
  }

  .projects-filters__select {
    font-family: var(--font-body);
    font-size: 0.875rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(71, 36, 16, 0.15);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-chocolate);
    min-width: 14rem;
  }

  .projects-count {
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .projects-count strong {
    color: var(--color-chocolate);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    padding: 0;
    text-align: left;
    font: inherit;
    cursor: pointer;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(71, 36, 16, 0.08);
    box-shadow: 0 2px 12px rgba(71, 36, 16, 0.06);
    color: inherit;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-terracota);
    outline-offset: 3px;
  }

  /* Fuerza ocultamiento sobre el display:flex de arriba. Sin esto el atributo
   * [hidden] no funciona y los filtros no esconden las tarjetas. */
  .project-card[hidden] {
    display: none;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(124, 72, 44, 0.2);
    box-shadow: 0 18px 40px rgba(71, 36, 16, 0.12);
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #ebe6e0;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.04);
  }

  .project-card__count {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-bg);
    background: rgba(71, 36, 16, 0.78);
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }

  .project-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 1.25rem;
    background: linear-gradient(to top, rgba(71, 36, 16, 0.82) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .project-card:hover .project-card__overlay {
    opacity: 1;
  }

  .project-card__cta {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-bg);
  }

  .project-card__body {
    padding: 1.15rem 1.25rem 1.25rem;
  }

  .project-card__category {
    margin: 0 0 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-terracota);
  }

  .project-card__title {
    margin: 0 0 0.25rem;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-chocolate);
  }

  .project-card__product {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .projects-empty {
    margin: 2.5rem 0 0;
    padding: 2rem;
    text-align: center;
    background: var(--color-white);
    border: 1px dashed rgba(71, 36, 16, 0.15);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  .projects-cta {
    text-align: center;
  }

  .projects-cta h2 {
    margin: 0 0 0.75rem;
  }

  .projects-cta__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .projects-filters {
      padding: 1rem;
    }

    .projects-filters__group {
      width: 100%;
    }

    .projects-filters__select {
      min-width: 0;
      flex: 1;
    }
  }

  /* ---------------- VISOR (lightbox) ---------------- */
  .project-viewer {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
  }

  .project-viewer[hidden] {
    display: none;
  }

  .project-viewer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(35, 18, 8, 0.88);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .project-viewer__dialog {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(100%, 1100px);
    max-height: 92vh;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .project-viewer__close {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 3;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-bg);
    background: rgba(35, 18, 8, 0.55);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s var(--ease);
  }

  .project-viewer__close:hover {
    background: rgba(35, 18, 8, 0.85);
  }

  .project-viewer__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a120c;
    min-height: 0;
    flex: 1;
  }

  .project-viewer__figure {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-viewer__figure img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    display: block;
  }

  .project-viewer__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-chocolate);
    background: rgba(255, 251, 249, 0.9);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .project-viewer__nav:hover {
    background: var(--color-bg);
