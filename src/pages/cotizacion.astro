---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { logos } from "@/utils/media";
import { cotizableCatalog } from "@/data/cotizacionCatalog";

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const formspreeReady =
  Boolean(formspreeId) && formspreeId !== "your_form_id" && !formspreeId?.startsWith("your_");
const formAction = formspreeReady ? `https://formspree.io/f/${formspreeId}` : undefined;

const DEPARTAMENTOS = [
  "Antioquia", "Atlántico", "Bogotá D.C.", "Bolívar", "Boyacá", "Caldas", "Caquetá",
  "Casanare", "Cauca", "Cesar", "Córdoba", "Cundinamarca", "Chocó", "Huila", "La Guajira",
  "Magdalena", "Meta", "Nariño", "Norte de Santander", "Quindío", "Risaralda", "Santander",
  "Sucre", "Tolima", "Valle del Cauca",
];
---

<BaseLayout
  title="Solicitar cotización"
  description="Arma tu cotización de ladrillo, teja o piso Clay House: elige productos, color, calidad y cantidad, y recibe la propuesta para tu obra."
  hideQuoteCart={true}
>
  <section class="cotz">
    <div class="container cotz__head">
      <p class="cotz__eyebrow">Comercial</p>
      <h1>Solicitar cotización</h1>
      <p class="cotz__lead">
        Agrega los productos con su color, calidad y cantidad. A la derecha ves tu cotización
        preliminar; al enviarla, nuestro equipo te confirma precios finales, flete y condiciones.
      </p>
    </div>

    <form class="container cotz__grid" id="cotizacion-form" method={formAction ? "POST" : "get"} action={formAction}>
      {formAction && <input type="hidden" name="_subject" value="Nueva cotización desde la web" />}
      <input type="hidden" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="cotizacion" data-cotizacion-payload />

      <!-- ============ COLUMNA IZQUIERDA: FORMULARIO ============ -->
      <div class="cotz__form">
        <section class="cotz-card">
          <h2>Cliente y obra</h2>
          <div class="cotz-fields">
            <label>Nombre de contacto *
              <input type="text" name="nombre" required autocomplete="name" data-c="nombre" />
            </label>
            <label>Proyecto / obra
              <input type="text" name="proyecto" placeholder="Ej. Edificio El Solar" data-c="proyecto" />
            </label>
            <label>Teléfono / WhatsApp *
              <input type="tel" name="telefono" required autocomplete="tel" data-c="telefono" />
            </label>
            <label>Correo *
              <input type="email" name="email" required autocomplete="email" data-c="email" />
            </label>
            <label>Empresa (opcional)
              <input type="text" name="empresa" autocomplete="organization" data-c="empresa" />
            </label>
          </div>

          <div class="cotz-entrega">
            <span class="cotz-entrega__label">Modalidad de entrega</span>
            <div class="cotz-pills">
              <button type="button" class="cotz-pill cotz-pill--active" data-entrega="obra" aria-pressed="true">Despacho a obra</button>
              <button type="button" class="cotz-pill" data-entrega="planta" aria-pressed="false">Recoge en planta</button>
            </div>
            <input type="hidden" name="entrega" value="obra" data-entrega-value />
          </div>

          <div class="cotz-fields" data-obra-fields>
            <p class="cotz-flete-nota">
              El <b>flete no está incluido</b> en la cotización preliminar; lo calcula nuestro
              equipo comercial según la ubicación de tu obra.
            </p>
            <label class="cotz-full">Ubicación de la obra (dirección exacta o link de Google Maps) *
              <input type="text" name="direccion" placeholder="Cra 43A #1-50, o pega el link de Google Maps" autocomplete="street-address" data-c="direccion" data-req-obra />
            </label>
            <label>Municipio / ciudad
              <input type="text" name="municipio" autocomplete="address-level2" data-c="municipio" />
            </label>
            <label>Departamento
              <select name="departamento" data-c="departamento">
                {DEPARTAMENTOS.map((d) => <option value={d} selected={d === "Antioquia"}>{d}</option>)}
              </select>
            </label>
          </div>
        </section>

        <section class="cotz-card">
          <div class="cotz-card__head">
            <h2>Productos a cotizar</h2>
            <button type="button" class="cotz-add" data-add-linea>+ Agregar producto</button>
          </div>
          <div data-lineas></div>
        </section>

        <label class="cotz-card cotz-notas">Notas para el equipo (opcional)
          <textarea name="mensaje" rows="3" placeholder="Fechas, detalles de obra, preguntas..." data-c="mensaje"></textarea>
        </label>

        <div class="cotz-submit">
          <button type="submit" class="btn btn--primary btn--block">Enviar cotización preliminar</button>
          <p class="cotz-legal">Al enviar aceptas el tratamiento de tus datos para fines comerciales.</p>
          {!formAction && (
            <p class="cotz-legal cotz-legal--warn">
              Modo demo: falta configurar el envío. Contáctanos por
              <a href={site.whatsapp} target="_blank" rel="noopener"> WhatsApp</a>.
            </p>
          )}
        </div>
      </div>

      <!-- ============ COLUMNA DERECHA: DOCUMENTO ============ -->
      <aside class="cotz__doc-col">
        <div class="cotz-doc" data-doc>
          <header class="cotz-doc__top">
            <img src={logos.header} alt="Clay House" class="cotz-doc__logo" />
            <div class="cotz-doc__badge">
              <span>COTIZACIÓN</span>
              <strong>PRELIMINAR</strong>
              <span data-doc-fecha></span>
            </div>
          </header>

          <div class="cotz-doc__body">
            <div class="cotz-doc__datos">
              <div>
                <p><span>Cliente:</span> <b data-doc-nombre>Pendiente</b></p>
                <p><span>Teléfono:</span> <b data-doc-tel>Pendiente</b></p>
                <p><span>Correo:</span> <b data-doc-email>Pendiente</b></p>
              </div>
              <div>
                <p><span>Proyecto:</span> <b data-doc-proyecto>Pendiente</b></p>
                <p><span>Entrega:</span> <b data-doc-entrega>Despacho a obra</b></p>
                <p><span>Ubicación:</span> <b data-doc-ubicacion>Pendiente</b></p>
              </div>
            </div>

            <table class="cotz-doc__tabla">
              <thead>
                <tr><th>Producto</th><th class="num">Cant.</th><th class="num">V. ref.</th><th class="num">Valor</th></tr>
              </thead>
              <tbody data-doc-lineas>
                <tr><td colspan="4" class="cotz-doc__vacio">Agrega productos para verlos aquí.</td></tr>
              </tbody>
            </table>

            <div class="cotz-doc__totales">
              <div class="cotz-doc__total-row"><span>Estimado de material</span><b data-doc-material>—</b></div>
              <div class="cotz-doc__total-row cotz-doc__total-row--flete"><span>Flete</span><b>No incluido</b></div>
            </div>

            <div class="cotz-doc__notas">
              <p><b>Cotización preliminar.</b> El flete <b>no está incluido</b> y se calcula aparte según la ubicación de la obra. Los precios son de referencia; el valor final lo confirma nuestro equipo con la cotización oficial.</p>
            </div>

            <footer class="cotz-doc__pie">
              <b>Clay House</b> · {site.phone} · {site.email}
            </footer>
          </div>
        </div>
      </aside>
    </form>
  </section>

  <template data-linea-template>
    <div class="cotz-linea" data-linea>
      <div class="cotz-linea__grid">
        <label class="cotz-linea__prod">Producto
          <select data-campo="item" required></select>
        </label>
        <label data-campo-wrap="color" hidden>Color
          <select data-campo="color"></select>
        </label>
        <label data-campo-wrap="calidad">Calidad
          <select data-campo="calidad"></select>
        </label>
        <label class="cotz-linea__qty">Cantidad
          <input type="number" min="1" value="1" data-campo="cantidad" />
        </label>
        <span class="cotz-linea__u" data-unidad></span>
        <button type="button" class="cotz-linea__del" data-del-linea aria-label="Quitar">×</button>
      </div>
    </div>
  </template>

  <script define:vars={{ catalog: cotizableCatalog }}>
    const form = document.getElementById("cotizacion-form");
    const lineasBox = form.querySelector("[data-lineas]");
    const tpl = document.querySelector("[data-linea-template]");
    const byId = Object.fromEntries(catalog.map((c) => [c.id, c]));

    const MESES = ["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
    const parseCop = (s) => { if (!s) return null; if (String(s).toLowerCase().includes("consult")) return null; const d = String(s).replace(/[^\d]/g, ""); return d ? parseInt(d, 10) : null; };
    const fmtCop = (n) => new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(n);
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

    function optionsHtml() {
      return '<option value="">Selecciona…</option>' +
        catalog.map((c) => `<option value="${c.id}">${c.label}${c.erpCodigo ? "" : " (por confirmar)"}</option>`).join("");
    }

    function fillDependent(linea, item, preset = {}) {
      const colorWrap = linea.querySelector('[data-campo-wrap="color"]');
      const colorSel = linea.querySelector('[data-campo="color"]');
      const calSel = linea.querySelector('[data-campo="calidad"]');
      const unidadEl = linea.querySelector("[data-unidad]");
      if (item && item.coloresPermitidos.length) {
        colorWrap.hidden = false;
        colorSel.innerHTML = item.coloresPermitidos.map((c) => `<option value="${c.codigo}">${c.nombre}</option>`).join("");
        if (preset.color) colorSel.value = preset.color;
      } else { colorWrap.hidden = true; colorSel.innerHTML = ""; }
      if (item) {
        calSel.innerHTML = item.calidadesPermitidas.map((c) => `<option value="${c.codigo}">${c.nombre}</option>`).join("");
        if (preset.calidad) calSel.value = preset.calidad;
      } else calSel.innerHTML = "";
      unidadEl.textContent = item ? item.unidadLabel : "";
    }

    function addLinea(preset = {}) {
      const linea = tpl.content.firstElementChild.cloneNode(true);
      const itemSel = linea.querySelector('[data-campo="item"]');
      itemSel.innerHTML = optionsHtml();
      if (preset.id && byId[preset.id]) itemSel.value = preset.id;
      fillDependent(linea, byId[itemSel.value], preset);
      if (preset.cantidad) linea.querySelector('[data-campo="cantidad"]').value = preset.cantidad;
      itemSel.addEventListener("change", () => { fillDependent(linea, byId[itemSel.value]); updateDoc(); });
      linea.querySelector("[data-del-linea]").addEventListener("click", () => { linea.remove(); updateDoc(); });
      lineasBox.appendChild(linea);
      updateDoc();
    }
    form.querySelector("[data-add-linea]").addEventListener("click", () => addLinea());
    lineasBox.addEventListener("input", updateDoc);
    lineasBox.addEventListener("change", updateDoc);

    // ---- Documento en vivo ----
    const d = (sel) => form.querySelector(sel);
    const cval = (name) => (form.querySelector(`[data-c="${name}"]`)?.value || "").trim();
    function currentLineas() {
      return [...lineasBox.querySelectorAll("[data-linea]")].map((l) => {
        const item = byId[l.querySelector('[data-campo="item"]').value];
        if (!item) return null;
        const cant = parseInt(l.querySelector('[data-campo="cantidad"]').value || "0", 10) || 0;
        const colSel = l.querySelector('[data-campo="color"]');
        const calSel = l.querySelector('[data-campo="calidad"]');
        const colName = colSel && !colSel.closest("[hidden]") ? (colSel.selectedOptions[0]?.text || "") : "";
        const calName = calSel.selectedOptions[0]?.text || "";
        const colCod = colSel && !colSel.closest("[hidden]") ? colSel.value : null;
        const calCod = calSel.value || null;
        const precio = parseCop(item.refPrice);
        return { item, cant, colName, calName, colCod, calCod, precio, sub: precio != null ? precio * cant : null };
      }).filter(Boolean);
    }
    function updateDoc() {
      const now = new Date();
      d("[data-doc-fecha]").textContent = `${now.getDate()} de ${MESES[now.getMonth()]} de ${now.getFullYear()}`;
      d("[data-doc-nombre]").textContent = cval("nombre") || "Pendiente";
      d("[data-doc-tel]").textContent = cval("telefono") || "Pendiente";
      d("[data-doc-email]").textContent = cval("email") || "Pendiente";
      d("[data-doc-proyecto]").textContent = cval("proyecto") || "Pendiente";
      const planta = form.querySelector("[data-entrega-value]").value === "planta";
      d("[data-doc-entrega]").textContent = planta ? "Recoge en planta" : "Despacho a obra";
      d("[data-doc-ubicacion]").textContent = planta ? "Planta Amagá" : ([cval("direccion"), cval("municipio")].filter(Boolean).join(", ") || "Pendiente");

      const lineas = currentLineas();
      const tbody = d("[data-doc-lineas]");
      if (!lineas.length) {
        tbody.innerHTML = '<tr><td colspan="4" class="cotz-doc__vacio">Agrega productos para verlos aquí.</td></tr>';
      } else {
        tbody.innerHTML = lineas.map((r) => {
          const detalle = [r.colName, r.calName].filter(Boolean).join(" · ");
          return `<tr><td><b>${esc(r.item.label)}</b>${detalle ? `<br><span class="cotz-doc__det">${esc(detalle)}</span>` : ""}</td>` +
            `<td class="num">${r.cant} ${esc(r.item.unidadLabel)}</td>` +
            `<td class="num">${r.precio != null ? fmtCop(r.precio) : "—"}</td>` +
            `<td class="num">${r.sub != null ? fmtCop(r.sub) : "A confirmar"}</td></tr>`;
        }).join("");
      }
      let total = 0, algo = false;
      lineas.forEach((r) => { if (r.sub != null) total += r.sub; else algo = true; });
      d("[data-doc-material]").textContent = lineas.length ? fmtCop(total) + (algo ? " + a confirmar" : "") : "—";
    }

    // ---- Modalidad de entrega (planta oculta y no exige la ubicación) ----
    const entregaVal = form.querySelector("[data-entrega-value]");
    const obraFields = form.querySelector("[data-obra-fields]");
    function setEntrega(val) {
      entregaVal.value = val;
      const planta = val === "planta";
      obraFields.hidden = planta;
      form.querySelectorAll("[data-req-obra]").forEach((el) => { el.required = !planta; });
      updateDoc();
    }
    form.querySelectorAll(".cotz-pill").forEach((pill) => {
      pill.addEventListener("click", () => {
        form.querySelectorAll(".cotz-pill").forEach((p) => {
          const on = p === pill; p.classList.toggle("cotz-pill--active", on); p.setAttribute("aria-pressed", on ? "true" : "false");
        });
        setEntrega(pill.dataset.entrega);
      });
    });

    // ---- Datos del cliente actualizan el documento ----
    form.querySelectorAll("[data-c]").forEach((el) => el.addEventListener("input", updateDoc));

    // ---- Precargar desde el carrito ----
    (function prefill() {
      let cart = [];
      try { cart = JSON.parse(localStorage.getItem("clayhouse-quote-cart") || "[]"); } catch {}
      const nombreACod = {};
      catalog.forEach((c) => c.coloresPermitidos.forEach((col) => (nombreACod[col.nombre.toLowerCase()] = col.codigo)));
      let n = 0;
      cart.forEach((it) => {
        const id = it.variantId ? `${it.slug}::${it.variantId}` : it.slug;
        if (!byId[id]) return;
        addLinea({ id, color: it.color ? nombreACod[String(it.color).toLowerCase()] : undefined, calidad: it.calidad, cantidad: it.quantity });
        n++;
      });
      if (!n) addLinea();
    })();
    updateDoc();

    // ---- Payload estructurado (formato ERP) al enviar ----
    form.addEventListener("submit", () => {
      const payload = {
        cliente: { nombre: cval("nombre"), telefono: cval("telefono"), email: cval("email"), empresa: cval("empresa"), proyecto: cval("proyecto") },
        entrega: entregaVal.value,
        ubicacion: entregaVal.value === "planta" ? "Recoge en planta" : { direccion: cval("direccion"), municipio: cval("municipio"), departamento: cval("departamento") },
        lineas: currentLineas().map((r) => ({ erpCodigo: r.item.erpCodigo, producto: r.item.label, color: r.colCod, calidad: r.calCod, cantidad: r.cant, unidad: r.item.unidad })),
        nota: "FLETE NO INCLUIDO — cotización preliminar de la web.",
      };
      const el = form.querySelector("[data-cotizacion-payload]");
      if (el) el.value = JSON.stringify(payload, null, 2);
      try { localStorage.removeItem("clayhouse-quote-cart"); } catch {}
    });
  </script>
</BaseLayout>

<style>
  .cotz { padding: 7rem 0 4rem; }
  .cotz__head { max-width: 48rem; margin-bottom: 2rem; }
  .cotz__eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-terracota); }
  .cotz__head h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); color: var(--color-chocolate); margin: 0.15rem 0 0.6rem; }
  .cotz__lead { color: #5c534f; }
  .cotz__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
  .cotz__form { display: flex; flex-direction: column; gap: 1.5rem; }

  .cotz-card { background: var(--color-white); border: 1px solid rgba(71, 36, 16, 0.1); border-radius: var(--radius-md); padding: 1.5rem; }
  .cotz-card__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .cotz-card h2 { font-size: 1.05rem; color: var(--color-chocolate); margin: 0 0 1rem; }
  .cotz-card__head h2 { margin: 0; }
  .cotz-add { padding: 0.45rem 0.9rem; font-size: 0.85rem; font-weight: 600; color: var(--color-terracota); background: var(--color-bg); border: 1px solid rgba(124, 72, 44, 0.3); border-radius: 999px; cursor: pointer; }
  .cotz-add:hover { background: var(--color-terracota); color: #fff; border-color: var(--color-terracota); }

  .cotz-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .cotz-full { grid-column: 1 / -1; }
  .cotz label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.8rem; font-weight: 600; color: var(--color-chocolate); }
  .cotz input, .cotz select, .cotz textarea { font: inherit; font-weight: 400; padding: 0.55rem 0.7rem; border: 1px solid rgba(71, 36, 16, 0.2); border-radius: var(--radius-sm); background: var(--color-bg); width: 100%; }

  .cotz-entrega { margin: 1.25rem 0; }
  .cotz-entrega__label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--color-chocolate); margin-bottom: 0.45rem; }
  .cotz-pills { display: flex; gap: 0.5rem; }
  .cotz-pill { padding: 0.5rem 1rem; border: 1px solid rgba(71, 36, 16, 0.2); border-radius: 999px; background: var(--color-white); color: var(--color-chocolate); font-weight: 500; cursor: pointer; }
  .cotz-pill--active { background: var(--color-terracota); border-color: var(--color-terracota); color: #fff; }
  .cotz-flete-nota { grid-column: 1 / -1; margin: 0; font-size: 0.82rem; color: #5c534f; background: rgba(124, 72, 44, 0.06); border-left: 3px solid var(--color-terracota); padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }

  .cotz-linea { border: 1px solid rgba(71, 36, 16, 0.1); border-radius: var(--radius-sm); padding: 0.85rem; margin-bottom: 0.75rem; background: var(--color-bg); }
  .cotz-linea__grid { display: grid; grid-template-columns: 1.8fr 1.1fr 1.1fr 0.8fr auto auto; gap: 0.6rem; align-items: end; }
  .cotz-linea__u { font-size: 0.8rem; color: #5c534f; padding-bottom: 0.55rem; }
  .cotz-linea__del { width: 2rem; height: 2rem; border: 1px solid rgba(71, 36, 16, 0.15); border-radius: 50%; background: var(--color-white); color: var(--color-terracota); font-size: 1.15rem; line-height: 1; cursor: pointer; }
  .cotz-linea__del:hover { background: var(--color-terracota); color: #fff; }

  .cotz-notas { display: flex; flex-direction: column; gap: 0.4rem; }
  .cotz-submit { text-align: center; }
  .cotz-legal { margin-top: 0.7rem; font-size: 0.78rem; color: #8a807c; }
  .cotz-legal--warn { color: var(--color-terracota); }

  /* ---- Documento (columna derecha) ---- */
  .cotz__doc-col { position: sticky; top: 6rem; }
  .cotz-doc { border: 1px solid rgba(71, 36, 16, 0.14); border-radius: var(--radius-md); overflow: hidden; background: #fff; box-shadow: 0 10px 30px rgba(71, 36, 16, 0.07); }
  .cotz-doc__top { background: var(--color-chocolate); color: #fff; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .cotz-doc__logo { height: 26px; width: auto; filter: brightness(0) invert(1); }
  .cotz-doc__badge { text-align: right; border: 1px solid rgba(255,255,255,0.3); border-radius: var(--radius-sm); padding: 0.5rem 0.8rem; font-size: 0.65rem; letter-spacing: 0.08em; line-height: 1.5; }
  .cotz-doc__badge strong { display: block; font-size: 0.9rem; letter-spacing: 0.04em; }
  .cotz-doc__body { padding: 1.5rem; }
  .cotz-doc__datos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.78rem; color: #5c534f; margin-bottom: 1.25rem; }
  .cotz-doc__datos p { margin: 0 0 0.2rem; }
  .cotz-doc__datos span { color: #9a908b; }
  .cotz-doc__datos b { color: var(--color-chocolate); font-weight: 600; }
  .cotz-doc__tabla { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
  .cotz-doc__tabla thead th { background: var(--color-chocolate); color: #fff; text-align: left; padding: 0.5rem 0.6rem; font-size: 0.68rem; letter-spacing: 0.04em; }
  .cotz-doc__tabla th.num, .cotz-doc__tabla td.num { text-align: right; }
  .cotz-doc__tabla td { padding: 0.55rem 0.6rem; border-bottom: 1px solid #eee; vertical-align: top; }
  .cotz-doc__det { color: #9a908b; font-size: 0.72rem; }
  .cotz-doc__vacio { text-align: center; color: #9a908b; padding: 1.25rem; }
  .cotz-doc__totales { margin-top: 0.85rem; }
  .cotz-doc__total-row { display: flex; justify-content: space-between; padding: 0.5rem 0.6rem; font-size: 0.85rem; }
  .cotz-doc__total-row b { color: var(--color-chocolate); }
