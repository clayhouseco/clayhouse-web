---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { logos } from "@/utils/media";
import { cotizableCatalog } from "@/data/cotizacionCatalog";
import LineaDeCotizacion from "@/components/cotizacion/LineaDeCotizacion.astro";

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const formspreeReady =
  Boolean(formspreeId) && formspreeId !== "your_form_id" && !formspreeId?.startsWith("your_");
const formAction = formspreeReady ? `https://formspree.io/f/${formspreeId}` : undefined;

/**
 * LO QUE EL COTIZADOR NECESITA EN EL NAVEGADOR.
 *
 * Viaja en un bloque `application/json` que el módulo lee al arrancar. Antes iba por
 * `define:vars`, que obliga a escribir todo el cotizador dentro del `<script>` de la
 * página: sin `import`, sin tipos y sin pruebas. La clave de Supabase es la publicable y
 * ya estaba en el HTML; esto no cambia qué se expone.
 */
const cotizadorConfig = {
  catalogo: cotizableCatalog,
  waNumber: site.whatsapp.replace("https://wa.me/", ""),
  ventasEmail: site.email,
  supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL ?? "https://xmgsljwxiyyporczsrum.supabase.co",
  supabaseKey: import.meta.env.PUBLIC_SUPABASE_KEY ?? "sb_publishable_fyo-0iRd3xBmq9AjAgkwxw_xjIDKYeH",
};
/* `</script>` dentro de una cadena cerraría el bloque antes de tiempo. */
const cotizadorJson = JSON.stringify(cotizadorConfig).replace(/</g, "\\u003c");

const DEPARTAMENTOS = [
  "Antioquia", "Atlántico", "Bogotá D.C.", "Bolívar", "Boyacá", "Caldas", "Caquetá",
  "Casanare", "Cauca", "Cesar", "Córdoba", "Cundinamarca", "Chocó", "Huila", "La Guajira",
  "Magdalena", "Meta", "Nariño", "Norte de Santander", "Quindío", "Risaralda", "Santander",
  "Sucre", "Tolima", "Valle del Cauca",
];
---

<BaseLayout
  title="Solicitar cotización"
  description="Arma tu cotización de ladrillo, teja o enchape Clay House: elige productos, color y cantidad, y recibe la propuesta para tu obra."
  ogImage="/images/og/pagina-cotizacion.jpg"
  hideQuoteCart={true}
>
  <section class="cotz">
    <div class="container cotz__head">
      <p class="cotz__eyebrow">Comercial</p>
      <h1>Solicitar cotización</h1>
      <p class="cotz__lead">
        Agrega los productos con su color y cantidad. Mientras agregas se arma tu cotización
        preliminar; al enviarla, nuestro equipo te confirma precios finales, flete y condiciones.
      </p>
    </div>

    <form class="container cotz__grid" id="cotizacion-form" method={formAction ? "POST" : "get"} action={formAction}>
      {formAction && <input type="hidden" name="_subject" value="Nueva cotización desde la web" />}
      {/* Sin esto, Formspree deja al cliente en su propia página de gracias: fondo blanco,
          «Thanks!» en inglés y ningún camino de vuelta. */}
      {formAction && <input type="hidden" name="_next" value={new URL("/cotizacion/gracias", site.url).href} />}
      <input type="hidden" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="Detalle de la cotización" data-cotizacion-payload />

      <!-- ============ COLUMNA IZQUIERDA: FORMULARIO ============ -->
      <div class="cotz__form">
        <section class="cotz-card">
          <div class="cotz-card__head">
            <h2>Productos a cotizar</h2>
            <button type="button" class="cotz-add" data-add-linea>+ Agregar producto</button>
          </div>
          {/* La primera línea viene pintada: sin esto el formulario se pintaba vacío y
              crecía de golpe al cargar el módulo (0,236 de CLS en móvil). El módulo la
              adopta —le pone los oyentes— en vez de crearla. */}
          <div data-lineas><LineaDeCotizacion /></div>
        </section>

        <section class="cotz-card">
          <h2>Cliente y obra</h2>
          <div class="cotz-fields">
            <label>Nombre de contacto *
              <input type="text" name="nombre" required autocomplete="name" data-c="nombre" />
            </label>
            <label>Proyecto / obra
              <input type="text" name="proyecto" placeholder="Ej. Edificio El Solar" data-c="proyecto" />
            </label>
            <label>Teléfono / WhatsApp *
              <input type="tel" name="telefono" required autocomplete="tel" data-c="telefono" />
            </label>
            <label>Correo *
              <input type="email" name="email" required autocomplete="email" data-c="email" />
            </label>
            <label>Empresa (opcional)
              <input type="text" name="empresa" autocomplete="organization" data-c="empresa" />
            </label>
          </div>

          <div class="cotz-entrega">
            <span class="cotz-entrega__label">Modalidad de entrega</span>
            <div class="cotz-pills">
              <button type="button" class="cotz-pill cotz-pill--active" data-entrega="obra" aria-pressed="true">Despacho a obra</button>
              <button type="button" class="cotz-pill" data-entrega="planta" aria-pressed="false">Recoge en planta</button>
            </div>
            <input type="hidden" name="entrega" value="obra" data-entrega-value />
          </div>

          <div class="cotz-fields" data-obra-fields>
            <p class="cotz-flete-nota">
              El <b>flete no está incluido</b> en la cotización preliminar; lo calcula nuestro
              equipo comercial según la ubicación de tu obra.
            </p>
            <label class="cotz-full cotz-ac">Dirección de la obra *
              <input
                type="text"
                name="direccion"
                placeholder="Escribe el lugar y elígelo de la lista…"
                autocomplete="off"
                data-c="direccion"
                data-req-obra
                data-direccion
              />
              <ul class="cotz-ac__list" data-ac-list hidden></ul>
              <span class="cotz-hint">Escribe el lugar y elígelo de la lista (como Google Maps). El municipio y el departamento se llenan solos.</span>
            </label>
            <label>Municipio / ciudad
              <input type="text" name="municipio" autocomplete="address-level2" data-c="municipio" />
            </label>
            <label>Departamento
              <select name="departamento" data-c="departamento">
                {DEPARTAMENTOS.map((d) => <option value={d} selected={d === "Antioquia"}>{d}</option>)}
              </select>
            </label>
            <div class="cotz-map cotz-full" data-map-wrap hidden>
              <div class="cotz-map__actions">
                <button type="button" class="cotz-map__toggle" data-map-toggle>📍 Editar ubicación en el mapa</button>
                <span class="cotz-map__coords" data-map-coords></span>
              </div>
              <div class="cotz-map__canvas" data-map-canvas hidden></div>
              <p class="cotz-hint">Haz clic o arrastra el pin para ajustar el punto exacto. Usa la capa <b>Satélite</b> para ver accesos y vías destapadas.</p>
            </div>
            <input type="hidden" name="lat" data-lat />
            <input type="hidden" name="lng" data-lng />
          </div>
        </section>

        <label class="cotz-card cotz-notas">Notas para el equipo (opcional)
          <textarea name="mensaje" rows="3" placeholder="Fechas, detalles de obra, preguntas..." data-c="mensaje"></textarea>
        </label>

        <div class="cotz-submit">
          <p class="cotz-actions__title">¿Cotización lista? Elige cómo continuar:</p>
          <div class="cotz-actions">
            <button type="button" class="btn btn--outline cotz-action" data-action-print>
              <span aria-hidden="true">🖨️</span> Imprimir / Guardar PDF
            </button>
            <button type="button" class="btn btn--outline cotz-action" data-action-whatsapp>
              <span aria-hidden="true">💬</span> Enviar al asesor por WhatsApp
            </button>
            <button type="submit" class="btn btn--primary cotz-action" data-action-email>
              <span aria-hidden="true">✉️</span> Enviar por correo
            </button>
          </div>
          <p class="cotz-estado" data-envio-estado role="status" aria-live="polite" hidden></p>
          <p class="cotz-legal">
            El flete no está incluido; nuestro equipo lo calcula según tu ubicación y te contacta.
            Al enviar aceptas el tratamiento de tus datos con fines comerciales.
          </p>
        </div>
      </div>

      <!-- ============ COLUMNA DERECHA: DOCUMENTO ============ -->
      <div class="cotz__doc-col">
        <div class="cotz-doc" data-doc>
          <header class="cotz-doc__top">
            <img src={logos.headerWhite} alt="Clay House" class="cotz-doc__logo" width="360" height="70" />
            <div class="cotz-doc__badge">
              <span>COTIZACIÓN</span>
              <strong>PRELIMINAR</strong>
              <span data-doc-fecha></span>
            </div>
          </header>

          <div class="cotz-doc__body">
            <div class="cotz-doc__datos">
              <div>
                <p><span>Cliente:</span> <b data-doc-nombre>Pendiente</b></p>
                <p><span>Teléfono:</span> <b data-doc-tel>Pendiente</b></p>
                <p><span>Correo:</span> <b data-doc-email>Pendiente</b></p>
              </div>
              <div>
                <p><span>Proyecto:</span> <b data-doc-proyecto>Pendiente</b></p>
                <p><span>Entrega:</span> <b data-doc-entrega>Despacho a obra</b></p>
                <p><span>Ubicación:</span> <b data-doc-ubicacion>Pendiente</b></p>
              </div>
            </div>

            <table class="cotz-doc__tabla">
              <thead>
                <tr><th>Producto</th><th class="num">Cant.</th><th class="num">V. ref.</th><th class="num">Valor</th></tr>
              </thead>
              <tbody data-doc-lineas>
                <tr><td colspan="4" class="cotz-doc__vacio">Agrega productos para verlos aquí.</td></tr>
              </tbody>
            </table>

            <div class="cotz-doc__totales">
              <div class="cotz-doc__total-row"><span>Estimado de material</span><b data-doc-material>—</b></div>
              <div class="cotz-doc__total-row cotz-doc__total-row--flete"><span>Flete</span><b>No incluido</b></div>
            </div>

            <div class="cotz-doc__notas">
              <p><b>Cotización preliminar.</b> El flete <b>no está incluido</b> y se calcula aparte según la ubicación de la obra. Los precios son de referencia; el valor final lo confirma nuestro equipo con la cotización oficial.</p>
            </div>

            <footer class="cotz-doc__pie">
              <b>Clay House</b> · {site.phone} · {site.email}
            </footer>
          </div>
        </div>
      </div>
    </form>
  </section>

  {/* De acá clona el navegador las líneas siguientes: el mismo marcado que la primera. */}
  <template data-linea-template>
    <LineaDeCotizacion />
  </template>

  <script type="application/json" data-cotz-config set:html={cotizadorJson} />
  <script>
    import "@/scripts/cotizacion";
  </script>
</BaseLayout>

<style is:global>
  /* Global (no scoped): muchas partes de esta página —tarjetas de producto,
     líneas, filas del documento, sugerencias— se generan por JS con innerHTML
     y NO llevan el atributo de scope de Astro. Todas las clases usan prefijo
     `.cotz` y este CSS solo se incluye en /cotizacion, así que no colisiona. */
  .cotz { padding: 7rem 0 4rem; }
  .cotz__head { max-width: 48rem; margin-bottom: 2rem; }
  .cotz__eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-terracota); }
  .cotz__head h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); color: var(--color-chocolate); margin: 0.15rem 0 0.6rem; }
  .cotz__lead { color: #5c534f; }
  .cotz__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
  .cotz__form { display: flex; flex-direction: column; gap: 1.5rem; }

  .cotz-card { background: var(--color-white); border: 1px solid rgba(71, 36, 16, 0.1); border-radius: var(--radius-md); padding: 1.5rem; }
  .cotz-card__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .cotz-card h2 { font-size: 1.05rem; color: var(--color-chocolate); margin: 0 0 1rem; }
  .cotz-card__head h2 { margin: 0; }
  .cotz-add { padding: 0.45rem 0.9rem; font-size: 0.85rem; font-weight: 600; color: var(--color-terracota); background: var(--color-bg); border: 1px solid rgba(124, 72, 44, 0.3); border-radius: 999px; cursor: pointer; }
  .cotz-add:hover { background: var(--color-terracota); color: #fff; border-color: var(--color-terracota); }

  .cotz-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .cotz-fields[hidden] { display: none; } /* [hidden] necesita ganarle a display:grid */
  .cotz-full { grid-column: 1 / -1; }
  .cotz label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.8rem; font-weight: 600; color: var(--color-chocolate); }
  .cotz input, .cotz select, .cotz textarea { font: inherit; font-weight: 400; padding: 0.55rem 0.7rem; border: 1px solid rgba(71, 36, 16, 0.2); border-radius: var(--radius-sm); background: var(--color-bg); width: 100%; }

  .cotz-entrega { margin: 1.25rem 0; }
  .cotz-entrega__label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--color-chocolate); margin-bottom: 0.45rem; }
  .cotz-pills { display: flex; gap: 0.5rem; }
  .cotz-pill { padding: 0.5rem 1rem; border: 1px solid rgba(71, 36, 16, 0.2); border-radius: 999px; background: var(--color-white); color: var(--color-chocolate); font-weight: 500; cursor: pointer; }
  .cotz-pill--active { background: var(--color-terracota); border-color: var(--color-terracota); color: #fff; }
  .cotz-flete-nota { grid-column: 1 / -1; margin: 0; font-size: 0.82rem; color: #5c534f; background: rgba(124, 72, 44, 0.06); border-left: 3px solid var(--color-terracota); padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
  /* Son las instrucciones de cómo poner la dirección de obra: a 0,5 de opacidad daban
     2,98:1 y es texto chico. A 0,78 llegan a 5,3. */
  .cotz-error { display: block; margin-top: 0.3rem; font-size: 0.75rem; font-weight: 600; color: #a3311f; }
  .cotz-hint { font-size: 0.72rem; font-weight: 400; color: rgba(71, 36, 16, 0.78); }
  .cotz-ac { position: relative; }
  .cotz-ac__list { list-style: none; margin: 0.35rem 0 0; padding: 0.25rem; border: 1px solid rgba(71, 36, 16, 0.15); border-radius: var(--radius-sm); background: var(--color-white); box-shadow: 0 8px 20px rgba(71, 36, 16, 0.12); max-height: 14rem; overflow-y: auto; }
  .cotz-ac__list li { padding: 0.5rem 0.6rem; font-size: 0.8rem; font-weight: 400; color: var(--color-chocolate); border-radius: 4px; cursor: pointer; line-height: 1.3; }
  .cotz-ac__list li:hover { background: var(--color-bg); }
  .cotz-map { display: flex; flex-direction: column; gap: 0.5rem; }
  .cotz-map__actions { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .cotz-map__toggle { padding: 0.45rem 0.85rem; font: inherit; font-size: 0.8rem; font-weight: 600; color: var(--color-chocolate); background: var(--color-white); border: 1px solid rgba(71, 36, 16, 0.2); border-radius: 999px; cursor: pointer; width: auto; }
  .cotz-map__toggle:hover { border-color: var(--color-terracota); color: var(--color-terracota); }
  .cotz-map__coords { font-size: 0.75rem; color: rgba(71, 36, 16, 0.6); }
  .cotz-map__canvas { width: 100%; height: 16rem; border-radius: var(--radius-md); border: 1px solid rgba(71, 36, 16, 0.12); overflow: hidden; }

  .cotz-linea { border: 1px solid rgba(71, 36, 16, 0.1); border-radius: var(--radius-sm); padding: 0.85rem; margin-bottom: 0.85rem; background: var(--color-bg); }
  .cotz-linea__u { font-size: 0.8rem; color: #5c534f; align-self: center; }
  .cotz-linea__del { flex: none; width: 2rem; height: 2rem; border: 1px solid rgba(71, 36, 16, 0.15); border-radius: 50%; background: var(--color-white); color: var(--color-terracota); font-size: 1.15rem; line-height: 1; cursor: pointer; }
  .cotz-linea__del:hover { background: var(--color-terracota); color: #fff; }

  /* Selector visual de producto (grid con imágenes, tipo ERP) */
  .cotz-picker__hint { margin: 0 0 0.6rem; font-size: 0.8rem; font-weight: 600; color: var(--color-chocolate); }
  .cotz-picker__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.75rem;
    max-height: 24rem;
    overflow-y: auto;
    padding: 0.15rem;
  }
  .cotz-cardp {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.45rem;
    padding: 0.55rem;
    background: var(--color-white);
    border: 1px solid rgba(71, 36, 16, 0.1);
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .cotz-cardp:hover { border-color: var(--color-terracota); box-shadow: 0 6px 16px rgba(71, 36, 16, 0.12); transform: translateY(-1px); }
  .cotz-cardp img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: var(--radius-sm);
    background: #fff;
  }
  .cotz-cardp__name {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-chocolate);
    line-height: 1.25;
    min-height: 1.95em;
  }
  /* 0,45 de opacidad daba 2,65:1 sobre blanco, y es el código con el que el cliente
     identifica lo que pide. Subido a 0,74 llega a 4,85. */
  .cotz-cardp__code { display: block; margin-top: 0.1rem; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.04em; color: rgba(71, 36, 16, 0.74); }

  /* Producto seleccionado */
  .cotz-sel__head { display: flex; align-items: center; gap: 0.65rem; }
  .cotz-sel__thumb { width: 3rem; height: 3rem; object-fit: cover; border-radius: var(--radius-sm); background: #f3ece7; }
  .cotz-sel__info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .cotz-sel__info b { font-size: 0.9rem; color: var(--color-chocolate); }
  .cotz-sel__code { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.03em; color: var(--color-terracota); }
  .cotz-sel__cambiar { padding: 0.35rem 0.75rem; font-size: 0.75rem; font-weight: 600; color: var(--color-terracota); background: var(--color-white); border: 1px solid rgba(124, 72, 44, 0.3); border-radius: 999px; cursor: pointer; }
  .cotz-sel__cambiar:hover { background: var(--color-terracota); color: #fff; }
  .cotz-sel__fields { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: end; margin-top: 0.75rem; }
  .cotz-sel__fields label { flex: 1; min-width: 6rem; }
  .cotz-linea__qty { max-width: 6rem; }

  .cotz-notas { display: flex; flex-direction: column; gap: 0.4rem; }
  .cotz-submit { text-align: center; }
  .cotz-actions__title { margin: 0 0 0.75rem; font-size: 0.9rem; font-weight: 700; color: var(--color-chocolate); text-align: left; }
  .cotz-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .cotz-action { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; padding: 0.75rem 1rem; font-size: 0.85rem; }
  .cotz-action[data-action-email] { grid-column: 1 / -1; }
  /* Aviso de registro. Tres tonos: enviando, recibido y error — el error tiene
     que leerse sin depender del color, por eso también cambia el peso. */
  .cotz-estado {
    margin: .75rem 0 0;
    padding: .7rem .9rem;
    border-radius: 8px;
    font-size: .92rem;
    line-height: 1.45;
    border: 1px solid var(--color-arena, #ddd2c4);
    background: var(--color-crema, #faf7f2);
    color: var(--color-chocolate, #3a2a20);
  }
  .cotz-estado[data-tono="ok"] {
    border-color: #2f7a5a;
    background: #e9f3ee;
    color: #1d5740;
  }
  .cotz-estado[data-tono="error"] {
    border-color: #a3301c;
    background: #fbeae6;
    color: #8a2816;
    font-weight: 600;
  }

  /* Los grises de este bloque y del documento imprimible daban entre 3,1 y 3,7 sobre
     blanco. Es la cotización que el cliente guarda en PDF: tiene que leerse impresa. */
  .cotz-legal { margin-top: 0.7rem; font-size: 0.78rem; color: #6f6660; text-align: left; }
  .cotz-legal--warn { color: var(--color-terracota); }

  /* Imprimir / Guardar PDF: solo el documento de la derecha. */
  @media print {
    .header, .footer, .whatsapp-fab, .cotz__head, .cotz__form, .cotz-actions, .cotz-actions__title, .cotz-legal { display: none !important; }
    .cotz { padding: 0 !important; }
    .cotz__grid { display: block !important; }
    .cotz__doc-col { width: 100% !important; max-width: 100% !important; }
    .cotz-doc { box-shadow: none !important; border: none !important; border-radius: 0 !important; }
    .cotz-doc, .cotz-doc * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    @page { margin: 12mm; }
  }

  /* ---- Documento (columna derecha) ---- */
  .cotz__doc-col { position: sticky; top: 6rem; }
  .cotz-doc { border: 1px solid rgba(71, 36, 16, 0.14); border-radius: var(--radius-md); overflow: hidden; background: #fff; box-shadow: 0 10px 30px rgba(71, 36, 16, 0.07); }
  .cotz-doc__top { background: var(--color-chocolate); color: #fff; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .cotz-doc__logo { height: 26px; width: auto; }
  .cotz-doc__badge { text-align: right; border: 1px solid rgba(255,255,255,0.3); border-radius: var(--radius-sm); padding: 0.5rem 0.8rem; font-size: 0.65rem; letter-spacing: 0.08em; line-height: 1.5; }
  .cotz-doc__badge strong { display: block; font-size: 0.9rem; letter-spacing: 0.04em; }
  .cotz-doc__body { padding: 1.5rem; }
