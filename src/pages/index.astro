---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { getFeaturedProducts, getVisibleProducts } from "@/data/products";
import { assetUrl } from "@/utils/paths";
import { logos } from "@/utils/media";
import { catalogCategories, getCatalogCategoryHref } from "@/data/catalogCategories";
import { getCatalogCoverImage } from "@/utils/catalog";
import HomeFeaturedProjects from "@/components/HomeFeaturedProjects.astro";
import ClientLogoBand from "@/components/ClientLogoBand.astro";
import CatalogProductCard from "@/components/catalog/CatalogProductCard.astro";
import "@/styles/catalog-page.css";
import ReviewCard from "@/components/ReviewCard.astro";
import StarRating from "@/components/StarRating.astro";
import { getFeaturedReviews, getAverageRating } from "@/data/reviews";
import "@/styles/reviews-page.css";
import { Image, getImage } from "astro:assets";
import heroImageSrc from "@/assets/images/hero/DSC08862.jpg";
import redescubrePergamino from "@/assets/images/redescubre/pergamino.jpg";
import redescubreMundoVerde from "@/assets/images/redescubre/mundo-verde.jpg";

const heroOptimized = await getImage({ src: heroImageSrc, format: "avif", width: 1920 });

const featured = getFeaturedProducts();
/** Para los contadores por categoría: no debe incluir los desactivados. */
const visibleProducts = getVisibleProducts();

/** Showcase de las 3 variantes de Romano para la sección destacada de home. */
const romanoShowcase = [
  {
    id: "natural",
    label: "Natural",
    image: assetUrl("/images/products/romano/natural/Romano Natural.webp"),
  },
  {
    id: "matizado-claro",
    label: "Matizado claro",
    image: assetUrl("/images/products/romano/matizado claro/Romano Matizado.webp"),
  },
  {
    id: "matizado-oscuro",
    label: "Matizado oscuro",
    image: assetUrl("/images/products/romano/matizado-oscuro/Romano Matizado Oscuro.webp"),
  },
];

const categories = catalogCategories.map((cat) => {
  const count = visibleProducts.filter((p) => p.category === cat.id).length;
  return {
    id: cat.id,
    title: cat.title,
    href: getCatalogCategoryHref(cat.id),
    image: getCatalogCoverImage(cat),
    count,
    badge: cat.id === "Fachadas" ? "Más vendido" : null,
  };
});

const heroImage = heroOptimized.src;
const processVideoId = "vO0brjwa7So";
const processVideoEmbedUrl = `https://www.youtube-nocookie.com/embed/${processVideoId}`;
const processLogo = logos.header;
const pergaminoOpt = await getImage({ src: redescubrePergamino, format: "webp", width: 1200 });
const mundoVerdeOpt = await getImage({ src: redescubreMundoVerde, format: "webp", width: 1200 });

const featuredProjects = [
  {
    src: assetUrl(
      "/images/products/romano/proyectos/edificio-el-solar/edificio-el-solar-01.jpg"
    ),
    alt: "Edificio El Solar en Medellín con fachada en Ladrillo Romano.",
    label: "Edificio El Solar",
  },
  {
    src: assetUrl(
      "/images/products/romano/proyectos/edificio-el-federal/edificio-el-federal-01.jpg"
    ),
    alt: "Edificio El Federal en El Poblado con fachada en Ladrillo Romano.",
    label: "Edificio El Federal",
  },
  {
    src: assetUrl(
      "/images/products/romano/proyectos/ushuaya/ushuaya-03.jpg"
    ),
    alt: "Edificio Ushuaya con fachada en Ladrillo Romano y balcones aterrazados.",
    label: "Ushuaya",
  },
  {
    src: pergaminoOpt.src,
    alt: "Pergamino Café con ladrillo Clay House",
    label: "Pergamino",
  },
  {
    src: mundoVerdeOpt.src,
    alt: "Mundo Verde con ladrillo Clay House",
    label: "Mundo Verde",
  },
  {
    src: assetUrl("/images/home/starbucks-fachada.webp"),
    alt: "Fachada Starbucks con enchape Romano Clay House",
    label: "Starbucks",
  },
  {
    src: assetUrl(
      "/images/products/enchape-romano/proyectos/dos-santos/dos-santos-01.jpg"
    ),
    alt: "Dos Santos Cantina con enchape Romano",
    label: "Dos Santos",
  },
];

const services = [
  {
    title: "Cotice en 24 horas",
    text: "Presupuesto detallado según volumen, acabado y obra. Sin demoras.",
    icon: "quote",
  },
  {
    title: "Sin sorpresas en obra",
    text: "Asesoría técnica en especificación, instalación y mantenimiento.",
    icon: "advice",
  },
  {
    title: "Entrega 4–8 semanas",
    text: "Producción artesanal con plazos honestos. El barro necesita su tiempo.",
    icon: "time",
  },
  {
    title: "Stock para urgencias",
    text: "Referencias en inventario listas para despachar a obras críticas.",
    icon: "stock",
  },
  {
    title: "Visite el taller",
    text: "Conozca Amagá y las referencias en mano con cita previa.",
    icon: "visit",
  },
] as const;

const featuredReviews = getFeaturedReviews(3);
const reviewsAverage = getAverageRating();
---

<BaseLayout
  title="Ladrillera en Amagá: ladrillo, enchapes y teja"
  description={site.description}
  preloadImage={heroOptimized.src}
  preloadImageType="image/avif"
>
  <section class="hero">
    <div class="hero__media">
      <Image
        src={heroImageSrc}
        alt="Edificio en ladrillo con balcones y vegetación — Clay House"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        width={1920}
        height={1280}
      />
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content container">
      <h1 class="hero__title">Ladrillo, enchapes y teja hechos a mano en Amagá.</h1>
      <p class="hero__sub">Reinventando el barro desde 1965.</p>
      <div class="hero__actions">
        <a href="/productos" class="btn btn--light">Ver catálogo</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section-title-solo">nuestro ladrillo insignia</h2>
      <div class="romano-showcase">
        {
          romanoShowcase.map((variant) => (
            <a href={`/productos/romano?color=${variant.id}`} class="romano-showcase__card">
              <div class="romano-showcase__media">
                <img
                  src={variant.image}
                  alt={`Ladrillo Romano ${variant.label}`}
                  width="800"
                  height="800"
                  loading="lazy"
                />
              </div>
              <div class="romano-showcase__body">
                <p class="romano-showcase__eyebrow">Ladrillo Romano</p>
                <h3 class="romano-showcase__title">{variant.label}</h3>
                <span class="romano-showcase__link">Ver ficha →</span>
              </div>
            </a>
          ))
        }
      </div>
      <p class="text-center" style="margin-top: 2.5rem">
        <a href="/productos" class="btn btn--primary">Ver todos los productos</a>
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section-title-solo">productos</h2>
      <div class="grid-categories">
        {
          categories.map((cat) => (
            <a href={cat.href} class="card category-card">
              {cat.badge && <span class="category-card__badge">{cat.badge}</span>}
              <div class="card__img">
                <img src={cat.image} alt="" width="600" height="600" loading="lazy" />
              </div>
              <div class="category-card__body">
                <h3>{cat.title}</h3>
                <span class="category-card__count">{cat.count} referencia{cat.count === 1 ? "" : "s"}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ClientLogoBand />

  <section class="section">
    <div class="container split-feature split-feature--rounded">
      <div class="split-feature__card split-feature__card--chocolate">
        <p class="split-feature__eyebrow">Proyectos destacados</p>
        <h2 class="split-feature__title">Redescubre<br />el ladrillo</h2>
        <p class="split-feature__text">
          Enchapes y fachadas que elevan espacios comerciales y residenciales: el mismo material
          artesanal de Clay House, visto en obra real con carácter y durabilidad.
        </p>
        <a href="/productos/enchape-romano" class="split-feature__link" aria-label="Ver enchape Romano">
          <span class="arrow-circle" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="split-feature__media split-feature__media--carousel" tabindex="0">
        <HomeFeaturedProjects slides={featuredProjects} />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split-feature split-feature--floating split-feature--reverse">
      <article class="split-feature__panel split-feature__panel--media split-feature__media--video" data-video-wrap>
        <div class="video-shell">
          <div class="video-shell__screen">
            <div class="video-poster" data-video-poster>
              <img src={processLogo} alt="Clay House" class="video-poster__logo" width="280" height="61" />
              <button type="button" class="video-poster__play" aria-label="Reproducir video del proceso" data-video-play>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7L8 5z"></path>
                </svg>
              </button>
            </div>
            <div class="video-frame" data-video-frame data-embed-url={processVideoEmbedUrl} aria-live="polite"></div>
          </div>
        </div>
        <a href="https://www.youtube.com/@clayhouse-v1x" class="video-channel-link" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/>
          </svg>
          Ver más Shorts en YouTube
        </a>
      </article>

      <article class="split-feature__panel split-feature__panel--copy">
        <p class="split-feature__eyebrow">El proceso</p>
        <h2 class="split-feature__title">Tradición que proyecta futuro</h2>
        <p class="split-feature__text">
          Arcilla extraída cerca, formada en planta y cocida bajo control. Cada lote conserva la
          consistencia que pide la arquitectura y el carácter natural del barro.
        </p>
        <a href="/nosotros" class="split-feature__link" aria-label="Conocer el proceso">
          <span class="arrow-circle" aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section-title-solo">reseñas</h2>
      {
        featuredReviews.length > 0 && (
          <p class="text-center reviews-hero__inline-wrap">
            <StarRating rating={reviewsAverage} size="sm" />
            <span>{reviewsAverage} de 5 · promedio de clientes</span>
          </p>
        )
      }
      {
        featuredReviews.length > 0 && (
          <div class="reviews-teaser">
            {featuredReviews.map((review) => (
              <ReviewCard review={review} />
            ))}
          </div>
        )
      }
      <p class="reviews-teaser__cta">
        <a href="/resenas/" class="btn btn--primary">Ver todas las reseñas</a>
        <a href="/resenas/#dejar-resena" class="btn btn--ghost">Dejar mi reseña</a>
      </p>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <p class="eyebrow">Por qué Clay House</p>
      <h2>Trabajamos como ustedes lo necesitan</h2>
      <p class="text-muted services-section__lead">
        Cinco compromisos concretos para que el ladrillo entre a la obra sin sorpresas.
      </p>
      <div class="services-grid">
        {
          services.map((s) => (
            <div class="service">
              <div class="service__icon" aria-hidden="true">
                {s.icon === "quote" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" />
                    <rect x="9" y="3" width="6" height="4" rx="1" />
                    <path d="M9 12h6M9 16h4" />
                  </svg>
                )}
                {s.icon === "advice" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 3l2.4 4.8L20 9l-4 3.9.9 5.6L12 16.5 7.1 18.5 8 12.9 4 9l5.6-1.2L12 3z" />
                  </svg>
                )}
                {s.icon === "time" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                )}
                {s.icon === "stock" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 7h16v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7z" />
                    <path d="M4 7l2-3h12l2 3M12 11v4" />
                  </svg>
                )}
                {s.icon === "visit" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 10.5L12 4l9 6.5V20a1 1 0 01-1 1h-5v-7H9v7H4a1 1 0 01-1-1v-9.5z" />
                  </svg>
                )}
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>


</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-video-wrap]").forEach((wrap) => {
    const poster = wrap.querySelector<HTMLElement>("[data-video-poster]");
    const frame = wrap.querySelector<HTMLElement>("[data-video-frame]");
    const playBtn = wrap.querySelector<HTMLButtonElement>("[data-video-play]");
    if (!poster || !frame) return;

    const embedBase = frame.dataset.embedUrl;
    if (!embedBase) return;

    const startPlayback = () => {
      poster.classList.add("video-poster--hidden");
      if (frame.querySelector("iframe")) return;
      const iframe = document.createElement("iframe");
      const separator = embedBase.includes("?") ? "&" : "?";
      iframe.src = `${embedBase}${separator}autoplay=1&rel=0&modestbranding=1&controls=1&playsinline=1`;
      iframe.title = "Video del proceso Clay House";
      iframe.setAttribute(
        "allow",
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      );
      iframe.allowFullscreen = true;
      iframe.loading = "lazy";
      frame.appendChild(iframe);
    };

    playBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      startPlayback();
    });
    poster.addEventListener("click", startPlayback);
  });
</script>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    min-height: 110vh;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: -5.25rem;
    padding-top: 5.25rem;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.4) 70%),
      linear-gradient(to top, var(--color-bg) 0%, transparent 18%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(6rem, 14vh, 10rem);
  }

  .hero__title {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #ffffff;
    font-weight: 700;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .hero__sub {
    margin: 1.5rem 0 0;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 400;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.92);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 75vh;
    }

    .hero__title {
      font-size: clamp(2.25rem, 9vw, 3.5rem);
    }

    .hero__sub {
      margin-top: 1rem;
      font-size: clamp(1rem, 4vw, 1.25rem);
    }

    .hero__actions {
      margin-top: 2rem;
    }
  }

  .btn--light {
    background: var(--color-bg);
    color: var(--color-chocolate);
    border: 1px solid var(--color-bg);
  }

  .btn--light:hover {
    background: transparent;
    color: var(--color-bg);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-bg);
    border: 1px solid rgba(255, 251, 249, 0.5);
  }

  .btn--ghost:hover {
    background: var(--color-bg);
    color: var(--color-chocolate);
  }

  /* ---------------- SPLIT FEATURE (bloque + media) ---------------- */
  .split-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 0;
    align-items: stretch;
    min-height: 28rem;
  }

  .split-feature--rounded {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(71, 36, 16, 0.1);
  }

  .split-feature--rounded :global(.featured-projects__viewport) {
    border-radius: calc(var(--radius-lg) - 0.5rem);
  }

  .split-feature--reverse > .split-feature__card {
    order: 2;
  }

  .split-feature--reverse > .split-feature__media,
  .split-feature--reverse > .split-feature__panel--media {
    order: 1;
  }

  .split-feature--reverse > .split-feature__panel--copy {
    order: 2;
  }

  /* Tarjetas flotantes (proceso) */
  .split-feature--floating {
    gap: 1.25rem;
    min-height: auto;
    align-items: stretch;
  }

  .split-feature__panel {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background: var(--color-bg);
    border: 1px solid rgba(71, 36, 16, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 12px rgba(71, 36, 16, 0.06);
    overflow: hidden;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .split-feature__panel:hover {
    transform: translateY(-6px);
    border-color: rgba(124, 72, 44, 0.18);
    box-shadow: 0 18px 48px rgba(71, 36, 16, 0.12);
  }

  .split-feature__panel--copy {
    justify-content: center;
    gap: 1.15rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-chocolate);
  }

  .split-feature__panel--copy .split-feature__eyebrow {
    color: var(--color-terracota);
    opacity: 1;
  }

  .split-feature__panel--copy .split-feature__title {
    color: var(--color-chocolate);
    font-weight: 600;
  }

  .split-feature__panel--copy .split-feature__text {
    color: var(--color-text-muted);
  }

  .split-feature__panel--copy .arrow-circle {
    border-color: var(--color-terracota);
    color: var(--color-terracota);
  }

  .split-feature__panel--copy .split-feature__link:hover .arrow-circle {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-bg);
    transform: translateX(4px);
  }

  .split-feature__panel--media {
    padding: 0;
    min-height: 26rem;
    position: relative;
  }

  .split-feature__panel--media.split-feature__media--video {
    background: var(--color-chocolate);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: clamp(2rem, 4vw, 3rem) 1.5rem;
    min-height: 0;
  }

  .split-feature__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--color-chocolate);
  }

  .split-feature__card--chocolate {
    background: var(--color-chocolate);
    color: var(--color-bg);
  }

  .split-feature__card--chocolate .split-feature__eyebrow,
  .split-feature__card--chocolate .split-feature__title,
  .split-feature__card--chocolate .split-feature__text {
    color: var(--color-bg);
  }

  .split-feature__card--terracota {
    background: var(--color-terracota);
    color: var(--color-bg);
  }

  .split-feature__card--terracota .split-feature__eyebrow,
  .split-feature__card--terracota .split-feature__title,
  .split-feature__card--terracota .split-feature__text {
    color: var(--color-bg);
  }

  .split-feature__card--cream {
    background: #f2ebe3;
    color: var(--color-chocolate);
  }

  .split-feature__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .split-feature__title {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 500;
  }

  .split-feature__text {
    margin: 0;
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.65;
  }

  .split-feature__link {
    display: inline-block;
    margin-top: 0.75rem;
    color: inherit;
  }

  .arrow-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 1.125rem;
    background: transparent;
    color: inherit;
    transition: transform 0.25s var(--ease), background 0.25s, color 0.25s;
  }

  .split-feature__card--chocolate .split-feature__link:hover .arrow-circle,
  .split-feature__card--terracota .split-feature__link:hover .arrow-circle {
    background: var(--color-bg);
    color: var(--color-chocolate);
    transform: translateX(4px);
  }

