---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { getFeaturedProducts, products } from "@/data/products";
import { assetUrl } from "@/utils/paths";
import { logos } from "@/utils/media";
import { catalogCategories, getCatalogCategoryHref } from "@/data/catalogCategories";
import { getCatalogCoverImage } from "@/utils/catalog";
import HomeFeaturedProjects from "@/components/HomeFeaturedProjects.astro";
import ClientLogoBand from "@/components/ClientLogoBand.astro";
import CatalogProductCard from "@/components/catalog/CatalogProductCard.astro";
import "@/styles/catalog-page.css";
import ReviewCard from "@/components/ReviewCard.astro";
import StarRating from "@/components/StarRating.astro";
import { getFeaturedReviews, getAverageRating } from "@/data/reviews";
import "@/styles/reviews-page.css";

const featured = getFeaturedProducts();

const categories = catalogCategories.map((cat) => {
  const count = products.filter((p) => p.category === cat.id).length;
  return {
    id: cat.id,
    title: cat.title,
    href: getCatalogCategoryHref(cat.id),
    image: getCatalogCoverImage(cat),
    count,
    badge: cat.id === "Fachadas" ? "Más vendido" : null,
  };
});

const heroImage = assetUrl(
  "/images/products/romano/proyectos/casa-retiro-matizado/Casa_ladrilloromano_Clayhouse (22).jpg"
);
const processVideoId = "vO0brjwa7So";
const processVideoEmbedUrl = `https://www.youtube-nocookie.com/embed/${processVideoId}`;
const processLogo = logos.header;
const featuredProjects = [
  {
    src: assetUrl("/images/home/starbucks-fachada.png"),
    alt: "Fachada Starbucks con enchape Romano Clay House",
    label: "Starbucks",
  },
  {
    src: assetUrl(
      "/images/products/romano/proyectos/casa-retiro-matizado/Casa_ladrilloromano_Clayhouse (22).jpg"
    ),
    alt: "Vivienda con fachada en Ladrillo Romano matizado",
    label: "Casa Retiro",
  },
  {
    src: assetUrl(
      "/images/products/romano/proyectos/Plaza de Mercado Envigado Romano/DSCF2720.jpg"
    ),
    alt: "Plaza de Mercado Envigado con Ladrillo Romano",
    label: "Plaza Envigado",
  },
  {
    src: assetUrl(
      "/images/products/enchape-romano/proyectos/dos-santos/Dos Santos - enchape_1.jpg"
    ),
    alt: "Dos Santos Cantina con enchape Romano",
    label: "Dos Santos",
  },
];

const services = [
  {
    title: "Cotice en 24 horas",
    text: "Presupuesto detallado según volumen, acabado y obra. Sin demoras.",
    icon: "quote",
  },
  {
    title: "Sin sorpresas en obra",
    text: "Asesoría técnica en especificación, instalación y mantenimiento.",
    icon: "advice",
  },
  {
    title: "Entrega 4–8 semanas",
    text: "Producción artesanal con plazos honestos. El barro necesita su tiempo.",
    icon: "time",
  },
  {
    title: "Stock para urgencias",
    text: "Referencias en inventario listas para despachar a obras críticas.",
    icon: "stock",
  },
  {
    title: "Visite el taller",
    text: "Conozca Amagá y las referencias en mano con cita previa.",
    icon: "visit",
  },
] as const;

const featuredReviews = getFeaturedReviews(3);
const reviewsAverage = getAverageRating();
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div class="hero__media">
      <img
        src={heroImage}
        alt="Fachada Clay House en ladrillo Romano matizado"
        width="1920"
        height="1280"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content container">
      <p class="hero__eyebrow">Starbucks · Plaza Envigado · Dos Santos · NTC 4205</p>
      <h1 class="hero__title">
        Una interpretación<br />neoartesanal<br />del barro cocido
      </h1>
      <p class="hero__lead">
        Ladrillos, pisos, tejas y enchapes hechos a mano en Amagá. Materiales atemporales,
        finos y duraderos para arquitectos y constructores.
      </p>
      <div class="hero__actions">
        <a href="/contacto" class="btn btn--light">Cotizar mi proyecto</a>
        <a href="/productos" class="btn btn--ghost">Ver catálogo</a>
      </div>
      <ul class="hero__trust" aria-label="Garantías">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12l4 4L19 6" />
          </svg>
          Respuesta en 24 horas
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12l4 4L19 6" />
          </svg>
          Muestras a su estudio
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12l4 4L19 6" />
          </svg>
          Asesoría técnica incluida
        </li>
      </ul>
    </div>
  </section>

  <ClientLogoBand />

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow text-center">Categorías</p>
      <h2 class="text-center">Materiales para cada aplicación</h2>
      <p class="text-center text-muted section-intro">
        Fachadas, pisos, tejas y enchapes en barro cocido.
      </p>
      <div class="grid-categories">
        {
          categories.map((cat) => (
            <a href={cat.href} class="card category-card">
              {cat.badge && <span class="category-card__badge">{cat.badge}</span>}
              <div class="card__img">
                <img src={cat.image} alt="" width="600" height="600" loading="lazy" />
              </div>
              <div class="category-card__body">
                <h3>{cat.title}</h3>
                <span class="category-card__count">{cat.count} referencia{cat.count === 1 ? "" : "s"}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow text-center">Inspiración</p>
      <h2 class="text-center">Productos destacados</h2>
      <div class="product-grid product-grid--featured">
        {featured.map((p) => <CatalogProductCard product={p} />)}
      </div>
      <p class="text-center" style="margin-top: 2.5rem">
        <a href="/productos" class="btn btn--primary">Ver todos los productos</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container split-feature split-feature--rounded">
      <div class="split-feature__card split-feature__card--chocolate">
        <p class="split-feature__eyebrow">Proyectos destacados</p>
        <h2 class="split-feature__title">Redescubre<br />el barro cocido</h2>
        <p class="split-feature__text">
          Enchapes y fachadas que elevan espacios comerciales y residenciales: el mismo material
          artesanal de Clay House, visto en obra real con carácter y durabilidad.
        </p>
        <a href="/productos/enchape-romano" class="split-feature__link" aria-label="Ver enchape Romano">
          <span class="arrow-circle" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="split-feature__media split-feature__media--carousel" tabindex="0">
        <HomeFeaturedProjects slides={featuredProjects} />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split-feature split-feature--floating split-feature--reverse">
      <article class="split-feature__panel split-feature__panel--media split-feature__media--video" data-video-wrap>
        <div class="video-shell">
          <div class="video-shell__screen">
            <div class="video-poster" data-video-poster>
              <img src={processLogo} alt="Clay House" class="video-poster__logo" width="280" height="61" />
              <button type="button" class="video-poster__play" aria-label="Reproducir video del proceso" data-video-play>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7L8 5z"></path>
                </svg>
              </button>
            </div>
            <div class="video-frame" data-video-frame data-embed-url={processVideoEmbedUrl} aria-live="polite"></div>
          </div>
        </div>
        <a href="https://www.youtube.com/@clayhouse-v1x" class="video-channel-link" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/>
          </svg>
          Ver más Shorts en YouTube
        </a>
      </article>

      <article class="split-feature__panel split-feature__panel--copy">
        <p class="split-feature__eyebrow">El proceso</p>
        <h2 class="split-feature__title">Tradición que proyecta futuro</h2>
        <p class="split-feature__text">
          Arcilla extraída cerca, formada en planta y cocida bajo control. Cada lote conserva la
          consistencia que pide la arquitectura y el carácter natural del barro.
        </p>
        <a href="/nosotros" class="split-feature__link" aria-label="Conocer el proceso">
          <span class="arrow-circle" aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow text-center">Clientes</p>
      <h2 class="text-center">Experiencias de compra</h2>
      <p class="text-center text-muted section-intro">
        Arquitectos y constructores que ya trabajaron con Clay House.
      </p>
      {
        featuredReviews.length > 0 && (
          <p class="text-center reviews-hero__inline-wrap">
            <StarRating rating={reviewsAverage} size="sm" />
            <span>{reviewsAverage} de 5 · promedio de clientes</span>
          </p>
        )
      }
      {
        featuredReviews.length > 0 && (
          <div class="reviews-teaser">
            {featuredReviews.map((review) => (
              <ReviewCard review={review} />
            ))}
          </div>
        )
      }
      <p class="reviews-teaser__cta">
        <a href="/reseñas/" class="btn btn--primary">Ver todas las reseñas</a>
        <a href="/reseñas/#dejar-resena" class="btn btn--ghost">Dejar mi reseña</a>
      </p>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <p class="eyebrow">Por qué Clay House</p>
      <h2>Trabajamos como ustedes lo necesitan</h2>
      <p class="text-muted services-section__lead">
        Cinco compromisos concretos para que el barro cocido entre a la obra sin sorpresas.
      </p>
      <div class="services-grid">
        {
          services.map((s) => (
            <div class="service">
              <div class="service__icon" aria-hidden="true">
                {s.icon === "quote" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" />
                    <rect x="9" y="3" width="6" height="4" rx="1" />
                    <path d="M9 12h6M9 16h4" />
                  </svg>
                )}
                {s.icon === "advice" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 3l2.4 4.8L20 9l-4 3.9.9 5.6L12 16.5 7.1 18.5 8 12.9 4 9l5.6-1.2L12 3z" />
                  </svg>
                )}
                {s.icon === "time" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                )}
                {s.icon === "stock" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 7h16v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7z" />
                    <path d="M4 7l2-3h12l2 3M12 11v4" />
                  </svg>
                )}
                {s.icon === "visit" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 10.5L12 4l9 6.5V20a1 1 0 01-1 1h-5v-7H9v7H4a1 1 0 01-1-1v-9.5z" />
                  </svg>
                )}
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta__inner">
      <div class="final-cta__copy">
        <p class="final-cta__eyebrow">Empiece su proyecto</p>
        <h2 class="final-cta__title">Cuéntenos qué necesita.<br />Le respondemos en 24 horas.</h2>
        <p class="final-cta__text">
          Cotización personalizada, fichas técnicas y caja de muestras en su estudio. Sin compromiso.
        </p>
        <ul class="final-cta__bullets">
          <li>Asesoría técnica de un especialista</li>
          <li>Muestras físicas enviadas a su oficina</li>
          <li>Entrega en obra entre 4 y 8 semanas</li>
        </ul>
      </div>
      <form
        class="final-cta__form"
        action="/contacto"
        method="get"
        aria-label="Inicio rápido de cotización"
      >
        <p class="final-cta__form-title">Inicie su cotización</p>
        <label>
          Nombre
          <input type="text" name="nombre" required placeholder="Su nombre" />
        </label>
        <label>
          Email
          <input type="email" name="email" required placeholder="correo@ejemplo.com" />
        </label>
        <label>
          Ciudad
          <input type="text" name="ciudad" required placeholder="Ciudad / País" />
        </label>
        <button type="submit" class="btn btn--light">Continuar mi cotización</button>
        <p class="final-cta__form-legal">
          Continuará en el formulario completo. También puede escribirnos por
          <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-video-wrap]").forEach((wrap) => {
    const poster = wrap.querySelector<HTMLElement>("[data-video-poster]");
    const frame = wrap.querySelector<HTMLElement>("[data-video-frame]");
    const playBtn = wrap.querySelector<HTMLButtonElement>("[data-video-play]");
    if (!poster || !frame) return;

    const embedBase = frame.dataset.embedUrl;
    if (!embedBase) return;

    const startPlayback = () => {
      poster.classList.add("video-poster--hidden");
      if (frame.querySelector("iframe")) return;
      const iframe = document.createElement("iframe");
      const separator = embedBase.includes("?") ? "&" : "?";
      iframe.src = `${embedBase}${separator}autoplay=1&rel=0&modestbranding=1`;
      iframe.title = "Video del proceso Clay House";
      iframe.setAttribute(
        "allow",
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      );
      iframe.allowFullscreen = true;
      iframe.loading = "lazy";
      frame.appendChild(iframe);
    };

    playBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      startPlayback();
    });
    poster.addEventListener("click", startPlayback);
  });
</script>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(4rem, 12vh, 8rem);
    margin-top: 0;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(71, 36, 16, 0.7) 0%,
      rgba(71, 36, 16, 0.35) 55%,
      rgba(71, 36, 16, 0.15) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    color: var(--color-bg);
    max-width: 48rem;
  }

  .hero__eyebrow {
    margin: 0 0 1.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bg);
    opacity: 0.85;
  }

  .hero__title {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-bg);
    font-weight: 500;
  }

  .hero__lead {
    max-width: 32rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    margin-bottom: 2.25rem;
    color: var(--color-bg);
    opacity: 0.92;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__trust {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.75rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-bg);
    opacity: 0.92;
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__trust svg {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
    color: var(--color-coral, #f99a91);
  }

  .btn--light {
    background: var(--color-bg);
    color: var(--color-chocolate);
    border: 1px solid var(--color-bg);
  }

  .btn--light:hover {
    background: transparent;
    color: var(--color-bg);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-bg);
    border: 1px solid rgba(255, 251, 249, 0.5);
  }

  .btn--ghost:hover {
    background: var(--color-bg);
    color: var(--color-chocolate);
  }

  /* ---------------- SPLIT FEATURE (bloque + media) ---------------- */
  .split-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 0;
    align-items: stretch;
    min-height: 28rem;
  }

  .split-feature--rounded {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(71, 36, 16, 0.1);
  }

  .split-feature--rounded :global(.featured-projects__viewport) {
    border-radius: calc(var(--radius-lg) - 0.5rem);
  }

  .split-feature--reverse > .split-feature__card {
    order: 2;
  }

  .split-feature--reverse > .split-feature__media,
  .split-feature--reverse > .split-feature__panel--media {
    order: 1;
  }

  .split-feature--reverse > .split-feature__panel--copy {
    order: 2;
  }

  /* Tarjetas flotantes (proceso) */
  .split-feature--floating {
    gap: 1.25rem;
    min-height: auto;
    align-items: stretch;
  }

  .split-feature__panel {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background: var(--color-bg);
    border: 1px solid rgba(71, 36, 16, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 12px rgba(71, 36, 16, 0.06);
    overflow: hidden;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .split-feature__panel:hover {
    transform: translateY(-6px);
    border-color: rgba(124, 72, 44, 0.18);
    box-shadow: 0 18px 48px rgba(71, 36, 16, 0.12);
  }

  .split-feature__panel--copy {
    justify-content: center;
    gap: 1.15rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-chocolate);
  }

  .split-feature__panel--copy .split-feature__eyebrow {
    color: var(--color-terracota);
    opacity: 1;
  }

  .split-feature__panel--copy .split-feature__title {
    color: var(--color-chocolate);
    font-weight: 600;
  }

  .split-feature__panel--copy .split-feature__text {
    color: var(--color-text-muted);
  }

  .split-feature__panel--copy .arrow-circle {
    border-color: var(--color-terracota);
    color: var(--color-terracota);
  }

  .split-feature__panel--copy .split-feature__link:hover .arrow-circle {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-bg);
    transform: translateX(4px);
  }

  .split-feature__panel--media {
    padding: 0;
    min-height: 26rem;
    position: relative;
  }

  .split-feature__panel--media.split-feature__media--video {
    background: var(--color-chocolate);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: clamp(2rem, 4vw, 3rem) 1.5rem;
    min-height: 0;
  }

  .split-feature__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--color-chocolate);
  }

  .split-feature__card--chocolate {
    background: var(--color-chocolate);
    color: var(--color-bg);
  }

  .split-feature__card--chocolate .split-feature__eyebrow,
  .split-feature__card--chocolate .split-feature__title,
  .split-feature__card--chocolate .split-feature__text {
    color: var(--color-bg);
  }

  .split-feature__card--terracota {
    background: var(--color-terracota);
    color: var(--color-bg);
  }

  .split-feature__card--terracota .split-feature__eyebrow,
  .split-feature__card--terracota .split-feature__title,
  .split-feature__card--terracota .split-feature__text {
    color: var(--color-bg);
  }

  .split-feature__card--cream {
    background: #f2ebe3;
    color: var(--color-chocolate);
  }

  .split-feature__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .split-feature__title {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 500;
  }

  .split-feature__text {
    margin: 0;
