---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { getFeaturedProducts } from "@/data/products";
import { getCatalogImage, getCatalogImageScale } from "@/data/productVariants";
import { assetUrl } from "@/utils/paths";
import { logos } from "@/utils/media";
import { catalogCategories, getCatalogCategoryHref } from "@/data/catalogCategories";
import { getCatalogCoverImage } from "@/utils/catalog";
import HomeFeaturedProjects from "@/components/HomeFeaturedProjects.astro";
import ClientLogoBand from "@/components/ClientLogoBand.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import StarRating from "@/components/StarRating.astro";
import { getFeaturedReviews, getAverageRating } from "@/data/reviews";
import "@/styles/reviews-page.css";

const featured = getFeaturedProducts();

const categories = catalogCategories.map((cat) => ({
  title: cat.title,
  href: getCatalogCategoryHref(cat.id),
  image: getCatalogCoverImage(cat),
}));

const heroImage = assetUrl(
  "/images/products/romano/proyectos/casa-retiro-matizado/Casa_ladrilloromano_Clayhouse (22).jpg"
);
const processVideo = assetUrl("/images/Videos/La tradición que construye el futuro.mp4");
const processLogo = logos.header;
const featuredProjects = [
  {
    src: assetUrl("/images/home/starbucks-fachada.png"),
    alt: "Fachada Starbucks con enchape Romano Clay House",
    label: "Starbucks",
  },
  {
    src: assetUrl(
      "/images/products/romano/proyectos/casa-retiro-matizado/Casa_ladrilloromano_Clayhouse (22).jpg"
    ),
    alt: "Vivienda con fachada en Ladrillo Romano matizado",
    label: "Casa Retiro",
  },
  {
    src: assetUrl(
      "/images/products/romano/proyectos/Plaza de Mercado Envigado Romano/DSCF2720.jpg"
    ),
    alt: "Plaza de Mercado Envigado con Ladrillo Romano",
    label: "Plaza Envigado",
  },
  {
    src: assetUrl(
      "/images/products/enchape-romano/proyectos/dos-santos/Dos Santos - enchape_1.jpg"
    ),
    alt: "Dos Santos Cantina con enchape Romano",
    label: "Dos Santos",
  },
];

const services = [
  {
    title: "Cotización personalizada",
    text: "Presupuesto según volumen, acabado y destino de obra.",
    icon: "quote",
  },
  {
    title: "Asesoría técnica",
    text: "Especificación, instalación y mantenimiento del barro cocido.",
    icon: "advice",
  },
  {
    title: "Tiempos de entrega",
    text: "Entre 4 y 8 semanas según referencia. El barro necesita su tiempo.",
    icon: "time",
  },
  {
    title: "Stock disponible",
    text: "Consulte referencias en inventario para proyectos urgentes.",
    icon: "stock",
  },
  {
    title: "Visita al taller",
    text: "Conozca Amagá, el taller y las referencias disponibles con cita previa.",
    icon: "visit",
  },
] as const;

const featuredReviews = getFeaturedReviews(3);
const reviewsAverage = getAverageRating();
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div class="hero__media">
      <img
        src={heroImage}
        alt="Fachada Clay House en ladrillo Romano matizado"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content container">
      <p class="hero__eyebrow">Clay House</p>
      <h1 class="hero__title">
        Una interpretación<br />neoartesanal<br />del barro cocido
      </h1>
      <p class="hero__lead">
        Ladrillos, pisos, tejas y enchapes hechos a mano en Amagá. Materiales atemporales,
        finos y duraderos para arquitectos y constructores.
      </p>
      <div class="hero__actions">
        <a href="/productos" class="btn btn--light">Descubrir el catálogo</a>
        <a href="/contacto" class="btn btn--ghost">Solicitar muestras</a>
      </div>
    </div>
  </section>

  <ClientLogoBand />

  <section class="section">
    <div class="container split-feature split-feature--rounded">
      <div class="split-feature__card split-feature__card--chocolate">
        <p class="split-feature__eyebrow">Proyectos destacados</p>
        <h2 class="split-feature__title">Redescubre<br />el barro cocido</h2>
        <p class="split-feature__text">
          Enchapes y fachadas que elevan espacios comerciales y residenciales: el mismo material
          artesanal de Clay House, visto en obra real con carácter y durabilidad.
        </p>
        <a href="/productos/enchape-romano" class="split-feature__link" aria-label="Ver enchape Romano">
          <span class="arrow-circle" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="split-feature__media split-feature__media--carousel" tabindex="0">
        <HomeFeaturedProjects slides={featuredProjects} />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow text-center">Categorías</p>
      <h2 class="text-center">Materiales para cada aplicación</h2>
      <p class="text-center text-muted section-intro">
        Fachadas, pisos, tejas y enchapes en barro cocido.
      </p>
      <div class="grid-categories">
        {
          categories.map((cat) => (
            <a href={cat.href} class="card">
              <div class="card__img">
                <img src={cat.image} alt="" loading="lazy" />
              </div>
              <h3>{cat.title}</h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split-feature split-feature--floating split-feature--reverse">
      <article class="split-feature__panel split-feature__panel--media split-feature__media--video" data-video-wrap>
        <div class="video-poster" data-video-poster>
          <img src={processLogo} alt="Clay House" class="video-poster__logo" width="280" height="61" />
          <button type="button" class="video-poster__play" aria-label="Reproducir video del proceso">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7L8 5z"></path>
            </svg>
          </button>
        </div>
        <video
          data-process-video
          src={processVideo}
          controls
          preload="metadata"
          playsinline
          aria-label="Video del proceso de fabricación Clay House"
        ></video>
      </article>

      <article class="split-feature__panel split-feature__panel--copy">
        <p class="split-feature__eyebrow">El proceso</p>
        <h2 class="split-feature__title">Tradición que proyecta futuro</h2>
        <p class="split-feature__text">
          Arcilla extraída cerca, formada en planta y cocida bajo control. Cada lote conserva la
          consistencia que pide la arquitectura y el carácter natural del barro.
        </p>
        <a href="/nosotros" class="split-feature__link" aria-label="Conocer el proceso">
          <span class="arrow-circle" aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow text-center">Inspiración</p>
      <h2 class="text-center">Productos destacados</h2>
      <div class="grid-3">
        {
          featured.map((p) => (
            <a href={`/productos/${p.slug}`} class="card">
              <div
                class="card__img"
                style={`--catalog-scale: ${getCatalogImageScale(p.slug)}`}
              >
                <img src={getCatalogImage(p.slug, p.image)} alt={p.name} loading="lazy" />
              </div>
              <p class="card__meta">{p.category}</p>
              <h3>{p.name}</h3>
              <p class="card__desc">{p.shortDescription}</p>
            </a>
          ))
        }
      </div>
      <p class="text-center" style="margin-top: 2.5rem">
        <a href="/productos" class="btn btn--primary">Ver todos los productos</a>
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow text-center">Clientes</p>
      <h2 class="text-center">Experiencias de compra</h2>
      <p class="text-center text-muted section-intro">
        Arquitectos y constructores que ya trabajaron con Clay House.
      </p>
      {
        featuredReviews.length > 0 && (
          <p class="text-center reviews-hero__inline-wrap">
            <StarRating rating={reviewsAverage} size="sm" />
            <span>{reviewsAverage} de 5 · promedio de clientes</span>
          </p>
        )
      }
      {
        featuredReviews.length > 0 && (
          <div class="reviews-teaser">
            {featuredReviews.map((review) => (
              <ReviewCard review={review} />
            ))}
          </div>
        )
      }
      <p class="reviews-teaser__cta">
        <a href="/reseñas/" class="btn btn--primary">Ver todas las reseñas</a>
        <a href="/reseñas/#dejar-resena" class="btn btn--ghost">Dejar mi reseña</a>
      </p>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <p class="eyebrow">Servicio</p>
      <h2>Pida muestras de nuestros colores</h2>
      <p class="text-muted services-section__lead">
        Enviamos cajas físicas a su estudio para especificar con el material en mano.
      </p>
      <div class="services-grid">
        {
          services.map((s) => (
            <div class="service">
              <div class="service__icon" aria-hidden="true">
                {s.icon === "quote" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" />
                    <rect x="9" y="3" width="6" height="4" rx="1" />
                    <path d="M9 12h6M9 16h4" />
                  </svg>
                )}
                {s.icon === "advice" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 3l2.4 4.8L20 9l-4 3.9.9 5.6L12 16.5 7.1 18.5 8 12.9 4 9l5.6-1.2L12 3z" />
                  </svg>
                )}
                {s.icon === "time" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                )}
                {s.icon === "stock" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 7h16v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7z" />
                    <path d="M4 7l2-3h12l2 3M12 11v4" />
                  </svg>
                )}
                {s.icon === "visit" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 10.5L12 4l9 6.5V20a1 1 0 01-1 1h-5v-7H9v7H4a1 1 0 01-1-1v-9.5z" />
                  </svg>
                )}
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))
        }
      </div>
      <p class="services-section__cta">
        <a href="/contacto" class="btn btn--primary">Solicitar muestras</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-video-wrap]").forEach((wrap) => {
    const video = wrap.querySelector<HTMLVideoElement>("[data-process-video]");
    const poster = wrap.querySelector<HTMLElement>("[data-video-poster]");
    const playBtn = wrap.querySelector<HTMLButtonElement>(".video-poster__play");
    if (!video || !poster) return;

    const hidePoster = () => poster.classList.add("video-poster--hidden");
    const showPoster = () => poster.classList.remove("video-poster--hidden");

    const startPlayback = () => {
      hidePoster();
      void video.play();
    };

    playBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      startPlayback();
    });
    poster.addEventListener("click", startPlayback);
    video.addEventListener("play", hidePoster);
    video.addEventListener("ended", showPoster);
    video.addEventListener("pause", () => {
      if (video.currentTime < 0.25) showPoster();
    });
  });
</script>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(4rem, 12vh, 8rem);
    margin-top: 0;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(71, 36, 16, 0.7) 0%,
      rgba(71, 36, 16, 0.35) 55%,
      rgba(71, 36, 16, 0.15) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    color: var(--color-bg);
    max-width: 48rem;
  }

  .hero__eyebrow {
    margin: 0 0 1.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bg);
    opacity: 0.85;
  }

  .hero__title {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-bg);
    font-weight: 500;
  }

  .hero__lead {
    max-width: 32rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    margin-bottom: 2.25rem;
    color: var(--color-bg);
    opacity: 0.92;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn--light {
    background: var(--color-bg);
    color: var(--color-chocolate);
    border: 1px solid var(--color-bg);
  }

  .btn--light:hover {
    background: transparent;
    color: var(--color-bg);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-bg);
    border: 1px solid rgba(255, 251, 249, 0.5);
  }

  .btn--ghost:hover {
    background: var(--color-bg);
    color: var(--color-chocolate);
  }

  /* ---------------- SPLIT FEATURE (bloque + media) ---------------- */
  .split-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 0;
    align-items: stretch;
    min-height: 28rem;
  }

  .split-feature--rounded {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(71, 36, 16, 0.1);
  }

  .split-feature--rounded :global(.featured-projects__viewport) {
    border-radius: calc(var(--radius-lg) - 0.5rem);
  }

  .split-feature--reverse > .split-feature__card {
    order: 2;
  }

  .split-feature--reverse > .split-feature__media,
  .split-feature--reverse > .split-feature__panel--media {
    order: 1;
  }

  .split-feature--reverse > .split-feature__panel--copy {
    order: 2;
  }

  /* Tarjetas flotantes (proceso) */
  .split-feature--floating {
    gap: 1.25rem;
    min-height: auto;
    align-items: stretch;
  }

  .split-feature__panel {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background: var(--color-bg);
    border: 1px solid rgba(71, 36, 16, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 12px rgba(71, 36, 16, 0.06);
    overflow: hidden;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .split-feature__panel:hover {
    transform: translateY(-6px);
    border-color: rgba(124, 72, 44, 0.18);
    box-shadow: 0 18px 48px rgba(71, 36, 16, 0.12);
  }

  .split-feature__panel--copy {
    justify-content: center;
    gap: 1.15rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-chocolate);
  }

  .split-feature__panel--copy .split-feature__eyebrow {
    color: var(--color-terracota);
    opacity: 1;
  }

  .split-feature__panel--copy .split-feature__title {
    color: var(--color-chocolate);
    font-weight: 600;
  }

  .split-feature__panel--copy .split-feature__text {
    color: var(--color-text-muted);
  }

  .split-feature__panel--copy .arrow-circle {
    border-color: var(--color-terracota);
    color: var(--color-terracota);
  }

  .split-feature__panel--copy .split-feature__link:hover .arrow-circle {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-bg);
    transform: translateX(4px);
  }

  .split-feature__panel--media {
    padding: 0;
    min-height: 26rem;
    position: relative;
  }

  .split-feature__panel--media.split-feature__media--video {
    background: var(--color-white);
  }

  .split-feature__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--color-chocolate);
  }

  .split-feature__card--chocolate {
    background: var(--color-chocolate);
    color: var(--color-bg);
  }

  .split-feature__card--chocolate .split-feature__eyebrow,
  .split-feature__card--chocolate .split-feature__title,
  .split-feature__card--chocolate .split-feature__text {
    color: var(--color-bg);
  }

  .split-feature__card--terracota {
    background: var(--color-terracota);
    color: var(--color-bg);
  }

  .split-feature__card--terracota .split-feature__eyebrow,
  .split-feature__card--terracota .split-feature__title,
  .split-feature__card--terracota .split-feature__text {
    color: var(--color-bg);
  }

  .split-feature__card--cream {
    background: #f2ebe3;
    color: var(--color-chocolate);
  }

  .split-feature__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .split-feature__title {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 500;
  }

  .split-feature__text {
    margin: 0;
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.65;
  }

  .split-feature__link {
    display: inline-block;
    margin-top: 0.75rem;
    color: inherit;
  }

  .arrow-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 1.125rem;
    background: transparent;
    color: inherit;
    transition: transform 0.25s var(--ease), background 0.25s, color 0.25s;
  }

  .split-feature__card--chocolate .split-feature__link:hover .arrow-circle,
  .split-feature__card--terracota .split-feature__link:hover .arrow-circle {
    background: var(--color-bg);
    color: var(--color-chocolate);
    transform: translateX(4px);
  }

  .split-feature__card--cream .split-feature__link:hover .arrow-circle {
    background: var(--color-chocolate);
    color: var(--color-bg);
    transform: translateX(4px);
  }

  .split-feature__media {
    position: relative;
    overflow: hidden;
    min-height: 28rem;
    background: #ebe6e0;
  }

  .split-feature__media--carousel {
    padding: 0;
    display: flex;
  }

  .split-feature__media--carousel:focus-visible {
    outline: 2px solid var(--color-coral);
    outline-offset: -2px;
  }

  .split-feature__media > img,
  .split-feature__media > video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .split-feature__media--video {
    background: var(--color-bg);
    position: relative;
  }

  .split-feature__media--video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #1a120c;
    position: relative;
    z-index: 0;
  }

  .video-poster {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    background: var(--color-bg);
    cursor: pointer;
    transition: opacity 0.35s var(--ease), visibility 0.35s;
  }

  .video-poster--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .video-poster__logo {
    display: block;
    width: auto;
    max-width: min(85%, 14rem);
    height: auto;
    max-height: 4rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .video-poster__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border: none;
    border-radius: 50%;
    background: var(--color-terracota);
    color: var(--color-bg);
    cursor: pointer;
    transition: transform 0.2s var(--ease), background 0.2s;
  }

  .video-poster__play svg {
    width: 1.25rem;
    height: 1.25rem;
    margin-left: 0.15rem;
  }

  .video-poster__play:hover {
    transform: scale(1.06);
    background: var(--color-chocolate);
  }

  /* ---------------- BLOQUES EXISTENTES ---------------- */
  .section-intro {
    max-width: 36rem;
    margin: 0 auto 3rem;
  }

  .eyebrow.text-center {
    margin: 0 0 0.75rem;
  }

  .grid-categories {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .card {
    display: block;
    transition: transform 0.3s var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .card h3 {
    margin-bottom: 0.5rem;
  }

  .card__meta {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-terracota);
    margin-bottom: 0.25rem;
  }

  .card__desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .services-section h2 {
    max-width: 20ch;
    margin-bottom: 0.75rem;
  }

  .services-section__lead {
    max-width: 36rem;
    margin: 0 0 2.5rem;
    font-size: 1rem;
