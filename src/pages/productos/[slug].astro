                    class="related-card__img product-card__img"
                    style={`--catalog-scale: ${getCatalogImageScale(p.slug)}`}
                  >
                    <img
                      src={getCatalogImage(p.slug, p.image)}
                      alt={p.name}
                      width="600"
                      height="600"
                      loading="lazy"
                    />
                  </div>
                  <p class="related-card__meta">{p.category}</p>
                  <h3 class="related-card__title">{p.name}</h3>
                  <p class="related-card__desc">{p.shortDescription}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <div class="product-page__sticky-cta" data-product-sticky-cta>
      <a
        href={whatsappProductUrl}
        class="product-page__sticky-btn product-page__sticky-btn--whatsapp"
