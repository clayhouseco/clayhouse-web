<script>
  import { QUOTE_CART_EVENT, getQuoteCartCount, getQuoteCart } from "@/utils/quoteCart";

  const orderAddBtn = document.querySelector<HTMLButtonElement>(
    "[data-product-order] [data-add-to-quote]"
  );

  function currentVariantInCart() {
    if (!orderAddBtn) return false;
    const key = `${orderAddBtn.dataset.slug}::${orderAddBtn.dataset.color ?? ""}::${orderAddBtn.dataset.calidad ?? ""}`;
    return getQuoteCart().some(
      (i) => `${i.slug}::${i.color ?? ""}::${i.calidad ?? ""}` === key
    );
  }

  function refreshProductCartBtn() {
    const count = getQuoteCartCount();
    document.querySelectorAll<HTMLElement>("[data-quote-header-count]").forEach((el) => {
      el.textContent = String(count);
    });
    document.querySelectorAll<HTMLElement>(".product-page__view-cart").forEach((btn) => {
      btn.hidden = count === 0;
    });
    if (orderAddBtn) {
      if (currentVariantInCart()) {
        orderAddBtn.dataset.inCart = "1";
        orderAddBtn.classList.add("btn--in-cart");
        orderAddBtn.textContent = "✓ En tu cotización · Modificar";
      } else {
        delete orderAddBtn.dataset.inCart;
        orderAddBtn.classList.remove("btn--in-cart");
        orderAddBtn.textContent = "Agregar a cotización";
      }
    }
  }

  document.addEventListener(QUOTE_CART_EVENT, refreshProductCartBtn);
  document.addEventListener("quote-cart-added", refreshProductCartBtn);
  document.addEventListener("quote-variant-changed", refreshProductCartBtn);
  refreshProductCartBtn();

  // Sticky CTA mobile: delegar el click al botón principal (respeta cantidad/variante)
  document.querySelectorAll<HTMLButtonElement>("[data-sticky-add-to-quote]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const primary = document.querySelector<HTMLButtonElement>(
        "[data-product-order] [data-add-to-quote]"
      );
      primary?.click();
    });
  });

  // Calculadora de m² interactiva: barra de junta + simulación de ladrillos.
  interface RendiFormato {
    variantId: string | null;
    label: string;
    largoCm: number;
    altoCm: number;
  }

  document.querySelectorAll<HTMLElement>("[data-rendi-sim]").forEach((root) => {
    const formats: RendiFormato[] = JSON.parse(root.dataset.formats || "[]");
    if (!formats.length) return;
    const wall = root.querySelector<HTMLElement>("[data-rendi-wall]");
    const unitsEl = root.querySelector<HTMLElement>("[data-rendi-units]");
    const jointLabelEl = root.querySelector<HTMLElement>("[data-rendi-jointlabel]");
    const slider = root.querySelector<HTMLInputElement>("[data-rendi-slider]");
    const formatEl = root.querySelector<HTMLSelectElement>("[data-rendi-format]");
    const areaEl = root.querySelector<HTMLInputElement>("[data-rendi-area]");
    const totalEl = root.querySelector<HTMLElement>("[data-rendi-total]");
    const applyBtn = root.querySelector<HTMLButtonElement>("[data-rendi-apply]");
    const qtyInput = document.querySelector<HTMLInputElement>("[data-qty-input]");
    if (!slider || !unitsEl) return;

    let fmt = formats[0];

    // Murito: 4 filas × 4 columnas (aparejo trabado en filas alternas).
    const COLS = 4, ROWS = 4;
    if (wall) {
      for (let r = 0; r < ROWS; r++) {
        const row = document.createElement("div");
        row.className = "rendi-sim__row" + (r % 2 ? " rendi-sim__row--offset" : "");
        for (let c = 0; c < COLS; c++) {
          const b = document.createElement("div");
          b.className = "rendi-sim__brick";
          row.appendChild(b);
        }
        wall.appendChild(row);
      }
    }

    function unitsFor(jointCm: number): number {
      const j = jointCm / 100;
      return Math.ceil(1 / ((fmt.largoCm / 100 + j) * (fmt.altoCm / 100 + j)));
    }

    function render() {
      const jointCm = parseFloat(slider!.value);
      if (wall) {
        const cs = getComputedStyle(wall);
        const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
        const availW = wall.clientWidth - padX;
        // Junta a escala del ladrillo (con leve exageración para verla bien).
        const gap = ((jointCm * 110) / fmt.largoCm) * 1.4;
        const brickW = (availW - (COLS - 1) * gap) / COLS;
        const brickH = Math.max(7, brickW / (fmt.largoCm / fmt.altoCm));
        wall.style.setProperty("--rendi-gap", `${gap.toFixed(1)}px`);
        wall.style.setProperty("--brick-h", `${brickH.toFixed(1)}px`);
      }
      unitsEl!.textContent = String(unitsFor(jointCm));
      if (jointLabelEl)
        jointLabelEl.textContent =
          jointCm === 0
            ? "Junta perdida (sin pega)"
            : `Junta de ${String(jointCm).replace(".", ",")} cm`;
      updateTotal();
    }

    function updateTotal() {
      if (!totalEl || !areaEl) return;
      const area = parseFloat(areaEl.value || "0");
      totalEl.textContent =
        area > 0
          ? Math.ceil(area * unitsFor(parseFloat(slider!.value)) * 1.05).toLocaleString("es-CO")
          : "—";
    }

    slider.addEventListener("input", render);
    areaEl?.addEventListener("input", updateTotal);
    formatEl?.addEventListener("change", () => {
      fmt = formats.find((f) => (f.variantId ?? "") === formatEl!.value) ?? formats[0];
      render();
    });

    applyBtn?.addEventListener("click", () => {
      const area = parseFloat(areaEl?.value || "0");
      if (!(area > 0) || !qtyInput) return;
      qtyInput.value = String(Math.ceil(area * unitsFor(parseFloat(slider.value)) * 1.05));
      qtyInput.dispatchEvent(new Event("input", { bubbles: true }));
      qtyInput.dispatchEvent(new Event("change", { bubbles: true }));
      qtyInput.scrollIntoView({ behavior: "smooth", block: "center" });
      qtyInput.classList.add("product-page__qty-input--flash");
      setTimeout(() => qtyInput.classList.remove("product-page__qty-input--flash"), 1400);
    });

    window.addEventListener("resize", render);
    render();
  });

  // Calculadora para pisos: el visual muestra TOTAL PIEZAS (como ladrillo),
  // pero el "Aplicar a cantidad" llena el campo con m² porque el precio del
  // piso se cotiza por m². Las piezas son la referencia visual; el m² es
  // lo que importa para el carrito.
  document.querySelectorAll<HTMLElement>("[data-floor-calc]").forEach((root) => {
    const jointEl = root.querySelector<HTMLSelectElement>("[data-floor-joint]");
    const areaEl = root.querySelector<HTMLInputElement>("[data-floor-area]");
    const piecesEl = root.querySelector<HTMLElement>("[data-floor-pieces]");
    const applyBtn = root.querySelector<HTMLButtonElement>("[data-floor-apply]");
    const qtyInput = document.querySelector<HTMLInputElement>("[data-qty-input]");
    if (!jointEl || !areaEl || !piecesEl) return;

    function compute() {
      const area = parseFloat(areaEl!.value || "0");
      const upm2 = parseFloat(jointEl!.value || "0");
      if (!area || area <= 0) return null;
      // Tanto m² como piezas incluyen 5% de desperdicio recomendado para
      // que el visual sea consistente con el de ladrillos.
      const m2 = Math.ceil(area * 1.05 * 10) / 10;
      const pieces = upm2 ? Math.ceil(area * upm2 * 1.05) : 0;
      return { m2, pieces };
    }

    function update() {
      const r = compute();
      piecesEl!.textContent = r && r.pieces
        ? r.pieces.toLocaleString("es-CO")
        : "—";
    }

    jointEl.addEventListener("change", update);
    areaEl.addEventListener("input", update);

    applyBtn?.addEventListener("click", () => {
      const r = compute();
      if (!r || !qtyInput) return;
      qtyInput.value = String(r.m2);
      qtyInput.dispatchEvent(new Event("input", { bubbles: true }));
      qtyInput.dispatchEvent(new Event("change", { bubbles: true }));
      qtyInput.scrollIntoView({ behavior: "smooth", block: "center" });
      qtyInput.classList.add("product-page__qty-input--flash");
      setTimeout(() => qtyInput.classList.remove("product-page__qty-input--flash"), 1400);
    });
  });

</script>

