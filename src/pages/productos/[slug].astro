---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductGallery, { type GalleryImage } from "@/components/ProductGallery.astro";
import ProductInspiration from "@/components/ProductInspiration.astro";
import ProductColorVariants from "@/components/ProductColorVariants.astro";
import ProductUseIcon from "@/components/ProductUseIcon.astro";
import { products, getProduct } from "@/data/products";
import {
  getRecommendedUses,
  getNotRecommended,
  getRelatedProducts,
  getCategoryHref,
} from "@/data/productMeta";
import {
  getCatalogImage,
  getCatalogImageScale,
  getProductAssets,
  getProductInspiration,
  getVariantGallery,
} from "@/data/productVariants";
import { assetUrl } from "@/utils/paths";
import { buildProductJsonLd } from "@/utils/productSchema";
import { buildBreadcrumbJsonLd } from "@/utils/breadcrumbSchema";
import { getReviewsForProduct } from "@/data/reviews";
import { site } from "@/data/site";
import {
  getRendimientoTable,
  getRendimientoTablesByVariant,
  getFloorRendimientoTable,
} from "@/utils/productPricing";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProduct(slug!);

if (!product) {
  return Astro.redirect("/productos");
}

const assets = getProductAssets(product.slug);
const defaultVariantId = assets?.variants[0]?.id ?? "default";
const activeVariant = assets?.variants.find((v) => v.id === defaultVariantId) ?? assets?.variants[0];
const activeVariantId = activeVariant?.id ?? defaultVariantId;

const galleryImages: GalleryImage[] = assets
  ? getVariantGallery(assets, activeVariantId)
  : [{ src: assetUrl(product.image), alt: product.name, label: "Producto" }];

const inspirationCards = assets ? getProductInspiration(assets) : [];

if (!assets) {
  product.gallery?.forEach((path, i) => {
    galleryImages.push({
      src: assetUrl(path),
      alt: `${product.name} — detalle ${i + 1}`,
      label: "Detalle",
    });
  });
  if (product.imageDimensiones) {
    galleryImages.push({
      src: assetUrl(product.imageDimensiones),
      alt: `Dimensiones ${product.name}`,
      label: "Dimensiones",
    });
  }
  if (product.imageFachada) {
    galleryImages.push({
      src: assetUrl(product.imageFachada),
      alt: `${product.name} en fachada`,
      label: "En obra",
    });
  }
}

const displayColor = activeVariant?.colorLabel ?? product.color;
const displayPrice = activeVariant?.pricePerUnit ?? product.pricePerUnit;

/** Dimensiones de menor a mayor (ej. 5 × 14 × 29 cm) */
const dimensionesLine = product.dimensions
  ? [product.dimensions.alto, product.dimensions.ancho, product.dimensions.largo]
      .filter(Boolean)
      .join(" × ")
  : null;

const rendimientoVariants = assets
  ? getRendimientoTablesByVariant(product, assets.variants)
  : null;
const rendimientoTable = rendimientoVariants
  ? rendimientoVariants[0].table
  : getRendimientoTable(product);
const floorTable = getFloorRendimientoTable(product);

/** Visible en el h1: quita el prefijo "Ladrillo " y baja a minúsculas. */
const displayName = product.name.replace(/^Ladrillo\s+/i, "").toLowerCase();

const specRows = [
  { label: "Textura", value: product.texture },
  { label: "Color", value: product.color },
  dimensionesLine && { label: "Dimensiones", value: dimensionesLine },
  product.dimensions?.pesoAprox && { label: "Peso", value: product.dimensions.pesoAprox },
  // Solo mostramos la fila Rendimiento si NO hay tabla calculable (ej. Cartagena
  // con dimensiones variables). Si hay tabla (de ladrillo o piso), la sección
  // Rendimiento de abajo reemplaza esta fila con los escenarios completos.
  !rendimientoTable && !floorTable && product.dimensions?.rendimiento && {
    label: "Rendimiento",
    value: product.dimensions.rendimiento,
  },
  ...(product.specs ?? []),
].filter(Boolean) as { label: string; value: string }[];

const recommendedUses = getRecommendedUses(product);
const notRecommended = getNotRecommended(product);
const related = getRelatedProducts(product);

const productReviews = getReviewsForProduct(product.name);
const productJsonLd = buildProductJsonLd(product, product.image, productReviews);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Inicio", href: "/" },
  { name: "Productos", href: "/productos/" },
  { name: product.category, href: getCategoryHref(product.category) },
  { name: product.name },
]);

const whatsappMsg = encodeURIComponent(
  `Hola Clay House, me interesa cotizar ${product.name}.`
);
const whatsappProductUrl = `${site.whatsapp}?text=${whatsappMsg}`;

---

<BaseLayout title={product.seoTitle} description={product.seoDescription}>
  <article class="product-page">
    <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <div class="container product-page__breadcrumb">
      <a href="/">Clay House</a>
      <span aria-hidden="true">›</span>
      <a href="/productos">Productos</a>
      <span aria-hidden="true">›</span>
      <a href={getCategoryHref(product.category)}>{product.category}</a>
      <span aria-hidden="true">›</span>
      <span>{product.name}</span>
    </div>

    <section class="container product-page__hero">
      <div class="product-page__hero-grid">
        <div class="product-page__gallery-col">
          <div class="product-page__gallery" tabindex="0">
            <ProductGallery images={galleryImages} />
          </div>
          <nav class="product-page__quick-nav" aria-label="Secciones del producto">
            <a href="#especificaciones" class="quick-pill">Especificaciones</a>
            {(rendimientoTable || floorTable) && (
              <a href="#rendimiento" class="quick-pill">Rendimiento</a>
            )}
            <a href="#usos" class="quick-pill">Usos</a>
            <a href="#descargables" class="quick-pill">Fichas</a>
            {
              inspirationCards.length > 0 && (
                <a href="#inspiracion" class="quick-pill">Inspiración</a>
              )
            }
          </nav>
        </div>

        <aside class="product-page__info-card">
          <h1>{displayName}</h1>
          <span data-product-color hidden>{displayColor}</span>
          {
            assets && (
              <ProductColorVariants
                variants={assets.variants}
                galleriesByVariant={assets.galleriesByVariant}
                activeId={activeVariantId}
                productName={product.name}
                selectorLabel={assets.variantSelectorLabel}
              />
            )
          }
          <div class="product-page__description">
            {product.description.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <p class="product-page__delivery">Plazo de entrega: consultar según volumen y referencia</p>
          <div class="product-page__order" data-product-order>
            {
              displayPrice && (
                <p class="product-page__price" data-product-price>
                  <span data-product-price-value>{displayPrice}</span>
                  <span class="product-page__price-unit">
                    / {product.priceUnitLabel ?? "unidad"}
                  </span>
                </p>
              )
            }
            <label class="product-page__qty">
              <span>Cantidad</span>
              <input
                type="number"
                name="cantidad"
                min="1"
                value="1"
                inputmode="numeric"
                data-qty-input
              />
            </label>
            <button
              type="button"
              class="btn btn--primary btn--block"
              data-add-to-quote
              data-slug={product.slug}
              data-name={product.name}
              data-category={product.category}
              data-color={displayColor}
              data-unit={product.priceUnitLabel ?? "unidad"}
              data-image={galleryImages[0]?.src ?? product.image}
              data-price={displayPrice ?? "Consultar"}
              data-texture={product.texture}
              data-url={`/productos/${product.slug}/`}
            >
              Agregar a cotización
            </button>
            <button
              type="button"
              class="btn btn--outline btn--block product-page__view-cart"
              data-quote-cart-open
              hidden
            >
              Ver cotización (<span data-quote-header-count>0</span>)
            </button>
          </div>
        </aside>
      </div>
    </section>

    {
      specRows.length > 0 && (
        <section class="product-page__block" id="especificaciones">
          <div class="container product-page__panel product-page__panel--dark">
            <h2 class="product-page__h2 product-page__h2--large">Especificaciones</h2>
            <dl class="spec-grid">
              {specRows.map((row) => (
                <div class="spec-item">
                  <dt>{row.label}</dt>
                  <dd>
                    {row.value}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }

    {
      rendimientoTable && (
        <section class="product-page__block" id="rendimiento">
          <div
            class="container product-page__panel rendimiento-panel"
            data-rendimiento-root
            data-variants={rendimientoVariants ? JSON.stringify(rendimientoVariants) : null}
          >
            <header class="rendimiento-panel__header rendimiento-panel__header--center">
              <h2 class="product-page__h2 product-page__h2--large">Calculadora de m²</h2>
              <p class="rendimiento-panel__lead">
                Las piezas necesarias dependen del espesor de pega. Compare los
                escenarios para cotizar al mismo criterio que su constructor.
              </p>
            </header>
            <div class="rendimiento-grid">
              {rendimientoTable.map((row, i) => (
                <article class={`rendimiento-card${i === 1 ? " rendimiento-card--featured" : ""}`} data-rendi-card>
                  {i === 1 && (
                    <span class="rendimiento-card__badge">Pega de referencia</span>
                  )}
                  <div class="rendimiento-card__icon" aria-hidden="true">
                    {row.jointCm === 0 && (
                      <svg viewBox="0 0 60 30" fill="currentColor">
                        <rect x="0" y="0" width="20" height="14" />
                        <rect x="20" y="0" width="20" height="14" />
                        <rect x="40" y="0" width="20" height="14" />
                        <rect x="0" y="14" width="20" height="14" />
                        <rect x="20" y="14" width="20" height="14" />
                        <rect x="40" y="14" width="20" height="14" />
                      </svg>
                    )}
                    {row.jointCm === 1 && (
                      <svg viewBox="0 0 60 30" fill="currentColor">
                        <rect x="0" y="0" width="18.5" height="12.75" />
                        <rect x="20.75" y="0" width="18.5" height="12.75" />
                        <rect x="41.5" y="0" width="18.5" height="12.75" />
                        <rect x="0" y="15.25" width="18.5" height="12.75" />
                        <rect x="20.75" y="15.25" width="18.5" height="12.75" />
                        <rect x="41.5" y="15.25" width="18.5" height="12.75" />
                      </svg>
                    )}
                    {row.jointCm === 2 && (
                      <svg viewBox="0 0 60 30" fill="currentColor">
                        <rect x="0" y="0" width="16.75" height="11.5" />
                        <rect x="21.625" y="0" width="16.75" height="11.5" />
                        <rect x="43.25" y="0" width="16.75" height="11.5" />
                        <rect x="0" y="18.5" width="16.75" height="11.5" />
                        <rect x="21.625" y="18.5" width="16.75" height="11.5" />
                        <rect x="43.25" y="18.5" width="16.75" height="11.5" />
                      </svg>
                    )}
                  </div>
                  <p class="rendimiento-card__label">{row.label}</p>
                  <p class="rendimiento-card__units">
                    <span class="rendimiento-card__units-value" data-rendi-units>{row.unitsPerM2}</span>
                    <span class="rendimiento-card__units-unit">und/m²</span>
                  </p>
                  {row.pricePerM2 && (
                    <p class="rendimiento-card__price" data-rendi-price>{row.pricePerM2}</p>
                  )}
                </article>
              ))}
            </div>
            <div class="rendi-calc" data-rendi-calc>
              <p class="rendi-calc__title">Calcule para su obra</p>
              <div class="rendi-calc__row">
                {
                  rendimientoVariants && (
                    <div class="rendi-calc__field">
                      <label class="rendi-calc__field-label" for={`rendi-format-${product.slug}`}>
                        Formato
                      </label>
                      <select
                        id={`rendi-format-${product.slug}`}
                        class="rendi-calc__select"
                        data-rendi-format
                      >
                        {rendimientoVariants.map((v) => (
                          <option value={v.variantId}>{v.label}</option>
                        ))}
                      </select>
                    </div>
                  )
                }
                <div class="rendi-calc__field">
                  <label class="rendi-calc__field-label" for={`rendi-joint-${product.slug}`}>
                    Espesor de pega
                  </label>
                  <select id={`rendi-joint-${product.slug}`} class="rendi-calc__select" data-rendi-joint>
                    {rendimientoTable.map((row, i) => (
                      <option value={row.unitsPerM2} selected={i === 1}>
                        {row.label} ({row.unitsPerM2} und/m²)
                      </option>
                    ))}
                  </select>
                </div>
                <div class="rendi-calc__field">
                  <label class="rendi-calc__field-label" for={`rendi-area-${product.slug}`}>
                    Área a cubrir (m²)
                  </label>
                  <input
                    id={`rendi-area-${product.slug}`}
                    type="number"
                    min="1"
                    step="1"
                    inputmode="numeric"
                    placeholder="Ej. 120"
                    class="rendi-calc__input"
                    data-rendi-area
                  />
                </div>
                <div class="rendi-calc__result" data-rendi-result aria-live="polite">
                  <span class="rendi-calc__result-label">Total piezas</span>
                  <span class="rendi-calc__result-value" data-rendi-total>—</span>
                </div>
              </div>
              <button
                type="button"
                class="btn btn--outline rendi-calc__apply"
                data-rendi-apply
              >
                Aplicar a cantidad ↑
              </button>
            </div>
            <p class="rendimiento-panel__note">
              <strong>Cálculo nominal por cara largo × ancho. Sumamos 5% de
              desperdicio al m² aplicado en cantidad.</strong>
            </p>
          </div>
        </section>
      )
    }

    {
      floorTable && (
        <section class="product-page__block" id="rendimiento">
          <div class="container product-page__panel rendimiento-panel">
            <header class="rendimiento-panel__header rendimiento-panel__header--center">
              <h2 class="product-page__h2 product-page__h2--large">Calculadora de m²</h2>
              <p class="rendimiento-panel__lead">
                Las piezas de piso por m² dependen del espesor de pega. Estos son
                los escenarios típicos en obra; el material se cotiza por m².
              </p>
            </header>
            <div class="rendimiento-grid rendimiento-grid--floor">
              {floorTable.map((row) => (
                <article class="rendimiento-card">
                  <div class="rendimiento-card__icon" aria-hidden="true">
                    {row.jointMm === 3 && (
                      <svg viewBox="0 0 60 30" fill="currentColor">
                        <rect x="0" y="0" width="19.47" height="13.6" />
                        <rect x="20.27" y="0" width="19.47" height="13.6" />
                        <rect x="40.53" y="0" width="19.47" height="13.6" />
                        <rect x="0" y="14.4" width="19.47" height="13.6" />
                        <rect x="20.27" y="14.4" width="19.47" height="13.6" />
                        <rect x="40.53" y="14.4" width="19.47" height="13.6" />
                      </svg>
                    )}
                    {row.jointMm === 5 && (
                      <svg viewBox="0 0 60 30" fill="currentColor">
                        <rect x="0" y="0" width="19.2" height="13.4" />
                        <rect x="20.4" y="0" width="19.2" height="13.4" />
                        <rect x="40.8" y="0" width="19.2" height="13.4" />
                        <rect x="0" y="14.6" width="19.2" height="13.4" />
                        <rect x="20.4" y="14.6" width="19.2" height="13.4" />
                        <rect x="40.8" y="14.6" width="19.2" height="13.4" />
                      </svg>
                    )}
                    {row.jointMm === 8 && (
                      <svg viewBox="0 0 60 30" fill="currentColor">
                        <rect x="0" y="0" width="18.87" height="13.15" />
                        <rect x="20.57" y="0" width="18.87" height="13.15" />
                        <rect x="41.13" y="0" width="18.87" height="13.15" />
                        <rect x="0" y="14.85" width="18.87" height="13.15" />
                        <rect x="20.57" y="14.85" width="18.87" height="13.15" />
                        <rect x="41.13" y="14.85" width="18.87" height="13.15" />
                      </svg>
                    )}
                    {row.jointMm === 10 && (
                      <svg viewBox="0 0 60 30" fill="currentColor">
                        <rect x="0" y="0" width="18.47" height="12.85" />
                        <rect x="20.77" y="0" width="18.47" height="12.85" />
                        <rect x="41.53" y="0" width="18.47" height="12.85" />
                        <rect x="0" y="15.15" width="18.47" height="12.85" />
                        <rect x="20.77" y="15.15" width="18.47" height="12.85" />
                        <rect x="41.53" y="15.15" width="18.47" height="12.85" />
                      </svg>
                    )}
                  </div>
                  <p class="rendimiento-card__label">{row.label}</p>
                  <p class="rendimiento-card__units">
                    <span class="rendimiento-card__units-value">
                      {row.unitsPerM2.toLocaleString("es-CO", { maximumFractionDigits: 1 })}
                    </span>
                    <span class="rendimiento-card__units-unit">und/m²</span>
                  </p>
                </article>
              ))}
            </div>
            <div class="floor-calc" data-floor-calc>
              <p class="rendi-calc__title">Calcule para su obra</p>
              <div class="rendi-calc__row">
                <div class="rendi-calc__field">
                  <label class="rendi-calc__field-label" for={`floor-joint-${product.slug}`}>
                    Espesor de pega
                  </label>
                  <select id={`floor-joint-${product.slug}`} class="rendi-calc__select" data-floor-joint>
                    {floorTable.map((row, i) => (
                      <option value={row.unitsPerM2} selected={i === 1}>
                        {row.label} ({row.unitsPerM2.toLocaleString("es-CO", { maximumFractionDigits: 1 })} und/m²)
                      </option>
                    ))}
                  </select>
                </div>
                <div class="rendi-calc__field">
                  <label class="rendi-calc__field-label" for={`floor-area-${product.slug}`}>
                    Área a cubrir (m²)
                  </label>
                  <input
                    id={`floor-area-${product.slug}`}
                    type="number"
                    min="1"
                    step="0.5"
                    inputmode="decimal"
                    placeholder="Ej. 25"
                    class="rendi-calc__input"
                    data-floor-area
                  />
                </div>
                <div class="rendi-calc__result" aria-live="polite">
                  <span class="rendi-calc__result-label">Total piezas</span>
                  <span class="rendi-calc__result-value" data-floor-pieces>—</span>
                </div>
              </div>
              <button
                type="button"
                class="btn btn--outline rendi-calc__apply"
                data-floor-apply
              >
                Aplicar a cantidad ↑
              </button>
            </div>
            <p class="rendimiento-panel__note">
              <strong>Cálculo nominal por cara largo × ancho. Sumamos 5% de
              desperdicio al m² aplicado en cantidad.</strong>
            </p>
          </div>
        </section>
      )
    }

    <section class="product-page__block product-page__usos" id="usos">
      <div class="container product-page__panel product-page__panel--uses">
        <div class="product-page__two-col">
        <div class="product-page__uses-col product-page__uses-col--yes">
          <h2 class="product-page__h2">Usos recomendados</h2>
          <ul class="chip-list chip-list--yes">
            {
              recommendedUses.map((use) => (
                <li class="chip">
                  <ProductUseIcon icon={use.icon} />
                  <span>{use.label}</span>
                </li>
              ))
            }
          </ul>
          {
            product.applications.length > 0 && (
              <ul class="product-page__detail-list">
                {product.applications.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="product-page__uses-col product-page__uses-col--no">
          <h2 class="product-page__h2">No apto</h2>
          <ul class="chip-list chip-list--no">
            {
              notRecommended.map((item) => (
                <li class="chip chip--muted">
                  <span class="chip__x" aria-hidden="true">×</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        </div>
      </div>
    </section>

    <section class="product-page__block product-page__block--alt" id="descargables">
      <div class="container product-page__panel product-page__panel--downloads">
        <h2 class="product-page__h2">Descargables</h2>
        {
          product.technicalPreview && (
            <a
              href={product.technicalPreview}
              target="_blank"
              rel="noopener"
              class="ficha-preview"
              aria-label={`Ver ficha técnica de ${product.name} a tamaño completo`}
            >
              <img
                src={product.technicalPreview}
                alt={`Ficha técnica de ${product.name}`}
                width="1264"
                height="843"
                loading="lazy"
              />
              <span class="ficha-preview__hint">Click para ver en grande</span>
            </a>
          )
        }
        <ul class="download-list">
          <li>
            <a href={product.technicalPdf} target="_blank" rel="noopener" class="download-link">
              <span class="download-link__title">Ficha técnica (PDF)</span>
              <span class="download-link__meta">Dimensiones, tolerancias y NTC 4205</span>
            </a>
          </li>
          {
            assets?.extraDownloads?.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener" class="download-link">
                  <span class="download-link__title">{item.title}</span>
                  {item.meta && <span class="download-link__meta">{item.meta}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      inspirationCards.length > 0 && (
        <section
          class="product-page__block product-page__inspiration-wrap"
          id="inspiracion"
          data-inspiration-section
        >
          <ProductInspiration cards={inspirationCards} />
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="product-page__block product-page__block--alt">
          <div class="container product-page__panel">
            <h2 class="product-page__h2 product-page__h2--large">Productos relacionados</h2>
            <div class="related-grid">
              {related.map((p) => (
                <a href={`/productos/${p.slug}`} class="related-card">
                  <div
                    class="related-card__img product-card__img"
                    style={`--catalog-scale: ${getCatalogImageScale(p.slug)}`}
                  >
                    <img
                      src={getCatalogImage(p.slug, p.image)}
                      alt={p.name}
                      width="600"
                      height="600"
                      loading="lazy"
                    />
                  </div>
                  <p class="related-card__meta">{p.category}</p>
                  <h3 class="related-card__title">{p.name}</h3>
                  <p class="related-card__desc">{p.shortDescription}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <div class="product-page__sticky-cta" data-product-sticky-cta>
      <a
        href={whatsappProductUrl}
        class="product-page__sticky-btn product-page__sticky-btn--whatsapp"
        target="_blank"
