---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CatalogFilters from "@/components/catalog/CatalogFilters.astro";
import ProductGrid from "@/components/catalog/ProductGrid.astro";
import PricingGuide from "@/components/catalog/PricingGuide.astro";
import { getCatalogCategoryHref } from "@/data/catalogCategories";
import { groupProductsByCategory } from "@/utils/catalog";
import { Image } from "astro:assets";
import heroImg from "@/assets/images/hero/DSC08873.jpg";
import "@/styles/catalog-page.css";

const color = Astro.url.searchParams.get("color");
const grouped = groupProductsByCategory();
---

<BaseLayout
  title="Productos"
  description="Catálogo completo de ladrillos, pisos, tejas y enchapes en ladrillo. Romano, Toscano, Napolitano, Cartagena y más. Cotización en 24 horas."
>
  <section class="page-hero page-hero--image">
    <div class="page-hero__media">
      <Image
        src={heroImg}
        alt="Muro en ladrillo oscuro con vegetación — Clay House"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        width={1920}
        height={1280}
      />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content">
      <h1>productos</h1>
      <p class="page-hero__lead">
        Productos atemporales, elegantes y duraderos
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CatalogFilters />

      {
        color && (
          <p class="filter-note">
            Filtrado por color. <a href="/productos">Ver todos</a>
          </p>
        )
      }

      {
        grouped.map((group) => (
          <section class="catalog-group">
            <header class="catalog-group__header">
              <h2 class="catalog-group__title">{group.def.title}</h2>
              <p class="catalog-group__desc">{group.def.description}</p>
              <a href={getCatalogCategoryHref(group.def.id)} class="link-arrow">
                ver solo {group.def.label.toLowerCase()} →
              </a>
            </header>
            <ProductGrid products={group.products} />
          </section>
        ))
      }

      <PricingGuide />

      <aside class="catalog-cta">
        <h3>¿No encuentra su referencia?</h3>
        <p>Desarrollamos piezas a medida según plano de arquitecto.</p>
        <a href="/contacto" class="btn btn--primary">solicitar cotización</a>
      </aside>
    </div>
  </section>

  <script>
    import { categorySlugById } from "@/data/catalogCategories";

    const q = new URL(window.location.href).searchParams.get("categoria");
    if (q && q in categorySlugById) {
      const slug = categorySlugById[q as keyof typeof categorySlugById];
      window.location.replace(`/productos/categoria/${slug}/`);
    }
  </script>
</BaseLayout>

<style>
  .page-hero--image {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-top: -5.25rem;
    padding-top: 5.25rem;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.4) 70%),
      linear-gradient(to top, var(--color-bg) 0%, transparent 18%);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 6rem;
  }

  .page-hero--image h1 {
    color: #ffffff;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
    margin: 0;
  }

  .page-hero--image .page-hero__lead {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .page-hero--image {
      min-height: 60vh;
    }

    .page-hero--image h1 {
      font-size: clamp(2.25rem, 9vw, 3.5rem);
    }
  }
</style>
