---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CatalogFilters from "@/components/catalog/CatalogFilters.astro";
import ProductGrid from "@/components/catalog/ProductGrid.astro";
import {
  catalogCategories,
  getCategorySlug,
} from "@/data/catalogCategories";
import { filterProductsByCategory } from "@/utils/catalog";
import { buildBreadcrumbJsonLd } from "@/utils/breadcrumbSchema";
import { Image } from "astro:assets";
import heroImg from "@/assets/images/hero/DSC08873.jpg";
import "@/styles/catalog-page.css";

export function getStaticPaths() {
  return catalogCategories.map((cat) => ({
    params: { slug: getCategorySlug(cat.id) },
    props: { categoryId: cat.id },
  }));
}

interface Props {
  categoryId: import("@/data/catalogCategories").ProductCategory;
}

const { categoryId } = Astro.props;
const def = catalogCategories.find((c) => c.id === categoryId)!;
const filtered = filterProductsByCategory(categoryId);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Inicio", href: "/" },
  { name: "Productos", href: "/productos/" },
  { name: def.title },
]);
---

<BaseLayout
  title={`Productos — ${def.title}`}
  description={`${def.title} en ladrillo: ${def.description} Fabricación artesanal en Amagá, Antioquia.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <section class="page-hero page-hero--image">
    <div class="page-hero__media">
      <Image
        src={heroImg}
        alt={`Productos Clay House — ${def.title}`}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        width={1920}
        height={1280}
      />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content">
      <h1>{def.title.toLowerCase()}</h1>
      <p class="page-hero__lead">{def.description}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CatalogFilters activeCategory={categoryId} />
      {
        filtered.length > 0 ? (
          <ProductGrid products={filtered} />
        ) : (
          <p class="catalog-empty">
            No hay referencias en esta categoría por ahora.{" "}
            <a href="/productos">Ver todo el catálogo</a> o{" "}
            <a href="/contacto">solicitar una pieza a medida</a>.
          </p>
        )
      }

      <aside class="catalog-cta">
        <h3>¿No encuentra su referencia?</h3>
        <p>Desarrollamos piezas a medida según plano de arquitecto.</p>
        <a href="/contacto" class="btn btn--primary">solicitar cotización</a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero--image {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-top: -5.25rem;
    padding-top: 5.25rem;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.4) 70%),
      linear-gradient(to top, var(--color-bg) 0%, transparent 18%);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 6rem;
  }

  .page-hero--image h1 {
    color: #ffffff;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
    margin: 0;
  }

  .page-hero--image .page-hero__lead {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    margin-top: 1.5rem;
    max-width: 40rem;
  }

  @media (max-width: 768px) {
    .page-hero--image {
      min-height: 60vh;
    }

    .page-hero--image h1 {
      font-size: clamp(2.25rem, 9vw, 3.5rem);
    }
  }
</style>
