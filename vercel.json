      "permanent": true
    },
    {
      "source": "/diseno-y-construccion-de-fachadas/:s*",
      "destination": "/productos/categoria/fachadas",
      "permanent": true
    },
    {
      "source": "/enchapes-rusticos/enchape-romano-:s*",
