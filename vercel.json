{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "astro",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.clayhouse.com.co" }],
      "destination": "https://clayhouse.com.co/:path*",
      "permanent": true
    },
    {
      "source": "/Logos/MASTERMesa%20de%20trabajo%203.png",
      "destination": "/logo-clayhouse.png",
      "permanent": true
    },
    {
      "source": "/Logos/MASTERMesa de trabajo 3.png",
      "destination": "/logo-clayhouse.png",
      "permanent": true
    },
    { "source": "/nosotros/", "destination": "/nosotros", "permanent": true },
    { "source": "/tienda", "destination": "/productos", "permanent": true },
    { "source": "/tienda/", "destination": "/productos", "permanent": true },
    {
      "source": "/solicita-informacion-productos-servicios",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/solicita-informacion-productos-servicios/",
      "destination": "/contacto",
      "permanent": true
    },
    { "source": "/carrito-de-compras", "destination": "/contacto", "permanent": true },
    { "source": "/carrito-de-compras/", "destination": "/contacto", "permanent": true },
    { "source": "/mi-cuenta", "destination": "/contacto", "permanent": true },
    { "source": "/mi-cuenta/", "destination": "/contacto", "permanent": true },
    {
      "source": "/blog/como-especificar-barro-cocido-en-obra",
      "destination": "/blog/especificacion-de-ladrillo-en-obra",
      "permanent": true
    },
    {
      "source": "/blog/como-especificar-barro-cocido-en-obra/",
      "destination": "/blog/especificacion-de-ladrillo-en-obra",
      "permanent": true
    },
    { "source": "/rese%C3%B1as", "destination": "/resenas", "permanent": true },
    { "source": "/rese%C3%B1as/", "destination": "/resenas", "permanent": true },
    {
      "source": "/rese%C3%B1as/gracias",
      "destination": "/resenas/gracias",
      "permanent": true
    },
    {
      "source": "/rese%C3%B1as/gracias/",
      "destination": "/resenas/gracias",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/ch-assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|gif|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
