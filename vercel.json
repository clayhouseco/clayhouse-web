{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "astro",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/productos/enchape-rustico",
      "destination": "/productos/categoria/enchapes",
      "permanent": false
    },
    {
      "source": "/productos/enchape-bocadillo",
      "destination": "/productos/categoria/enchapes",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.clayhouse.com.co"
        }
      ],
      "destination": "https://clayhouse.com.co/:path*",
      "permanent": true
    },
    {
      "source": "/Logos/MASTERMesa%20de%20trabajo%203.png",
      "destination": "/logo-clayhouse.png",
      "permanent": true
    },
    {
      "source": "/Logos/MASTERMesa de trabajo 3.png",
      "destination": "/logo-clayhouse.png",
      "permanent": true
    },
    {
      "source": "/nosotros/",
      "destination": "/nosotros",
      "permanent": true
    },
    {
      "source": "/tienda",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/tienda/",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/solicita-informacion-productos-servicios",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/solicita-informacion-productos-servicios/",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/carrito-de-compras",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/carrito-de-compras/",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/mi-cuenta",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/mi-cuenta/",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/blog/como-especificar-barro-cocido-en-obra",
      "destination": "/blog/especificacion-de-ladrillo-en-obra",
      "permanent": true
    },
    {
      "source": "/blog/como-especificar-barro-cocido-en-obra/",
      "destination": "/blog/especificacion-de-ladrillo-en-obra",
      "permanent": true
    },
    {
      "source": "/rese%C3%B1as",
      "destination": "/resenas",
      "permanent": true
    },
    {
      "source": "/rese%C3%B1as/",
      "destination": "/resenas",
      "permanent": true
    },
    {
      "source": "/rese%C3%B1as/gracias",
      "destination": "/resenas/gracias",
      "permanent": true
    },
    {
      "source": "/rese%C3%B1as/gracias/",
      "destination": "/resenas/gracias",
      "permanent": true
    },
    {
      "source": "/fachadas-rusticas/cartagena",
      "destination": "/productos/cartagena",
      "permanent": true
    },
    {
      "source": "/fachadas-rusticas/ladrillo-romano-:s*",
      "destination": "/productos/romano",
      "permanent": true
    },
    {
      "source": "/fachadas-rusticas/ladrillo-toscano-:s*",
      "destination": "/productos/toscano",
      "permanent": true
    },
    {
      "source": "/fachadas-rusticas/macizo-campesino-:s*",
      "destination": "/productos/macizo-campesino",
      "permanent": true
    },
    {
      "source": "/fachadas-rusticas",
      "destination": "/productos/categoria/fachadas",
      "permanent": true
    },
    {
      "source": "/fachadas-rusticas/:s*",
      "destination": "/productos/categoria/fachadas",
      "permanent": true
    },
    {
      "source": "/fachadas-lisas",
      "destination": "/productos/categoria/fachadas",
      "permanent": true
    },
    {
      "source": "/fachadas-lisas/:s*",
      "destination": "/productos/categoria/fachadas",
      "permanent": true
    },
    {
      "source": "/diseno-y-construccion-de-fachadas",
      "destination": "/productos/categoria/fachadas",
      "permanent": true
    },
    {
      "source": "/diseno-y-construccion-de-fachadas/:s*",
      "destination": "/productos/categoria/fachadas",
      "permanent": true
    },
    {
      "source": "/enchapes-rusticos/enchape-romano-:s*",
      "destination": "/productos/enchape-romano",
      "permanent": true
    },
    {
      "source": "/enchapes-rusticos",
      "destination": "/productos/categoria/enchapes",
      "permanent": true
    },
    {
      "source": "/enchapes-rusticos/:s*",
      "destination": "/productos/categoria/enchapes",
      "permanent": true
    },
    {
      "source": "/enchapes-de-alta-calidad",
      "destination": "/productos/categoria/enchapes",
      "permanent": true
    },
    {
      "source": "/enchapes-de-alta-calidad/:s*",
      "destination": "/productos/categoria/enchapes",
      "permanent": true
    },
    {
      "source": "/tejas-planas",
      "destination": "/productos/teja-plana",
      "permanent": true
    },
    {
      "source": "/tejas-planas/:s*",
      "destination": "/productos/teja-plana",
      "permanent": true
    },
    {
      "source": "/tejas-curvas/teja-colonial-:s*",
      "destination": "/productos/teja-colonial",
      "permanent": true
    },
    {
      "source": "/tejas-curvas",
      "destination": "/productos/categoria/techos",
      "permanent": true
    },
    {
      "source": "/tejas-curvas/:s*",
      "destination": "/productos/categoria/techos",
      "permanent": true
    },
    {
      "source": "/techos",
      "destination": "/productos/categoria/techos",
      "permanent": true
    },
    {
      "source": "/techos/:s*",
      "destination": "/productos/categoria/techos",
      "permanent": true
    },
    {
      "source": "/rayados-verticales",
      "destination": "/productos/rayados-verticales",
      "permanent": true
    },
    {
      "source": "/rayados-verticales/:s*",
      "destination": "/productos/rayados-verticales",
      "permanent": true
    },
    {
      "source": "/rayados-horizontales",
      "destination": "/productos/rayados-horizontales",
      "permanent": true
    },
    {
      "source": "/rayados-horizontales/:s*",
      "destination": "/productos/rayados-horizontales",
