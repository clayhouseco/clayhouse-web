      "permanent": true
    },
    {
      "source": "/pisos-rusticos/:s*",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/pisos-shop",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/pisos-shop/:s*",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/pisos",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/pisos/:s*",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/productos/piso-10x30",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/productos/piso-30x30",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/politicas-de-privacidad-y-tratamiento-de-datos",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/politicas-de-privacidad-y-tratamiento-de-datos/:s*",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/wp-content/:s*",
      "destination": "/descargas",
      "permanent": true
    },
    {
      "source": "/Fichas Tecnicas/:s*",
      "destination": "/descargas",
      "permanent": true
    },
    {
      "source": "/Fichas%20Tecnicas/:s*",
      "destination": "/descargas",
      "permanent": true
    },
    {
      "source": "/resena-historica-de-los-chircales",
      "destination": "/blog/podcast-historia-del-ladrillo",
      "permanent": true
    },
    {
      "source": "/resena-historica-de-los-chircales/:s*",
      "destination": "/blog/podcast-historia-del-ladrillo",
      "permanent": true
    },
    {
      "source": "/ladrillos-en-colombia-historia-tipos-y-tendencias-actuales",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/ladrillos-en-colombia-historia-tipos-y-tendencias-actuales/:s*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/ladrillos-esteticos-que-transforman-espacios",
      "destination": "/productos/categoria/fachadas",
      "permanent": true
    },
    {
      "source": "/ladrillos-esteticos-que-transforman-espacios/:s*",
      "destination": "/productos/categoria/fachadas",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/ch-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
