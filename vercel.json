    },
    {
      "source": "/productos/piso-30x30",
      "destination": "/productos",
      "permanent": true
    },
    {
      "source": "/politicas-de-privacidad-y-tratamiento-de-datos",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/politicas-de-privacidad-y-tratamiento-de-datos/:s*",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/wp-content/:s*",
      "destination": "/descargas",
      "permanent": true
    },
    {
      "source": "/Fichas Tecnicas/:s*",
      "destination": "/descargas",
      "permanent": true
    },
    {
      "source": "/Fichas%20Tecnicas/:s*",
      "destination": "/descargas",
      "permanent": true
