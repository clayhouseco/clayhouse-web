      "role": "Botones primarios, links, acento de marca"
    },
    "salmonSuave": {
      "name": "Salmón suave",
      "hex": "#F99A91",
      "rgb": [249, 154, 145],
      "cmyk": [0, 51, 36, 0],
      "role": "Fondos alternativos, highlights"
    },
    "coralVivo": {
      "name": "Coral vivo",
      "hex": "#EF5843",
      "rgb": [239, 88, 67],
      "cmyk": [0, 77, 72, 0],
      "role": "CTAs secundarios, hover, énfasis"
    },
    "ambarArcilla": {
      "name": "Ámbar arcilla",
      "hex": "#F2A141",
      "rgb": [242, 161, 65],
