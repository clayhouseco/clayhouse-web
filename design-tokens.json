  "typography": {
    "headings": {
      "family": "Helvetica Neue",
      "fallback": "Neue Haas Grotesk Display, system-ui, sans-serif",
      "weight": 700,
      "style": "Bold Extended",
      "letterSpacing": "0.02em",
      "textTransform": "lowercase",
      "sizes": {
        "h1": { "desktop": "64px", "mobile": "40px", "lineHeight": 1.1 },
        "h2": { "desktop": "40px", "mobile": "28px", "lineHeight": 1.15 },
        "h3": { "desktop": "24px", "mobile": "20px", "lineHeight": 1.2 }
      }
    },
    "body": {
      "family": "Montserrat",
      "weight": 300,
      "style": "Light",
      "sizes": {
        "body": { "desktop": "17px", "mobile": "16px", "lineHeight": 1.6 },
        "small": { "desktop": "14px", "mobile": "13px", "lineHeight": 1.5 }
      }
    },
    "social": {
      "family": "Rigid Square",
      "weight": 300,
      "note": "Solo redes sociales; subir en Framer si hay licencia"
    }
  },
  "spacing": {
    "sectionPaddingY": { "desktop": "120px", "mobile": "80px" },
    "containerMaxWidth": "1280px",
    "gridGap": "24px"
  },
  "contact": {
