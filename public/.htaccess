Options -MultiViews
RewriteEngine On

# Tipos MIME (evita que el navegador descargue HTML/CSS)
AddType text/html .html
AddType text/css .css
AddType application/javascript .js
AddType image/png .png
AddType image/jpeg .jpg .jpeg
AddType image/webp .webp
AddType application/pdf .pdf

# Páginas Astro: /productos → productos/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Redirects desde WordPress
RedirectMatch 301 ^/nosotros/$ /nosotros
RedirectMatch 301 ^/tienda/?$ /productos
RedirectMatch 301 ^/solicita-informacion-productos-servicios/?$ /contacto
RedirectMatch 301 ^/carrito-de-compras/?$ /contacto
RedirectMatch 301 ^/mi-cuenta/?$ /contacto
