# Carpeta de entrada — contenido en revisión.
# Mantenemos en el repo solo la estructura (README, plantillas, .gitkeep).
# El material concreto (fotos, info de productos/proyectos/blog) queda local.
_inbox/productos/*
_inbox/proyectos/*
_inbox/blog/*
!_inbox/productos/.gitkeep
!_inbox/proyectos/.gitkeep
!_inbox/blog/.gitkeep
.vscode/
.claude/

# Variantes responsive: se generan en cada build (scripts/generate-responsive.mjs)
public/images/_responsive/
